      coeff := coeff.set! i 0
    for y in [:4] do
      for x in [:4] do
        let idx := dstOff + y * stride + x
        dst := dst.set! idx (av1IclipU8 (Int.ofNat (dst.getD idx 0) + tmp.getD (y * 4 + x) 0))
    return (dst, coeff)
  let (k0, k1) := av1Tx1dKinds txtp
  if eob < (if txtp == av1DctDct then 1 else 0) then
    let mut dc := coeff.getD 0 0
    coeff := coeff.set! 0 0
    if w * 2 == h || h * 2 == w then
      dc := av1ArithShiftRight (dc * 181 + 128) 8
    dc := av1ArithShiftRight (dc * 181 + 128) 8
    dc := av1ArithShiftRight (dc + Int.ofNat ((1 <<< shift) >>> 1)) shift
    dc := av1ArithShiftRight (dc * 181 + 128 + 2048) 12
    for y in [:h] do
      for x in [:w] do
        let idx := dstOff + y * stride + x
        dst := dst.set! idx (av1IclipU8 (Int.ofNat (dst.getD idx 0) + dc))
    return (dst, coeff)
  let sh := Nat.min h 32
  let sw := Nat.min w 32
  let rect2 := w * 2 == h || h * 2 == w
  let eobNat := eob.toNat
  let last :=
    if k1 == 3 && k0 != 3 then Nat.min (sh - 1) eobNat
    else if k0 == 3 && k1 != 3 then eobNat >>> (lw + 2)
    else (av1LastNonzeroColFromEob.getD tx #[]).getD eobNat 0
  let mut tmp : Array Int := Array.replicate (w * sh) 0
  for y in [:last + 1] do
    let mut row : Array Int := Array.mkEmpty w
    for x in [:sw] do
      let mut v := coeff.getD (y + x * sh) 0
      if rect2 then
        v := av1ArithShiftRight (v * 181 + 128) 8
      row := row.push v
    for _ in [sw:w] do
      row := row.push 0
    let out := av1Itx1d k0 w row
    for x in [:w] do
      tmp := tmp.set! (y * w + x) (out.getD x 0)
  for i in [:sw * sh] do
    coeff := coeff.set! i 0
  let rnd : Int := Int.ofNat ((1 <<< shift) >>> 1)
  for i in [:w * sh] do
    tmp := tmp.set! i (av1ClipS16 (av1ArithShiftRight (tmp.getD i 0 + rnd) shift))
  for x in [:w] do
    let mut col : Array Int := Array.mkEmpty h
    for y in [:sh] do
      col := col.push (tmp.getD (x + y * w) 0)
    for _ in [sh:h] do
      col := col.push 0
    let out := av1Itx1d k1 h col
    for y in [:h] do
      let idx := dstOff + y * stride + x
      let delta := av1ArithShiftRight (out.getD y 0 + 8) 4
      dst := dst.set! idx (av1IclipU8 (Int.ofNat (dst.getD idx 0) + delta))
  return (dst, coeff)

def av1CoefSkipCtx (tx bs : Nat) (aArr : Array Nat) (aOff : Nat) (lArr : Array Nat) (lOff : Nat) (chroma : Nat) : Nat := Id.run do
  let (w4, h4, lw, lh, _) := av1TxDim tx
  let bw := av1BlockDim.getD (bs * 4 + 2) 0
  let bh := av1BlockDim.getD (bs * 4 + 3) 0
  if chroma != 0 then
    let notOne := (if (bw - (if bw != 0 then 1 else 0)) > lw || (bh - (if bh != 0 then 1 else 0)) > lh then 1 else 0)
    let mut ca : Nat := 0
    for i in [:w4] do
      if aOff + i < aArr.size && aArr.getD (aOff + i) 0x40 != 0x40 then ca := 1
    let mut cl : Nat := 0
    for i in [:h4] do
      if lOff + i < lArr.size && lArr.getD (lOff + i) 0x40 != 0x40 then cl := 1
    return 7 + 3 * notOne + ca + cl
  if bw == lw && bh == lh then
    return 0
  let merge (src : Array Nat) (off txw : Nat) : Nat := Id.run do
    let cnt := 1 <<< Nat.min txw 4
    let mut acc : Nat := 0
    for i in [:cnt] do
      if off + i < src.size then
        acc := acc ||| src.getD (off + i) 0
    return acc
  let la := merge aArr aOff lw
  let ll := merge lArr lOff lh
  return av1SkipCtx.getD (Nat.min (la &&& 0x3F) 4 * 5 + Nat.min (ll &&& 0x3F) 4) 0

private def av1ReadGolomb (dec0 : Av1MsacDecoder) : Nat × Av1MsacDecoder := Id.run do
  let mut dec := dec0
  let mut n : Nat := 0
  let mut val : Nat := 1
  while n < 32 do
    let (b, d1) := dec.decodeBoolEqui
    dec := d1
    if b != 0 then
      break
    n := n + 1
  while n > 0 do
    n := n - 1
    let (b, d1) := dec.decodeBoolEqui
    dec := d1
    val := (val <<< 1) + b
  return (val - 1, dec)

private def av1WriteGolomb (enc0 : Av1MsacEncoder) (v : Nat) : Av1MsacEncoder := Id.run do
  let mut enc := enc0
  let x := v + 1
  let n := av1Ulog2 x
  for _ in [:n] do
    enc := enc.encodeBoolEqui 0
  enc := enc.encodeBoolEqui 1
  for k in [:n] do
    let sh := n - 1 - k
    enc := enc.encodeBoolEqui ((x >>> sh) &&& 1)
  return enc

def av1DcSignCtx (tx : Nat) (aArr : Array Nat) (aOff : Nat) (lArr : Array Nat) (lOff : Nat) : Nat := Id.run do
  let (_, _, lw, lh, _) := av1TxDim tx
  let na := 1 <<< Nat.min lw 4
  let nl := 1 <<< Nat.min lh 4
  let mut sa : Int := 0
  for i in [:na] do
    if aOff + i < aArr.size then
      sa := sa + Int.ofNat (aArr.getD (aOff + i) 0 >>> 6)
  let mut sl : Int := 0
  for i in [:nl] do
    if lOff + i < lArr.size then
      sl := sl + Int.ofNat (lArr.getD (lOff + i) 0 >>> 6)
  let s : Int := sa + sl - Int.ofNat na - Int.ofNat nl
  return (if s != 0 then 1 else 0) + (if s > 0 then 1 else 0)

def av1LoCtx (levels : Array Nat) (levOff txClass tx x y stride : Nat) : Nat × Nat :=
  let mag0 := levels.getD (levOff + 1) 0 + levels.getD (levOff + stride) 0
  if txClass == 0 then
    let hi := mag0 + levels.getD (levOff + stride + 1) 0
    let mag := hi + levels.getD (levOff + 2) 0 + levels.getD (levOff + 2 * stride) 0
    let ns := if tx >= 5 then 1 else 0
    let off := av1LoCtxOffsets.getD ((ns + (tx &&& ns)) * 25 + Nat.min y 4 * 5 + Nat.min x 4) 0
    (off + (if mag > 512 then 4 else (mag + 64) >>> 7), hi)
  else
    let hi := mag0 + levels.getD (levOff + 2) 0
    let mag := hi + levels.getD (levOff + 3) 0 + levels.getD (levOff + 4) 0
    let off := 26 + (if y > 1 then 10 else y * 5)
    (off + (if mag > 512 then 4 else (mag + 64) >>> 7), hi)

def av1GetUvInterTxtp (uvtx ytxtp : Nat) : Nat :=
  let (_, _, lw, lh, _) := av1TxDim uvtx
  if Nat.max lw lh == 3 then
    if ytxtp == av1Idtx then av1Idtx else av1DctDct
  else if Nat.min lw lh == 2 && (ytxtp == av1HFlipAdst || ytxtp == av1VFlipAdst || ytxtp == av1HAdst || ytxtp == av1VAdst) then
    av1DctDct
  else
    ytxtp

def av1DecodeCoefs (dec0 : Av1MsacDecoder) (cdf0 : Array Nat)
    (tx bs : Nat) (intra : Bool) (plane yMode : Nat) (yAngle : Int) (uvMode : Nat)
    (reduced : Bool) (qidx : Nat) (lossless : Bool)
    (aArr : Array Nat) (aOff : Nat) (lArr : Array Nat) (lOff : Nat)
    (cf0 : Array Int) (txtpIn : Nat) (dqDc dqAc : Nat)
    (qmOpt : Option (Array (Array Nat)) := none) :
    Int × Nat × Nat × Av1MsacDecoder × Array Nat × Array Int := Id.run do
  let mut dec := dec0
  let mut cdf := cdf0
  let mut cf := cf0
  let chroma : Nat := if plane != 0 then 1 else 0
  let (_, _, lw, lh, ctx) := av1TxDim tx
  let sctx := av1CoefSkipCtx tx bs aArr aOff lArr lOff chroma
  let (allSkip, d1, c1) := dec.decodeBoolAdapt cdf (cdfOff_coef_skip + (ctx * 13 + sctx) * 2)
  dec := d1; cdf := c1
  if allSkip != 0 then
    return (-1, if lossless then av1WhtWht else av1DctDct, 0x40, dec, cdf, cf)
  let mut txtp : Nat := av1DctDct
  if lossless then
    txtp := av1WhtWht
  else if av1TxfmDim.getD (tx * 8 + 5) 0 + (if intra then 1 else 0) >= 4 then
    txtp := av1DctDct
  else if chroma != 0 then
    txtp := if intra then av1TxtpFromUvmode.getD uvMode 0 else av1GetUvInterTxtp tx txtpIn
  else if qidx == 0 then
    txtp := av1DctDct
  else if intra then
    let mode := if yMode != 13 then yMode else av1FilterModeToYMode.getD yAngle.toNat 0
    if reduced || Nat.min lw lh == 2 then
      let (idx, d2, c2) := dec.decodeSymbolAdapt cdf (cdfOff_m_txtp_intra2 + (Nat.min lw lh * 13 + mode) * 8) 4
      dec := d2; cdf := c2
      txtp := av1TxTypesPerSet.getD idx 0
    else
      let (idx, d2, c2) := dec.decodeSymbolAdapt cdf (cdfOff_m_txtp_intra1 + (Nat.min lw lh * 13 + mode) * 8) 6
      dec := d2; cdf := c2
      txtp := av1TxTypesPerSet.getD (idx + 5) 0
  else
    let mn := Nat.min lw lh
    let mx := Nat.max lw lh
    if reduced || mx == 3 then
      let (idx, d2, c2) := dec.decodeBoolAdapt cdf (cdfOff_m_txtp_inter3 + mn * 2)
      dec := d2; cdf := c2
      txtp := if idx == 0 then av1Idtx else av1DctDct
    else if mn == 2 then
      let (idx, d2, c2) := dec.decodeSymbolAdapt cdf cdfOff_m_txtp_inter2 11
      dec := d2; cdf := c2
      txtp := av1TxTypesPerSet.getD (idx + 12) 0
    else
      let (idx, d2, c2) := dec.decodeSymbolAdapt cdf (cdfOff_m_txtp_inter1 + mn * 16) 15
      dec := d2; cdf := c2
      txtp := av1TxTypesPerSet.getD (idx + 24) 0
  let slw := Nat.min lw 3
  let slh := Nat.min lh 3
  let tx2d := slw + slh
  let txClass := av1TxTypeClass.getD txtp 0
  let is1d : Nat := if txClass != 0 then 1 else 0
  let off := av1EobBinCdfOff.getD tx2d 0
  let eobNs := av1EobNs.getD tx2d 8
  let eobOff := if tx2d < 5 then off + (chroma * 2 + is1d) * eobNs else off + chroma * eobNs
  let (eob0, d3, c3) := dec.decodeSymbolAdapt cdf eobOff (4 + tx2d)
  dec := d3; cdf := c3
  let mut eob := eob0
  if eob > 1 then
    let eobBin := eob - 2
    let (hi, d4, c4) := dec.decodeBoolAdapt cdf (cdfOff_coef_eob_hi_bit + (ctx * 2 * 9 + chroma * 9 + eobBin) * 2)
    dec := d4; cdf := c4
    let (loBits, d5) := dec.decodeBools eobBin
    dec := d5
    eob := ((hi ||| 2) <<< eobBin) ||| loBits
  let eobBase := cdfOff_coef_eob_base_tok + (ctx * 2 + chroma) * 16
  let hiBase := cdfOff_coef_br_tok + (Nat.min ctx 3 * 2 + chroma) * 84
  let loBase := cdfOff_coef_base_tok + (ctx * 2 + chroma) * 164
  let mut rc : Nat := 0
  let mut dcTok : Nat := 0
  if eob != 0 then
    let c0 := 1 + (if eob > (2 <<< tx2d) then 1 else 0) + (if eob > (4 <<< tx2d) then 1 else 0)
    let (eobTok, d4, c4) := dec.decodeSymbolAdapt cdf (eobBase + c0 * 4) 2
    dec := d4; cdf := c4
    let mut tok := eobTok + 1
    let mut levelTok := tok * 0x41
    let scan := av1ScanForTx tx
    let (stride, shift, mask, x0, y0, rc0) :=
      if txClass == 0 then
        let st := 4 <<< slh
        let shf := slh + 2
        let msk := (4 <<< slh) - 1
        let r0 := scan.getD eob 0
        (st, shf, msk, r0 >>> shf, r0 &&& msk, r0)
      else if txClass == 1 then
        let shf := slh + 2
        let msk := (4 <<< slh) - 1
        (16, shf, msk, eob &&& msk, eob >>> shf, eob)
      else
        let shf := slw + 2
        let msk := (4 <<< slw) - 1
        let xx := eob &&& msk
        let yy := eob >>> shf
        (16, shf, msk, xx, yy, (xx <<< (slh + 2)) ||| yy)
    if eobTok == 2 then
      let c1Idx := if (if txClass == 0 then (x0 ||| y0) > 1 else y0 != 0) then 14 else 7
      let (ht, d5, c5) := dec.decodeHiTok cdf (hiBase + c1Idx * 4)
      dec := d5; cdf := c5
      tok := ht
      levelTok := tok + (3 <<< 6)
    cf := cf.set! rc0 (Int.ofNat (tok <<< 11))
    let levLen := stride * ((4 <<< (if txClass != 1 then slw else slh)) + 2)
    let mut levels := Array.replicate levLen 0
    let levelAt0 := if txClass == 0 then rc0 else x0 * stride + y0
    levels := levels.set! levelAt0 (levelTok &&& 0xFF)
    rc := rc0
    let mut stepIdx := eob - 1
    while stepIdx > 0 do
      let i := stepIdx
      let (x, y, rcI, levelAt) :=
        if txClass == 0 then
          let rI := scan.getD i 0
          (rI >>> shift, rI &&& mask, rI, rI)
        else if txClass == 1 then
          let xx := i &&& mask
          let yy := i >>> shift
          (xx, yy, i, xx * stride + yy)
        else
          let xx := i &&& mask
          let yy := i >>> shift
          (xx, yy, (xx <<< (slh + 2)) ||| yy, xx * stride + yy)
      let (ctxI, mag0) := av1LoCtx levels levelAt txClass tx x y stride
      let yy := if txClass == 0 then (y ||| x) else y
      let (tokI, d6, c6) := dec.decodeSymbolAdapt cdf (loBase + ctxI * 4) 3
      dec := d6; cdf := c6
      if tokI == 3 then
        let mag := mag0 &&& 63
        let c2 := (if yy > (if txClass == 0 then 1 else 0) then 14 else 7) + (if mag > 12 then 6 else (mag + 1) >>> 1)
        let (ht, d7, c7) := dec.decodeHiTok cdf (hiBase + c2 * 4)
        dec := d7; cdf := c7
        levels := levels.set! levelAt ((ht + (3 <<< 6)) &&& 0xFF)
        cf := cf.set! rcI (Int.ofNat ((ht <<< 11) ||| rc))
        rc := rcI
      else
        levels := levels.set! levelAt ((tokI * 65) &&& 255)
        if tokI != 0 then
          cf := cf.set! rcI (Int.ofNat ((tokI <<< 11) ||| rc))
          rc := rcI
        else
          cf := cf.set! rcI 0
      stepIdx := stepIdx - 1
    let (ctxDc, magDc0) :=
      if txClass == 0 then (0, 0)
      else av1LoCtx levels 0 txClass tx 0 0 stride
    let (dct0, d8, c8) := dec.decodeSymbolAdapt cdf (loBase + ctxDc * 4) 3
    dec := d8; cdf := c8
    dcTok := dct0
    if dcTok == 3 then
      let magDc :=
        if txClass == 0 then
          (levels.getD 1 0 + levels.getD stride 0 + levels.getD (stride + 1) 0) &&& 63
        else
          magDc0 &&& 63
      let c3Idx := if magDc > 12 then 6 else (magDc + 1) >>> 1
      let (ht, d9, c9) := dec.decodeHiTok cdf (hiBase + c3Idx * 4)
      dec := d9; cdf := c9
      dcTok := ht
  else
    let (tokBr, d4, c4) := dec.decodeSymbolAdapt cdf eobBase 2
    dec := d4; cdf := c4
    dcTok := 1 + tokBr
    if tokBr == 2 then
      let (ht, d5, c5) := dec.decodeHiTok cdf hiBase
      dec := d5; cdf := c5
      dcTok := ht
  let dqShift := if ctx >= 2 then ctx - 2 else 0
  let cfMax : Nat := 0x7FFF
  let qmTblOpt : Option (Array Nat) :=
    if txtp < av1Idtx then
      match qmOpt with
      | some planeQm => some (planeQm.getD tx #[])
      | none => none
    else
      none
  let mut cul : Nat := 0
  let mut dcSignLevel : Nat := 1 <<< 6
  if dcTok != 0 then
    let dcCtx := av1DcSignCtx tx aArr aOff lArr lOff
    let (dcSign, d6, c6) := dec.decodeBoolAdapt cdf (cdfOff_coef_dc_sign + (chroma * 3 + dcCtx) * 2)
    dec := d6; cdf := c6
    dcSignLevel := if dcSign == 0 then (2 <<< 6) else 0
    let mut dcDq :=
      match qmTblOpt with
      | some qt => (dqDc * qt.getD 0 32 + 16) >>> 5
      | none => dqDc
    let mut dcTokFull := dcTok
    if dcTokFull == 15 then
      let (gol, d7) := av1ReadGolomb dec
      dec := d7
      dcTokFull := (gol + 15) &&& 0xFFFFF
      dcDq := (dcDq * dcTokFull) &&& 0xFFFFFF
    else
      dcDq := dcDq * dcTokFull
    cul := dcTokFull
    dcDq := Nat.min (dcDq >>> dqShift) (cfMax + dcSign)
    cf := cf.set! 0 (if dcSign != 0 then -(Int.ofNat dcDq) else Int.ofNat dcDq)
  if rc != 0 then
    while rc != 0 do
      let (sign, d7) := dec.decodeBoolEqui
      dec := d7
      let rcTok := (cf.getD rc 0).toNat
      let mut q :=
        match qmTblOpt with
        | some qt => (dqAc * qt.getD rc 32 + 16) >>> 5
        | none => dqAc
      let mut tok : Nat := 0
      if rcTok >= (15 <<< 11) then
        let (gol, d8) := av1ReadGolomb dec
        dec := d8
        tok := (gol + 15) &&& 0xFFFFF
        q := (q * tok) &&& 0xFFFFFF
      else
        tok := rcTok >>> 11
        q := q * tok
      cul := cul + tok
      q := Nat.min (q >>> dqShift) (cfMax + sign)
      cf := cf.set! rc (if sign != 0 then -(Int.ofNat q) else Int.ofNat q)
      rc := rcTok &&& 0x3FF
  return (Int.ofNat eob, txtp, Nat.min cul 63 ||| dcSignLevel, dec, cdf, cf)

def av1EncodeCoefs (enc0 : Av1MsacEncoder) (cdf0 : Array Nat) (qcoeff : Array Int)
    (tx bs : Nat) (intra : Bool) (plane yMode uvMode : Nat)
    (reduced : Bool) (qidx : Nat) (lossless : Bool)
    (aArr : Array Nat) (aOff : Nat) (lArr : Array Nat) (lOff : Nat)
    (dqDc dqAc : Nat) (txtpIn : Nat := 0) :
    Int × Nat × Nat × Array Int × Av1MsacEncoder × Array Nat := Id.run do
  let mut enc := enc0
  let mut cdf := cdf0
  let chroma : Nat := if plane != 0 then 1 else 0
  let (w4, h4, lw, lh, ctx) := av1TxDim tx
  let sctx := av1CoefSkipCtx tx bs aArr aOff lArr lOff chroma
  let base := cdfOff_coef_skip + (ctx * 13 + sctx) * 2
  let scan := av1ScanForTx tx
  let nCoefs := (4 * w4) * (4 * h4)
  let mut cfOut : Array Int := Array.replicate nCoefs 0
  let mut eobInt : Int := -1
  for i in [:nCoefs] do
    if qcoeff.getD (scan.getD i 0) 0 != 0 then
      eobInt := Int.ofNat i
  if eobInt < 0 then
    let (e1, c1) := enc.encodeBoolAdapt 1 cdf base
    return (-1, if lossless then av1WhtWht else av1DctDct, 0x40, cfOut, e1, c1)
  let (e1, c1) := enc.encodeBoolAdapt 0 cdf base
  enc := e1; cdf := c1
  let mut txtp : Nat := av1DctDct
  if lossless then
    txtp := av1WhtWht
  else if av1TxfmDim.getD (tx * 8 + 5) 0 + (if intra then 1 else 0) >= 4 then
    txtp := av1DctDct
  else if chroma != 0 then
    txtp := if intra then av1TxtpFromUvmode.getD uvMode 0 else av1GetUvInterTxtp tx txtpIn
  else if qidx == 0 then
    txtp := av1DctDct
  else if intra then
    if reduced || Nat.min lw lh == 2 then
      let (e2, c2) := enc.encodeSymbolAdapt 1 cdf (cdfOff_m_txtp_intra2 + (Nat.min lw lh * 13 + yMode) * 8) 4
      enc := e2; cdf := c2
    else
      let (e2, c2) := enc.encodeSymbolAdapt 1 cdf (cdfOff_m_txtp_intra1 + (Nat.min lw lh * 13 + yMode) * 8) 6
      enc := e2; cdf := c2
    txtp := av1DctDct
  else
    let mn := Nat.min lw lh
    let mx := Nat.max lw lh
    if reduced || mx == 3 then
      let (e2, c2) := enc.encodeBoolAdapt 1 cdf (cdfOff_m_txtp_inter3 + mn * 2)
      enc := e2; cdf := c2
    else if mn == 2 then
      let (e2, c2) := enc.encodeSymbolAdapt 3 cdf cdfOff_m_txtp_inter2 11
      enc := e2; cdf := c2
    else
      let (e2, c2) := enc.encodeSymbolAdapt 7 cdf (cdfOff_m_txtp_inter1 + mn * 16) 15
      enc := e2; cdf := c2
    txtp := av1DctDct
  let slw := Nat.min lw 3
  let slh := Nat.min lh 3
  let tx2d := slw + slh
  let off := av1EobBinCdfOff.getD tx2d 0
  let eobNs := av1EobNs.getD tx2d 8
  let eobOff := if tx2d < 5 then off + (chroma * 2) * eobNs else off + chroma * eobNs
  let eob := eobInt.toNat
  if eob <= 1 then
    let (e2, c2) := enc.encodeSymbolAdapt eob cdf eobOff (4 + tx2d)
    enc := e2; cdf := c2
  else
    let k := av1Ulog2 eob
    let eobBin := k - 1
    let (e2, c2) := enc.encodeSymbolAdapt (eobBin + 2) cdf eobOff (4 + tx2d)
    enc := e2; cdf := c2
    let (e3, c3) := enc.encodeBoolAdapt ((eob >>> eobBin) &&& 1) cdf
      (cdfOff_coef_eob_hi_bit + (ctx * 2 * 9 + chroma * 9 + eobBin) * 2)
    enc := e3; cdf := c3
    enc := enc.encodeBools (eob &&& ((1 <<< eobBin) - 1)) eobBin
  let eobBase := cdfOff_coef_eob_base_tok + (ctx * 2 + chroma) * 16
  let hiBase := cdfOff_coef_br_tok + (Nat.min ctx 3 * 2 + chroma) * 84
  let loBase := cdfOff_coef_base_tok + (ctx * 2 + chroma) * 164
  let stride := 4 <<< slh
  let shift := slh + 2
  let mask := (4 <<< slh) - 1
  let mut acRcs : Array Nat := #[]
  let mut dcTok : Nat := 0
  if eob > 0 then
    let c0 := 1 + (if eob > (2 <<< tx2d) then 1 else 0) + (if eob > (4 <<< tx2d) then 1 else 0)
    let rc0 := scan.getD eob 0
    let tok0 := Nat.min (qcoeff.getD rc0 0).natAbs 15
    let eobTok := Nat.min (tok0 - 1) 2
    let (e2, c2) := enc.encodeSymbolAdapt eobTok cdf (eobBase + c0 * 4) 2
    enc := e2; cdf := c2
    let x := rc0 >>> shift
    let y := rc0 &&& mask
    let levelTok :=
      if eobTok == 2 then
        tok0 + (3 <<< 6)
      else
        tok0 * 0x41
    if eobTok == 2 then
      let c1Idx := if (x ||| y) > 1 then 14 else 7
      let (e3, c3) := enc.encodeHiTok tok0 cdf (hiBase + c1Idx * 4)
      enc := e3; cdf := c3
    let mut levels := Array.replicate (stride * ((4 <<< slw) + 2)) 0
    levels := levels.set! rc0 (levelTok &&& 0xFF)
    acRcs := acRcs.push rc0
    let mut stepIdx := eob - 1
    while stepIdx > 0 do
      let rcI := scan.getD stepIdx 0
      let xi := rcI >>> shift
      let yi := rcI &&& mask
      let (ctxI, mag0) := av1LoCtx levels rcI 0 tx xi yi stride
      let tokI := Nat.min (qcoeff.getD rcI 0).natAbs 15
      let baseSym := Nat.min tokI 3
      let (e4, c4) := enc.encodeSymbolAdapt baseSym cdf (loBase + ctxI * 4) 3
      enc := e4; cdf := c4
      if baseSym == 3 then
        let mag := mag0 &&& 63
        let c2Idx := (if (yi ||| xi) > 1 then 14 else 7) + (if mag > 12 then 6 else (mag + 1) >>> 1)
        let (e5, c5) := enc.encodeHiTok tokI cdf (hiBase + c2Idx * 4)
        enc := e5; cdf := c5
        levels := levels.set! rcI ((tokI + (3 <<< 6)) &&& 0xFF)
        acRcs := acRcs.push rcI
      else
        levels := levels.set! rcI ((tokI * 65) &&& 255)
        if tokI != 0 then
          acRcs := acRcs.push rcI
      stepIdx := stepIdx - 1
    dcTok := Nat.min (qcoeff.getD 0 0).natAbs 15
    let (e6, c6) := enc.encodeSymbolAdapt (Nat.min dcTok 3) cdf loBase 3
    enc := e6; cdf := c6
    if dcTok >= 3 then
      let mag := (levels.getD 1 0 + levels.getD stride 0 + levels.getD (stride + 1) 0) &&& 63
      let c3Idx := if mag > 12 then 6 else (mag + 1) >>> 1
      let (e7, c7) := enc.encodeHiTok dcTok cdf (hiBase + c3Idx * 4)
      enc := e7; cdf := c7
  else
    dcTok := Nat.min (qcoeff.getD 0 0).natAbs 15
    let tokBr := Nat.min (dcTok - 1) 2
    let (e2, c2) := enc.encodeSymbolAdapt tokBr cdf eobBase 2
    enc := e2; cdf := c2
    if tokBr == 2 then
      let (e3, c3) := enc.encodeHiTok dcTok cdf hiBase
      enc := e3; cdf := c3
  let dqShift := if ctx >= 2 then ctx - 2 else 0
  let cfMax : Nat := 0x7FFF
  let mut cul : Nat := 0
  let mut dcSignLevel : Nat := 1 <<< 6
  if dcTok != 0 then
    let dcCtx := av1DcSignCtx tx aArr aOff lArr lOff
    let dcSign : Nat := if qcoeff.getD 0 0 < 0 then 1 else 0
    let (e4, c4) := enc.encodeBoolAdapt dcSign cdf (cdfOff_coef_dc_sign + (chroma * 3 + dcCtx) * 2)
    enc := e4; cdf := c4
    dcSignLevel := if dcSign == 0 then (2 <<< 6) else 0
    let dcFull := (qcoeff.getD 0 0).natAbs
    let mut dcDq : Nat := 0
    if dcTok == 15 then
      enc := av1WriteGolomb enc (dcFull - 15)
      dcDq := (dqDc * (dcFull &&& 0xFFFFF)) &&& 0xFFFFFF
    else
      dcDq := dqDc * dcFull
    cul := dcFull
    dcDq := Nat.min (dcDq >>> dqShift) (cfMax + dcSign)
    cfOut := cfOut.set! 0 (if dcSign != 0 then -(Int.ofNat dcDq) else Int.ofNat dcDq)
  let nAc := acRcs.size
  for k in [:nAc] do
    let rcK := acRcs.getD (nAc - 1 - k) 0
    let sign : Nat := if qcoeff.getD rcK 0 < 0 then 1 else 0
    enc := enc.encodeBoolEqui sign
    let acFull := (qcoeff.getD rcK 0).natAbs
    let mut q : Nat := 0
    if acFull >= 15 then
      enc := av1WriteGolomb enc (acFull - 15)
      q := (dqAc * (acFull &&& 0xFFFFF)) &&& 0xFFFFFF
    else
      q := dqAc * acFull
    cul := cul + acFull
    q := Nat.min (q >>> dqShift) (cfMax + sign)
    cfOut := cfOut.set! rcK (if sign != 0 then -(Int.ofNat q) else Int.ofNat q)
  return (eobInt, txtp, Nat.min cul 63 ||| dcSignLevel, cfOut, enc, cdf)

@[inline] def av1DiagDownLeftPred : Nat := 3
@[inline] def av1DiagDownRightPred : Nat := 4
@[inline] def av1VertRightPred : Nat := 5
@[inline] def av1HorDownPred : Nat := 6
@[inline] def av1HorUpPred : Nat := 7
@[inline] def av1VertLeftPred : Nat := 8
@[inline] def av1SmoothVPred : Nat := 10
@[inline] def av1SmoothHPred : Nat := 11
@[inline] def av1FilterPred : Nat := 13
@[inline] def av1LeftDcPred : Nat := 14
@[inline] def av1TopDcPred : Nat := 15
@[inline] def av1Dc128Pred : Nat := 16
@[inline] def av1Z1Pred : Nat := 17
@[inline] def av1Z2Pred : Nat := 18
@[inline] def av1Z3Pred : Nat := 19

def av1ModeToAngle : Array Int := #[90, 180, 45, 135, 113, 157, 203, 67]

def av1EdgeNeeds (mode : Nat) : Bool × Bool × Bool × Bool × Bool :=
  match mode with
  | 0  => (true,  true,  false, false, false) -- DC_PRED
  | 1  => (false, true,  false, false, false) -- VERT_PRED
  | 2  => (true,  false, false, false, false) -- HOR_PRED
  | 9  => (true,  true,  false, false, false) -- SMOOTH_PRED
  | 10 => (true,  true,  false, false, false) -- SMOOTH_V_PRED
  | 11 => (true,  true,  false, false, false) -- SMOOTH_H_PRED
  | 12 => (true,  true,  true,  false, false) -- PAETH_PRED
  | 13 => (true,  true,  true,  false, false) -- FILTER_PRED
  | 14 => (true,  false, false, false, false) -- LEFT_DC_PRED
  | 15 => (false, true,  false, false, false) -- TOP_DC_PRED
  | 16 => (false, false, false, false, false) -- DC_128_PRED
  | 17 => (false, true,  true,  true,  false) -- Z1_PRED
  | 18 => (true,  true,  true,  false, false) -- Z2_PRED
  | 19 => (true,  false, true,  false, true)  -- Z3_PRED
  | _  => (false, false, false, false, false)

def av1FilterEdgeKernel : Array (Array Nat) := #[
  #[0, 4, 8, 4, 0],
  #[0, 5, 6, 5, 0],
  #[2, 4, 4, 4, 2]
]

@[inline]
def av1Ctz (v : Nat) : Nat :=
  let rec go (fuel x acc : Nat) : Nat :=
    match fuel with
    | 0 => acc
    | f + 1 => if x == 0 || (x &&& 1) != 0 then acc else go f (x >>> 1) (acc + 1)
  go 64 v 0

def av1PrepareIntraEdges (x : Nat) (haveLeft : Bool) (y : Nat) (haveTop : Bool)
    (w h edgeFlags : Nat) (planeBuf : Array Nat) (dstOff stride : Nat)
    (topSbEdge : Option (Array Nat)) (topSbOff modeIn : Nat) (angleIn : Int)
    (tw th filterEdgeFlag : Nat) : Nat × Int × Array Nat × Nat := Id.run do
  let mut mode := modeIn
  let mut angle := angleIn
  if av1VertPred <= mode && mode <= av1VertLeftPred then
    angle := av1ModeToAngle.getD (mode - av1VertPred) 90 + 3 * angle
    if angle <= 90 then
      mode := if angle < 90 && haveTop then av1Z1Pred else av1VertPred
    else if angle < 180 then
      mode := av1Z2Pred
    else
      mode := if angle > 180 && haveLeft then av1Z3Pred else av1HorPred
  else if mode == av1DcPred then
    mode := if haveLeft then (if haveTop then av1DcPred else av1LeftDcPred)
            else (if haveTop then av1TopDcPred else av1Dc128Pred)
  else if mode == av1PaethPred then
    mode := if haveLeft then (if haveTop then av1PaethPred else av1HorPred)
            else (if haveTop then av1VertPred else av1Dc128Pred)
  let (nl, nt, ntl, ntr, nbl) := av1EdgeNeeds mode
  let tlIdx : Nat := 160
  let mut edge : Array Nat := Array.replicate 320 0
  let mut useSbTop := false
  let mut dstTopOff : Int := 0
  if haveTop && (nt || ntl || (nl && !haveLeft)) then
    match topSbEdge with
    | some _ =>
      useSbTop := true
      dstTopOff := Int.ofNat (topSbOff + x * 4)
    | none =>
      dstTopOff := Int.ofNat dstOff - Int.ofNat stride
  let topSrc (idx : Int) : Nat :=
    let p := (dstTopOff + idx).toNat
    if useSbTop then
      match topSbEdge with
      | some sb => sb.getD p 0
      | none    => 0
    else
      planeBuf.getD p 0
  if nl then
    let sz := th <<< 2
    let leftBase := tlIdx - sz
    if haveLeft then
      let pxHave := Nat.min sz ((h - y) <<< 2)
      for i in [:pxHave] do
        edge := edge.set! (leftBase + sz - 1 - i) (planeBuf.getD (dstOff + stride * i - 1) 0)
      if pxHave < sz then
        let fill := edge.getD (leftBase + sz - pxHave) 0
        for i in [:sz - pxHave] do
          edge := edge.set! (leftBase + i) fill
    else
      let fill := if haveTop then topSrc 0 else 129
      for i in [:sz] do
        edge := edge.set! (leftBase + i) fill
    if nbl then
      let haveBl := if haveLeft && y + th < h then (edgeFlags &&& av1EdgeI444LeftHasBottom) != 0 else false
      if haveBl then
        let pxHave := Nat.min sz ((h - y - th) <<< 2)
        for i in [:pxHave] do
          edge := edge.set! (leftBase - (i + 1)) (planeBuf.getD (dstOff + (sz + i) * stride - 1) 0)
        if pxHave < sz then
          let fill := edge.getD (leftBase - pxHave) 0
          for i in [:sz - pxHave] do
            edge := edge.set! (leftBase - sz + i) fill
      else
        let fill := edge.getD leftBase 0
        for i in [:sz] do
          edge := edge.set! (leftBase - sz + i) fill
  if nt then
    let sz := tw <<< 2
    let topBase := tlIdx + 1
    if haveTop then
      let pxHave := Nat.min sz ((w - x) <<< 2)
      for i in [:pxHave] do
        edge := edge.set! (topBase + i) (topSrc (Int.ofNat i))
      if pxHave < sz then
        let fill := edge.getD (topBase + pxHave - 1) 0
        for i in [pxHave:sz] do
          edge := edge.set! (topBase + i) fill
    else
      let fill := if haveLeft then planeBuf.getD (dstOff - 1) 0 else 127
      for i in [:sz] do
        edge := edge.set! (topBase + i) fill
    if ntr then
      let haveTr := if haveTop && x + tw < w then (edgeFlags &&& av1EdgeI444TopHasRight) != 0 else false
      if haveTr then
        let pxHave := Nat.min sz ((w - x - tw) <<< 2)
        for i in [:pxHave] do
          edge := edge.set! (topBase + sz + i) (topSrc (Int.ofNat (sz + i)))
        if pxHave < sz then
          let fill := edge.getD (topBase + sz + pxHave - 1) 0
          for i in [pxHave:sz] do
            edge := edge.set! (topBase + sz + i) fill
      else
        let fill := edge.getD (topBase + sz - 1) 0
        for i in [:sz] do
          edge := edge.set! (topBase + sz + i) fill
  if ntl then
    if haveLeft then
      edge := edge.set! tlIdx (if haveTop then topSrc (-1) else planeBuf.getD (dstOff - 1) 0)
    else
      edge := edge.set! tlIdx (if haveTop then topSrc 0 else 128)
    if mode == av1Z2Pred && tw + th >= 6 && filterEdgeFlag != 0 then
      let v := ((edge.getD (tlIdx - 1) 0 + edge.getD (tlIdx + 1) 0) * 5 + edge.getD tlIdx 0 * 6 + 8) >>> 4
      edge := edge.set! tlIdx v
  return (mode, angle, edge, tlIdx)

def av1DcGenTop (edge : Array Nat) (tl width : Nat) : Nat := Id.run do
  let mut dc := width >>> 1
  for i in [:width] do
    dc := dc + edge.getD (tl + 1 + i) 0
  return dc >>> av1Ctz width

def av1DcGenLeft (edge : Array Nat) (tl height : Nat) : Nat := Id.run do
  let mut dc := height >>> 1
  for i in [:height] do
    dc := dc + edge.getD (tl - (1 + i)) 0
  return dc >>> av1Ctz height

def av1DcGen (edge : Array Nat) (tl width height : Nat) : Nat := Id.run do
  let mut dc := (width + height) >>> 1
  for i in [:width] do
    dc := dc + edge.getD (tl + 1 + i) 0
  for i in [:height] do
    dc := dc + edge.getD (tl - (1 + i)) 0
  dc := dc >>> av1Ctz (width + height)
  if width != height then
    let mult := if width > height * 2 || height > width * 2 then 13108 else 21846
    dc := (dc * mult) >>> 16
  return dc

def av1GetFilterStrength (wh : Nat) (angle : Int) (isSm : Nat) : Nat :=
  if isSm != 0 then
    if wh <= 8 then if angle >= 64 then 2 else if angle >= 40 then 1 else 0
    else if wh <= 16 then if angle >= 48 then 2 else if angle >= 20 then 1 else 0
    else if wh <= 24 then if angle >= 4 then 3 else 0
    else 3
  else
    if wh <= 8 then if angle >= 56 then 1 else 0
    else if wh <= 16 then if angle >= 40 then 1 else 0
    else if wh <= 24 then if angle >= 32 then 3 else if angle >= 16 then 2 else if angle >= 8 then 1 else 0
    else if wh <= 32 then if angle >= 32 then 3 else if angle >= 4 then 2 else 1
    else 3

@[inline]
def av1GetUpsample (wh : Nat) (angle : Int) (isSm : Nat) : Nat :=
  if angle < 40 && wh <= (16 >>> isSm) then 1 else 0

def av1FilterEdge (sz : Nat) (limFrom limTo : Int) (src : Array Nat) (base : Int)
    (fromIdx toIdx : Int) (strength : Nat) : Array Nat := Id.run do
  let mut out : Array Nat := Array.replicate sz 0
  let kern := av1FilterEdgeKernel.getD (strength - 1) #[0, 4, 8, 4, 0]
  let szI := Int.ofNat sz
  let limToClamped := if szI <= limFrom then szI else limFrom
  let c1I : Int := if 0 >= limToClamped then 0 else limToClamped
  let limToClamped2 := if limTo <= szI then limTo else szI
  let c2I : Int := if c1I >= limToClamped2 then c1I else limToClamped2
  let c1 := c1I.toNat
  let c2 := c2I.toNat
  for i in [:c1] do
    let p := (base + av1Iclip (Int.ofNat i) fromIdx (toIdx - 1)).toNat
    out := out.set! i (src.getD p 0)
  for i in [c1:c2] do
    let mut s : Nat := 0
    for j in [:5] do
      let p := (base + av1Iclip (Int.ofNat i - 2 + Int.ofNat j) fromIdx (toIdx - 1)).toNat
      s := s + src.getD p 0 * kern.getD j 0
    out := out.set! i ((s + 8) >>> 4)
  for i in [c2:sz] do
    let p := (base + av1Iclip (Int.ofNat i) fromIdx (toIdx - 1)).toNat
    out := out.set! i (src.getD p 0)
  return out

def av1UpsampleEdge (hsz : Nat) (src : Array Nat) (base fromIdx toIdx : Int) : Array Nat := Id.run do
  let mut out : Array Nat := Array.replicate (2 * hsz) 0
  let kern : Array Int := #[-1, 9, 9, -1]
  for i in [:hsz - 1] do
    let p0 := (base + av1Iclip (Int.ofNat i) fromIdx (toIdx - 1)).toNat
    out := out.set! (i * 2) (src.getD p0 0)
    let mut s : Int := 0
    for j in [:4] do
      let pj := (base + av1Iclip (Int.ofNat i + Int.ofNat j - 1) fromIdx (toIdx - 1)).toNat
      s := s + Int.ofNat (src.getD pj 0) * kern.getD j 0
    out := out.set! (i * 2 + 1) (av1IclipU8 (av1ArithShiftRight (s + 8) 4))
  let iLast := hsz - 1
  let pLast := (base + av1Iclip (Int.ofNat iLast) fromIdx (toIdx - 1)).toNat
  out := out.set! (iLast * 2) (src.getD pLast 0)
  return out

def av1IntraPred (dst0 : Array Nat) (dstOff stride : Nat) (edge : Array Nat) (tl mode width height aArg maxWidth maxHeight : Nat) :
    Array Nat := Id.run do
  let mut dst := dst0
  if mode == av1DcPred || mode == av1TopDcPred || mode == av1LeftDcPred || mode == av1Dc128Pred then
    let dc :=
      if mode == av1DcPred then av1DcGen edge tl width height
      else if mode == av1TopDcPred then av1DcGenTop edge tl width
      else if mode == av1LeftDcPred then av1DcGenLeft edge tl height
      else 128
    for y in [:height] do
      let row := dstOff + y * stride
      for x in [:width] do
        dst := dst.set! (row + x) dc
    return dst
  if mode == av1VertPred then
    for y in [:height] do
      let row := dstOff + y * stride
      for x in [:width] do
        dst := dst.set! (row + x) (edge.getD (tl + 1 + x) 0)
    return dst
  if mode == av1HorPred then
    for y in [:height] do
      let row := dstOff + y * stride
      let v := edge.getD (tl - (1 + y)) 0
      for x in [:width] do
        dst := dst.set! (row + x) v
    return dst
  if mode == av1PaethPred then
    let tlV : Int := Int.ofNat (edge.getD tl 0)
    for y in [:height] do
      let row := dstOff + y * stride
      let lvNat := edge.getD (tl - (y + 1)) 0
      let lv : Int := Int.ofNat lvNat
      for x in [:width] do
        let tvNat := edge.getD (tl + 1 + x) 0
        let tv : Int := Int.ofNat tvNat
        let base := lv + tv - tlV
        let ld := (lv - base).natAbs
        let td := (tv - base).natAbs
        let tld := (tlV - base).natAbs
        let px := if ld <= td && ld <= tld then lvNat else if td <= tld then tvNat else edge.getD tl 0
        dst := dst.set! (row + x) px
    return dst
  if mode == av1SmoothPred then
    let right := edge.getD (tl + width) 0
    let bottom := edge.getD (tl - height) 0
    for y in [:height] do
      let row := dstOff + y * stride
      let wv := av1SmWeights.getD (height + y) 0
      let lv := edge.getD (tl - (1 + y)) 0
      for x in [:width] do
        let wx := av1SmWeights.getD (width + x) 0
        let tv := edge.getD (tl + 1 + x) 0
        let pred := wv * tv + (256 - wv) * bottom + wx * lv + (256 - wx) * right
        dst := dst.set! (row + x) ((pred + 256) >>> 9)
    return dst
  if mode == av1SmoothVPred then
    let bottom := edge.getD (tl - height) 0
    for y in [:height] do
      let row := dstOff + y * stride
      let wv := av1SmWeights.getD (height + y) 0
      for x in [:width] do
        let pred := wv * edge.getD (tl + 1 + x) 0 + (256 - wv) * bottom
        dst := dst.set! (row + x) ((pred + 128) >>> 8)
    return dst
  if mode == av1SmoothHPred then
    let right := edge.getD (tl + width) 0
    for y in [:height] do
      let row := dstOff + y * stride
      let lv := edge.getD (tl - (y + 1)) 0
      for x in [:width] do
        let wx := av1SmWeights.getD (width + x) 0
        let pred := wx * lv + (256 - wx) * right
        dst := dst.set! (row + x) ((pred + 128) >>> 8)
    return dst
  if mode == av1FilterPred then
    let filtIdx := aArg &&& 511
    let fbase := filtIdx * 64
    let mut topFromDst := false
    let mut topPos : Nat := tl + 1
    let ySteps := height / 2
    let xSteps := width / 4
    for ys in [:ySteps] do
      let y := ys * 2
      let mut tlFromDst := false
      let mut tlPos : Int := Int.ofNat (tl - y)
      let mut leftFromDst := false
      let mut leftPos : Int := Int.ofNat (tl - y - 1)
      let mut leftStride : Int := -1
      for xs in [:xSteps] do
        let x := xs * 4
        let rdTop (off : Nat) : Int :=
          Int.ofNat (if topFromDst then dst.getD (topPos + off) 0 else edge.getD (topPos + off) 0)
        let p0 : Int :=
          Int.ofNat (if tlFromDst then dst.getD tlPos.toNat 0 else edge.getD tlPos.toNat 0)
        let p1 := rdTop 0
        let p2 := rdTop 1
        let p3 := rdTop 2
        let p4 := rdTop 3
        let p5 : Int :=
          Int.ofNat (if leftFromDst then dst.getD leftPos.toNat 0 else edge.getD leftPos.toNat 0)
        let p6Pos := (leftPos + leftStride).toNat
        let p6 : Int :=
          Int.ofNat (if leftFromDst then dst.getD p6Pos 0 else edge.getD p6Pos 0)
        let mut fp := fbase
        for yy in [:2] do
          let rOff := dstOff + (y + yy) * stride + x
          for xx in [:4] do
            let acc :=
              av1FilterIntraTaps.getD fp 0 * p0 +
              av1FilterIntraTaps.getD (fp + 8) 0 * p1 +
              av1FilterIntraTaps.getD (fp + 16) 0 * p2 +
              av1FilterIntraTaps.getD (fp + 24) 0 * p3 +
              av1FilterIntraTaps.getD (fp + 32) 0 * p4 +
              av1FilterIntraTaps.getD (fp + 40) 0 * p5 +
              av1FilterIntraTaps.getD (fp + 48) 0 * p6
            dst := dst.set! (rOff + xx) (av1IclipU8 (av1ArithShiftRight (acc + 8) 4))
            fp := fp + 1
        leftFromDst := true
        leftPos := Int.ofNat (dstOff + y * stride + x + 3)
        leftStride := Int.ofNat stride
        topPos := topPos + 4
        tlFromDst := topFromDst
        tlPos := Int.ofNat (topPos - 1)
      topFromDst := true
      topPos := dstOff + (y + 1) * stride
    return dst
  let isSm := (aArg >>> 9) &&& 1
  let enEf := aArg >>> 10
  let angle := aArg &&& 511
  let angleI := Int.ofNat angle
  if mode == av1Z1Pred then
    let mut dx := av1DrIntraDeriv.getD (angle >>> 1) 0
    let up := if enEf != 0 then av1GetUpsample (width + height) (90 - angleI) isSm else 0
    let (topArr, topBase, maxBx) :=
      if up != 0 then
        let t := av1UpsampleEdge (width + height) edge (Int.ofNat (tl + 1)) (-1) (Int.ofNat (width + Nat.min width height))
        (t, 0, 2 * (width + height) - 2)
      else
        let fs := if enEf != 0 then av1GetFilterStrength (width + height) (90 - angleI) isSm else 0
        if fs != 0 then
          let t := av1FilterEdge (width + height) 0 (Int.ofNat (width + height)) edge (Int.ofNat (tl + 1))
            (-1) (Int.ofNat (width + Nat.min width height)) fs
          (t, 0, width + height - 1)
        else
          (edge, tl + 1, width + Nat.min width height - 1)
    if up != 0 then dx := dx <<< 1
    let inc := 1 + up
    let mut xpos := dx
    for y in [:height] do
      let row := dstOff + y * stride
      let frac := xpos &&& 62
      let mut base := xpos >>> 6
      let mut doneRow := false
      for x in [:width] do
        if !doneRow then
          if base < maxBx then
            let v := topArr.getD (topBase + base) 0 * (64 - frac) + topArr.getD (topBase + base + 1) 0 * frac
            dst := dst.set! (row + x) ((v + 32) >>> 6)
            base := base + inc
          else
            let fill := topArr.getD (topBase + maxBx) 0
            for xr in [x:width] do
              dst := dst.set! (row + xr) fill
            doneRow := true
      xpos := xpos + dx
    return dst
  if mode == av1Z2Pred then
    let mut dy : Int := Int.ofNat (av1DrIntraDeriv.getD ((angle - 90) >>> 1) 0)
    let mut dx : Int := Int.ofNat (av1DrIntraDeriv.getD ((180 - angle) >>> 1) 0)
    let upL := if enEf != 0 then av1GetUpsample (width + height) (180 - angleI) isSm else 0
    let upA := if enEf != 0 then av1GetUpsample (width + height) (angleI - 90) isSm else 0
    let mut zEdge : Array Nat := Array.replicate 140 0
    let ztl : Nat := 68
    if upA != 0 then
      let u := av1UpsampleEdge (width + 1) edge (Int.ofNat tl) 0 (Int.ofNat (width + 1))
      for i in [:2 * width + 1] do
        zEdge := zEdge.set! (ztl + i) (u.getD i 0)
      dx := dx * 2
    else
      let fs := if enEf != 0 then av1GetFilterStrength (width + height) (angleI - 90) isSm else 0
      if fs != 0 then
        let fe := av1FilterEdge width 0 (Int.ofNat maxWidth) edge (Int.ofNat (tl + 1)) (-1) (Int.ofNat width) fs
        for i in [:width] do
          zEdge := zEdge.set! (ztl + 1 + i) (fe.getD i 0)
      else
        for i in [:width] do
          zEdge := zEdge.set! (ztl + 1 + i) (edge.getD (tl + 1 + i) 0)
    if upL != 0 then
      let u := av1UpsampleEdge (height + 1) edge (Int.ofNat (tl - height)) 0 (Int.ofNat (height + 1))
      for i in [:2 * height + 1] do
        zEdge := zEdge.set! (ztl - height * 2 + i) (u.getD i 0)
      dy := dy * 2
    else
      let fs := if enEf != 0 then av1GetFilterStrength (width + height) (180 - angleI) isSm else 0
      if fs != 0 then
        let fe := av1FilterEdge height (Int.ofNat height - Int.ofNat maxHeight) (Int.ofNat height)
          edge (Int.ofNat (tl - height)) 0 (Int.ofNat (height + 1)) fs
        for i in [:height] do
          zEdge := zEdge.set! (ztl - height + i) (fe.getD i 0)
      else
        for i in [:height] do
          zEdge := zEdge.set! (ztl - height + i) (edge.getD (tl - height + i) 0)
    zEdge := zEdge.set! ztl (edge.getD tl 0)
    let incX : Int := Int.ofNat (1 + upA)
    let leftZero : Int := Int.ofNat (ztl - (1 + upL))
    let mut xpos : Int := Int.ofNat ((1 + upA) <<< 6) - dx
    for y in [:height] do
      let row := dstOff + y * stride
      let mut bx : Int := av1ArithShiftRight xpos 6
      let fx : Nat := (xpos - bx * 64).toNat &&& 62
      let mut ypos : Int := Int.ofNat (y <<< (6 + upL)) - dy
      for x in [:width] do
        let v : Nat :=
          if bx >= 0 then
            let idx := ztl + bx.toNat
            zEdge.getD idx 0 * (64 - fx) + zEdge.getD (idx + 1) 0 * fx
          else
            let byI := av1ArithShiftRight ypos 6
            let fy : Nat := (ypos - byI * 64).toNat &&& 62
            let idx0 := (leftZero - byI).toNat
            let idx1 := (leftZero - (byI + 1)).toNat
            zEdge.getD idx0 0 * (64 - fy) + zEdge.getD idx1 0 * fy
        dst := dst.set! (row + x) ((v + 32) >>> 6)
        bx := bx + incX
        ypos := ypos - dy
      xpos := xpos - dx
    return dst
  if mode == av1Z3Pred then
    let mut dy := av1DrIntraDeriv.getD ((270 - angle) >>> 1) 0
    let upL := if enEf != 0 then av1GetUpsample (width + height) (angleI - 180) isSm else 0
    let whDiff : Int := Int.ofNat width - Int.ofNat height
    let fromClip : Int := if whDiff > 0 then whDiff else 0
    let (leftSrc, leftZero, maxBy) :=
      if upL != 0 then
        let lo := av1UpsampleEdge (width + height) edge (Int.ofNat (tl - (width + height)))
          fromClip (Int.ofNat (width + height + 1))
        (lo, 2 * (width + height) - 2, 2 * (width + height) - 2)
      else
        let fs := if enEf != 0 then av1GetFilterStrength (width + height) (angleI - 180) isSm else 0
        if fs != 0 then
          let lo := av1FilterEdge (width + height) 0 (Int.ofNat (width + height))
            edge (Int.ofNat (tl - (width + height))) fromClip (Int.ofNat (width + height + 1)) fs
          (lo, width + height - 1, width + height - 1)
        else
          (edge, tl - 1, height + Nat.min width height - 1)
    if upL != 0 then dy := dy <<< 1
    let inc := 1 + upL
    let mut ypos := dy
    for x in [:width] do
      let frac := ypos &&& 62
      let mut base := ypos >>> 6
      let mut doneCol := false
      for y in [:height] do
        if !doneCol then
          if base < maxBy then
            let v := leftSrc.getD (leftZero - base) 0 * (64 - frac) + leftSrc.getD (leftZero - (base + 1)) 0 * frac
            dst := dst.set! (dstOff + y * stride + x) ((v + 32) >>> 6)
            base := base + inc
          else
            let fill := leftSrc.getD (leftZero - maxBy) 0
            for yr in [y:height] do
              dst := dst.set! (dstOff + yr * stride + x) fill
            doneCol := true
      ypos := ypos + dy
  return dst

def av1CflAc420 (yPlane : Array Nat) (yOff yStride wPad hPad cw ch : Nat) : Array Int := Id.run do
  let mut ac : Array Int := Array.replicate (cw * ch) 0
  let visH := ch - 4 * hPad
  let visW := cw - 4 * wPad
  for y in [:visH] do
    let yp := yOff + (y * 2) * yStride
    let row := y * cw
    for x in [:visW] do
      let s :=
        yPlane.getD (yp + x * 2) 0 + yPlane.getD (yp + x * 2 + 1) 0 +
        yPlane.getD (yp + yStride + x * 2) 0 + yPlane.getD (yp + yStride + x * 2 + 1) 0
      ac := ac.set! (row + x) (Int.ofNat (s <<< 1))
    for x in [visW:cw] do
      ac := ac.set! (row + x) (ac.getD (row + x - 1) 0)
  for y in [visH:ch] do
    let srcRow := (y - 1) * cw
    let dstRow := y * cw
    for x in [:cw] do
      ac := ac.set! (dstRow + x) (ac.getD (srcRow + x) 0)
  let log2sz := av1Ctz cw + av1Ctz ch
  let mut sumAc : Int := Int.ofNat ((1 <<< log2sz) >>> 1)
  for i in [:cw * ch] do
    sumAc := sumAc + ac.getD i 0
  let avg := av1ArithShiftRight sumAc log2sz
  for i in [:cw * ch] do
    ac := ac.set! i (ac.getD i 0 - avg)
  return ac

def av1CflPredict (dst0 : Array Nat) (dstOff stride : Nat) (edge : Array Nat)
    (tl dcMode width height : Nat) (ac : Array Int) (alpha : Int) : Array Nat := Id.run do
  let mut dst := dst0
  let dc : Int := Int.ofNat (
    if dcMode == av1DcPred then av1DcGen edge tl width height
    else if dcMode == av1TopDcPred then av1DcGenTop edge tl width
    else if dcMode == av1LeftDcPred then av1DcGenLeft edge tl height
    else 128)
  for y in [:height] do
    let row := dstOff + y * stride
    let arow := y * width
    for x in [:width] do
      let diff := alpha * ac.getD (arow + x) 0
      let scaled := av1ApplySign (Int.ofNat ((diff.natAbs + 32) >>> 6)) diff
      dst := dst.set! (row + x) (av1IclipU8 (dc + scaled))
  return dst

def av1PalPred (dst0 : Array Nat) (dstOff stride : Nat) (pal palIdx : Array Nat) (w h : Nat) : Array Nat := Id.run do
  let mut dst := dst0
  for y in [:h] do
    let row := dstOff + y * stride
    let pRow := y * w
    for x in [:w] do
      dst := dst.set! (row + x) (pal.getD (palIdx.getD (pRow + x) 0) 0)
  return dst

@[inline] def av1Filter2d8TapRegular : Nat := 0
@[inline] def av1Filter2d8TapRegularSmooth : Nat := 1
@[inline] def av1Filter2d8TapRegularSharp : Nat := 2
@[inline] def av1Filter2d8TapSharpRegular : Nat := 3
@[inline] def av1Filter2d8TapSharpSmooth : Nat := 4
@[inline] def av1Filter2d8TapSharp : Nat := 5
@[inline] def av1Filter2d8TapSmoothRegular : Nat := 6
@[inline] def av1Filter2d8TapSmooth : Nat := 7
@[inline] def av1Filter2d8TapSmoothSharp : Nat := 8
@[inline] def av1Filter2dBilinear : Nat := 9

def av1Filter2dHv (f2d : Nat) : Nat × Nat :=
  match f2d with
  | 0 => (0, 0)
  | 1 => (0, 1)
  | 2 => (0, 2)
  | 3 => (2, 0)
  | 4 => (2, 1)
  | 5 => (2, 2)
  | 6 => (1, 0)
  | 7 => (1, 1)
  | 8 => (1, 2)
  | _ => (0, 0)

@[inline]
private def av1ApplySign64 (v s : Int) : Int :=
  if s < 0 then -v else v

@[inline]
private def av1IclipWmp (v : Int) : Int :=
  let cv := av1Iclip v (-32768) 32767
  av1ApplySign (Int.ofNat ((cv.natAbs + 32) >>> 6)) cv * 64

private def av1ResolveDivisor (d : Nat) : Int × Nat :=
  let sh := if d == 0 then 0 else av1BitLength32 d - 1
  let e := d - (1 <<< sh)
  let f := if sh > 8 then (e + (1 <<< (sh - 9))) >>> (sh - 8) else e <<< (8 - sh)
  (Int.ofNat (av1DivLut.getD f 0), sh + 14)

def av1GetShearParams (wm : Av1WmParams) : Bool × Av1WmParams :=
  let mat := wm.matrix
  let m2 := mat.getD 2 0
  if m2 <= 0 then
    (true, wm)
  else
    let m3 := mat.getD 3 0
    let m4 := mat.getD 4 0
    let m5 := mat.getD 5 0
    let alpha := av1IclipWmp (m2 - 65536)
    let beta := av1IclipWmp m3
    let (yDiv, shift) := av1ResolveDivisor m2.natAbs
    let y := av1ApplySign yDiv m2
    let rnd : Int := Int.ofNat ((1 <<< shift) >>> 1)
    let v1 := m4 * 65536 * y
    let gamma := av1IclipWmp (av1ApplySign64 (av1ArithShiftRight (Int.ofNat v1.natAbs + rnd) shift) v1)
    let v2 := m3 * m4 * y
    let delta := av1IclipWmp (m5 - av1ApplySign64 (av1ArithShiftRight (Int.ofNat v2.natAbs + rnd) shift) v2 - 65536)
    let invalid := 4 * alpha.natAbs + 7 * beta.natAbs >= 65536 || 4 * gamma.natAbs + 4 * delta.natAbs >= 65536
    (invalid, { wm with abcd := #[alpha, beta, gamma, delta] })

def av1SetAffineMv2d (bw4 bh4 : Nat) (mv : Int × Int) (wm : Av1WmParams) (bx4 by4 : Nat) : Av1WmParams :=
  let mat := wm.matrix
  let rsuy : Int := Int.ofNat (2 * bh4) - 1
  let rsux : Int := Int.ofNat (2 * bw4) - 1
  let isuy : Int := Int.ofNat (by4 * 4) + rsuy
  let isux : Int := Int.ofNat (bx4 * 4) + rsux
  let m2 := mat.getD 2 65536
  let m3 := mat.getD 3 0
  let m4 := mat.getD 4 0
  let m5 := mat.getD 5 65536
  let m0 := av1Iclip (mv.2 * 8192 - (isux * (m2 - 65536) + isuy * m3)) (-8388608) 8388607
  let m1 := av1Iclip (mv.1 * 8192 - (isux * m4 + isuy * (m5 - 65536))) (-8388608) 8388607
  { wm with matrix := #[m0, m1, m2, m3, m4, m5] }

def av1FindAffineInt (pts : Array ((Int × Int) × (Int × Int))) (np bw4 bh4 : Nat)
    (mv : Int × Int) (wm : Av1WmParams) (bx4 by4 : Nat) : Bool × Av1WmParams := Id.run do
  let mut a00 : Int := 0
  let mut a01 : Int := 0
  let mut a11 : Int := 0
  let mut bx0 : Int := 0
  let mut bx1 : Int := 0
  let mut by0 : Int := 0
  let mut by1 : Int := 0
  let rsuy : Int := Int.ofNat (2 * bh4) - 1
  let rsux : Int := Int.ofNat (2 * bw4) - 1
  let suy : Int := rsuy * 8
  let sux : Int := rsux * 8
  let duy : Int := suy + mv.1
  let dux : Int := sux + mv.2
  let isuy : Int := Int.ofNat (by4 * 4) + rsuy
  let isux : Int := Int.ofNat (bx4 * 4) + rsux
  for i in [:np] do
    let ((sxi, syi), (dxi, dyi)) := pts.getD i ((0, 0), (0, 0))
    let dx := dxi - dux
    let dy := dyi - duy
    let sx := sxi - sux
    let sy := syi - suy
    if (sx - dx).natAbs < 256 && (sy - dy).natAbs < 256 then
      a00 := a00 + av1ArithShiftRight (sx * sx) 2 + sx * 2 + 8
      a01 := a01 + av1ArithShiftRight (sx * sy) 2 + sx + sy + 4
      a11 := a11 + av1ArithShiftRight (sy * sy) 2 + sy * 2 + 8
      bx0 := bx0 + av1ArithShiftRight (sx * dx) 2 + sx + dx + 8
      bx1 := bx1 + av1ArithShiftRight (sy * dx) 2 + sy + dx + 4
      by0 := by0 + av1ArithShiftRight (sx * dy) 2 + sx + dy + 4
      by1 := by1 + av1ArithShiftRight (sy * dy) 2 + sy + dy + 8
  let det := a00 * a11 - a01 * a01
  if det == 0 then
    return (true, wm)
  let (divV, shiftNat) := av1ResolveDivisor det.natAbs
  let mut idet := av1ApplySign64 divV det
  let mut shift : Int := Int.ofNat shiftNat - 16
  if shift < 0 then
    idet := idet * Int.ofNat (1 <<< (-shift).toNat)
    shift := 0
  let shNat := shift.toNat
  let rnd : Int := if shNat > 0 then Int.ofNat ((1 <<< shNat) >>> 1) else 0
  let msDiag (px : Int) : Int :=
    let v1 := px * idet
    let v2 := av1ApplySign64 (av1ArithShiftRight (Int.ofNat v1.natAbs + rnd) shNat) v1
    av1Iclip v2 57345 73727
  let msNdiag (px : Int) : Int :=
    let v1 := px * idet
    let v2 := av1ApplySign64 (av1ArithShiftRight (Int.ofNat v1.natAbs + rnd) shNat) v1
    av1Iclip v2 (-8191) 8191
  let m2 := msDiag (a11 * bx0 - a01 * bx1)
  let m3 := msNdiag (a00 * bx1 - a01 * bx0)
  let m4 := msNdiag (a11 * by0 - a01 * by1)
  let m5 := msDiag (a00 * by1 - a01 * by0)
  let m0 := av1Iclip (mv.2 * 8192 - (isux * (m2 - 65536) + isuy * m3)) (-8388608) 8388607
  let m1 := av1Iclip (mv.1 * 8192 - (isux * m4 + isuy * (m5 - 65536))) (-8388608) 8388607
  return (false, { wm with matrix := #[m0, m1, m2, m3, m4, m5] })

def av1EmuEdge (bw bh iw ih : Nat) (x y : Int) (ref : Array Nat) (refStride : Nat) : Array Nat × Nat := Id.run do
  let mut out : Array Nat := Array.replicate (bw * bh) 0
  let refY := (av1Iclip y 0 (Int.ofNat ih - 1)).toNat
  let refX := (av1Iclip x 0 (Int.ofNat iw - 1)).toNat
  let leftExt := (av1Iclip (-x) 0 (Int.ofNat bw - 1)).toNat
  let rightExt := (av1Iclip (x + Int.ofNat bw - Int.ofNat iw) 0 (Int.ofNat bw - 1)).toNat
  let topExt := (av1Iclip (-y) 0 (Int.ofNat bh - 1)).toNat
  let bottomExt := (av1Iclip (y + Int.ofNat bh - Int.ofNat ih) 0 (Int.ofNat bh - 1)).toNat
  let centerW := bw - leftExt - rightExt
  let centerH := bh - topExt - bottomExt
  for cy in [:centerH] do
    let rBase := (refY + cy) * refStride + refX
    let dBase := (topExt + cy) * bw
    for cx in [:centerW] do
      out := out.set! (dBase + leftExt + cx) (ref.getD (rBase + cx) 0)
    if leftExt != 0 then
      let lv := out.getD (dBase + leftExt) 0
      for cx in [:leftExt] do
        out := out.set! (dBase + cx) lv
    if rightExt != 0 then
      let rv := out.getD (dBase + leftExt + centerW - 1) 0
      for cx in [:rightExt] do
        out := out.set! (dBase + leftExt + centerW + cx) rv
  let topRow := topExt * bw
  for ty in [:topExt] do
    let dBase := ty * bw
    for cx in [:bw] do
      out := out.set! (dBase + cx) (out.getD (topRow + cx) 0)
  let botSrc := (topExt + centerH - 1) * bw
  for byI in [:bottomExt] do
    let dBase := (topExt + centerH + byI) * bw
    for cx in [:bw] do
      out := out.set! (dBase + cx) (out.getD (botSrc + cx) 0)
  return (out, bw)

@[inline]
private def av1SubpelTapBase (filtGroup subpel : Nat) : Nat :=
  (filtGroup * 15 + (subpel - 1)) * 8

@[inline]
private def av1GetHFilterBase (mx w typeH : Nat) : Option Nat :=
  if mx == 0 then none
  else
    let grp := if w > 4 then typeH else 3 + (typeH &&& 1)
    some (av1SubpelTapBase grp mx)

@[inline]
private def av1GetVFilterBase (my h typeV : Nat) : Option Nat :=
  if my == 0 then none
  else
    let grp := if h > 4 then typeV else 3 + (typeV &&& 1)
    some (av1SubpelTapBase grp my)

@[inline]
private def av1Dot8Nat (src : Array Nat) (base step fBase : Nat) : Int :=
  av1McSubpelFilters.getD fBase 0 * Int.ofNat (src.getD (base - 3 * step) 0) +
  av1McSubpelFilters.getD (fBase + 1) 0 * Int.ofNat (src.getD (base - 2 * step) 0) +
  av1McSubpelFilters.getD (fBase + 2) 0 * Int.ofNat (src.getD (base - step) 0) +
  av1McSubpelFilters.getD (fBase + 3) 0 * Int.ofNat (src.getD base 0) +
  av1McSubpelFilters.getD (fBase + 4) 0 * Int.ofNat (src.getD (base + step) 0) +
  av1McSubpelFilters.getD (fBase + 5) 0 * Int.ofNat (src.getD (base + 2 * step) 0) +
  av1McSubpelFilters.getD (fBase + 6) 0 * Int.ofNat (src.getD (base + 3 * step) 0) +
  av1McSubpelFilters.getD (fBase + 7) 0 * Int.ofNat (src.getD (base + 4 * step) 0)

@[inline]
private def av1Dot8Int (src : Array Int) (base step fBase : Nat) : Int :=
  av1McSubpelFilters.getD fBase 0 * src.getD (base - 3 * step) 0 +
  av1McSubpelFilters.getD (fBase + 1) 0 * src.getD (base - 2 * step) 0 +
  av1McSubpelFilters.getD (fBase + 2) 0 * src.getD (base - step) 0 +
  av1McSubpelFilters.getD (fBase + 3) 0 * src.getD base 0 +
  av1McSubpelFilters.getD (fBase + 4) 0 * src.getD (base + step) 0 +
  av1McSubpelFilters.getD (fBase + 5) 0 * src.getD (base + 2 * step) 0 +
  av1McSubpelFilters.getD (fBase + 6) 0 * src.getD (base + 3 * step) 0 +
  av1McSubpelFilters.getD (fBase + 7) 0 * src.getD (base + 4 * step) 0

def av1McPut (dst0 : Array Nat) (dstOff dstStride : Nat)
    (src : Array Nat) (srcOff srcStride w h mx my filter2d : Nat) : Array Nat := Id.run do
  let mut dst := dst0
  let mxI := Int.ofNat mx
  let myI := Int.ofNat my
  if filter2d == av1Filter2dBilinear then
    if mx != 0 && my != 0 then
      let mut mid : Array Int := Array.replicate ((h + 1) * w) 0
      for y in [:h + 1] do
        let sb := srcOff + y * srcStride
        let mb := y * w
        for x in [:w] do
          let s0 := Int.ofNat (src.getD (sb + x) 0)
          let s1 := Int.ofNat (src.getD (sb + x + 1) 0)
          mid := mid.set! (mb + x) (16 * s0 + mxI * (s1 - s0))
      for y in [:h] do
        let db := dstOff + y * dstStride
        let mb := y * w
        for x in [:w] do
          let m0 := mid.getD (mb + x) 0
          let m1 := mid.getD (mb + w + x) 0
          let v := 16 * m0 + myI * (m1 - m0)
          dst := dst.set! (db + x) (av1IclipU8 (av1ArithShiftRight (v + 128) 8))
    else if mx != 0 then
      for y in [:h] do
        let sb := srcOff + y * srcStride
        let db := dstOff + y * dstStride
        for x in [:w] do
          let s0 := Int.ofNat (src.getD (sb + x) 0)
          let s1 := Int.ofNat (src.getD (sb + x + 1) 0)
          let px := 16 * s0 + mxI * (s1 - s0)
          dst := dst.set! (db + x) (av1IclipU8 (av1ArithShiftRight (px + 8) 4))
    else if my != 0 then
      for y in [:h] do
        let sb := srcOff + y * srcStride
        let db := dstOff + y * dstStride
        for x in [:w] do
          let s0 := Int.ofNat (src.getD (sb + x) 0)
          let s1 := Int.ofNat (src.getD (sb + srcStride + x) 0)
          let px := 16 * s0 + myI * (s1 - s0)
          dst := dst.set! (db + x) (av1IclipU8 (av1ArithShiftRight (px + 8) 4))
    else
      for y in [:h] do
        let sb := srcOff + y * srcStride
        let db := dstOff + y * dstStride
        for x in [:w] do
          dst := dst.set! (db + x) (src.getD (sb + x) 0)
    return dst
  let (typeH, typeV) := av1Filter2dHv filter2d
  match av1GetHFilterBase mx w typeH, av1GetVFilterBase my h typeV with
  | some fh, some fv =>
    let mut mid : Array Int := Array.replicate ((h + 7) * w) 0
    for y in [:h + 7] do
      let sb := srcOff + y * srcStride - 3 * srcStride
      let mb := y * w
      for x in [:w] do
        mid := mid.set! (mb + x) (av1ArithShiftRight (av1Dot8Nat src (sb + x) 1 fh + 2) 2)
    for y in [:h] do
      let db := dstOff + y * dstStride
      let mb := (y + 3) * w
      for x in [:w] do
        dst := dst.set! (db + x) (av1IclipU8 (av1ArithShiftRight (av1Dot8Int mid (mb + x) w fv + 512) 10))
  | some fh, none =>
    for y in [:h] do
      let sb := srcOff + y * srcStride
      let db := dstOff + y * dstStride
      for x in [:w] do
        dst := dst.set! (db + x) (av1IclipU8 (av1ArithShiftRight (av1Dot8Nat src (sb + x) 1 fh + 34) 6))
  | none, some fv =>
    for y in [:h] do
      let sb := srcOff + y * srcStride
      let db := dstOff + y * dstStride
      for x in [:w] do
        dst := dst.set! (db + x) (av1IclipU8 (av1ArithShiftRight (av1Dot8Nat src (sb + x) srcStride fv + 32) 6))
  | none, none =>
    for y in [:h] do
      let sb := srcOff + y * srcStride
      let db := dstOff + y * dstStride
      for x in [:w] do
        dst := dst.set! (db + x) (src.getD (sb + x) 0)
  return dst

def av1McPrep (src : Array Nat) (srcOff srcStride w h mx my filter2d : Nat) : Array Int := Id.run do
  let mut tmp : Array Int := Array.replicate (w * h) 0
  let mxI := Int.ofNat mx
  let myI := Int.ofNat my
  if filter2d == av1Filter2dBilinear then
    if mx != 0 && my != 0 then
      let mut mid : Array Int := Array.replicate ((h + 1) * w) 0
      for y in [:h + 1] do
        let sb := srcOff + y * srcStride
        let mb := y * w
        for x in [:w] do
          let s0 := Int.ofNat (src.getD (sb + x) 0)
          let s1 := Int.ofNat (src.getD (sb + x + 1) 0)
          mid := mid.set! (mb + x) (16 * s0 + mxI * (s1 - s0))
      for y in [:h] do
        let mb := y * w
        for x in [:w] do
          let m0 := mid.getD (mb + x) 0
          let m1 := mid.getD (mb + w + x) 0
          let v := 16 * m0 + myI * (m1 - m0)
          tmp := tmp.set! (mb + x) (av1ArithShiftRight (v + 8) 4)
    else if mx != 0 then
      for y in [:h] do
        let sb := srcOff + y * srcStride
        let tb := y * w
        for x in [:w] do
          let s0 := Int.ofNat (src.getD (sb + x) 0)
          let s1 := Int.ofNat (src.getD (sb + x + 1) 0)
          tmp := tmp.set! (tb + x) (16 * s0 + mxI * (s1 - s0))
    else if my != 0 then
      for y in [:h] do
        let sb := srcOff + y * srcStride
        let tb := y * w
        for x in [:w] do
          let s0 := Int.ofNat (src.getD (sb + x) 0)
          let s1 := Int.ofNat (src.getD (sb + srcStride + x) 0)
          tmp := tmp.set! (tb + x) (16 * s0 + myI * (s1 - s0))
    else
      for y in [:h] do
        let sb := srcOff + y * srcStride
        let tb := y * w
        for x in [:w] do
          tmp := tmp.set! (tb + x) (Int.ofNat (src.getD (sb + x) 0 <<< 4))
    return tmp
  let (typeH, typeV) := av1Filter2dHv filter2d
  match av1GetHFilterBase mx w typeH, av1GetVFilterBase my h typeV with
  | some fh, some fv =>
    let mut mid : Array Int := Array.replicate ((h + 7) * w) 0
    for y in [:h + 7] do
      let sb := srcOff + y * srcStride - 3 * srcStride
      let mb := y * w
      for x in [:w] do
        mid := mid.set! (mb + x) (av1ArithShiftRight (av1Dot8Nat src (sb + x) 1 fh + 2) 2)
    for y in [:h] do
      let mb := (y + 3) * w
      let tb := y * w
      for x in [:w] do
        tmp := tmp.set! (tb + x) (av1ArithShiftRight (av1Dot8Int mid (mb + x) w fv + 32) 6)
  | some fh, none =>
    for y in [:h] do
      let sb := srcOff + y * srcStride
      let tb := y * w
      for x in [:w] do
        tmp := tmp.set! (tb + x) (av1ArithShiftRight (av1Dot8Nat src (sb + x) 1 fh + 2) 2)
  | none, some fv =>
    for y in [:h] do
      let sb := srcOff + y * srcStride
      let tb := y * w
      for x in [:w] do
        tmp := tmp.set! (tb + x) (av1ArithShiftRight (av1Dot8Nat src (sb + x) srcStride fv + 2) 2)
  | none, none =>
    for y in [:h] do
      let sb := srcOff + y * srcStride
      let tb := y * w
      for x in [:w] do
        tmp := tmp.set! (tb + x) (Int.ofNat (src.getD (sb + x) 0 <<< 4))
  return tmp

private def av1McSelectWindow (bw4 bh4 bx by4 pl : Nat) (mv : Int × Int)
    (refPlane : Array Nat) (refW refH refStride : Nat)
    (isIntrabc : Bool) (bwB4 bhB4 : Nat) :
    Array Nat × Nat × Nat × Nat × Nat × Nat × Nat :=
  let ssHor : Nat := if pl > 0 then 1 else 0
  let ssVer : Nat := if pl > 0 then 1 else 0
  let hMul := 4 >>> ssHor
  let vMul := 4 >>> ssVer
  let (mvy, mvx) := mv
  let mxMask : Int := Int.ofNat (15 >>> (if ssHor != 0 then 0 else 1))
  let myMask : Int := Int.ofNat (15 >>> (if ssVer != 0 then 0 else 1))
  let qx := av1ArithShiftRight mvx (3 + ssHor)
  let qy := av1ArithShiftRight mvy (3 + ssVer)
  let mx : Nat := (mvx - qx * (mxMask + 1)).toNat
  let my : Nat := (mvy - qy * (myMask + 1)).toNat
  let dx : Int := Int.ofNat (bx * hMul) + qx
  let dy : Int := Int.ofNat (by4 * vMul) + qy
  let (w, h) :=
    if !isIntrabc then
      ((refW + ssHor) >>> ssHor, (refH + ssVer) >>> ssVer)
    else
      ((bwB4 * 4) >>> ssHor, (bhB4 * 4) >>> ssVer)
  let needX : Nat := if mx != 0 then 1 else 0
  let needY : Nat := if my != 0 then 1 else 0
  let blkW := bw4 * hMul
  let blkH := bh4 * vMul
  let (src, srcOff, sStride) :=
    if dx < Int.ofNat (needX * 3) || dy < Int.ofNat (needY * 3) ||
       dx + Int.ofNat (blkW + needX * 4) > Int.ofNat w ||
       dy + Int.ofNat (blkH + needY * 4) > Int.ofNat h then
      let (ebuf, estride) := av1EmuEdge (blkW + needX * 7) (blkH + needY * 7) w h
        (dx - Int.ofNat (needX * 3)) (dy - Int.ofNat (needY * 3)) refPlane refStride
      (ebuf, estride * needY * 3 + needX * 3, estride)
    else
      (refPlane, refStride * dy.toNat + dx.toNat, refStride)
  let mxScaled := mx <<< (if ssHor != 0 then 0 else 1)
  let myScaled := my <<< (if ssVer != 0 then 0 else 1)
  (src, srcOff, sStride, blkW, blkH, mxScaled, myScaled)

def av1McBlockPut (dst0 : Array Nat) (dstOff dstStride bw4 bh4 bx by4 pl : Nat)
    (mv : Int × Int) (refPlane : Array Nat) (refW refH refStride filter2d : Nat)
    (isIntrabc : Bool := false) (bwB4 bhB4 : Nat := 0) : Array Nat :=
  let (src, srcOff, sStride, blkW, blkH, mxS, myS) :=
    av1McSelectWindow bw4 bh4 bx by4 pl mv refPlane refW refH refStride isIntrabc bwB4 bhB4
  av1McPut dst0 dstOff dstStride src srcOff sStride blkW blkH mxS myS filter2d

def av1McBlockPrep (bw4 bh4 bx by4 pl : Nat)
    (mv : Int × Int) (refPlane : Array Nat) (refW refH refStride filter2d : Nat)
    (isIntrabc : Bool := false) (bwB4 bhB4 : Nat := 0) : Array Int :=
  let (src, srcOff, sStride, blkW, blkH, mxS, myS) :=
    av1McSelectWindow bw4 bh4 bx by4 pl mv refPlane refW refH refStride isIntrabc bwB4 bhB4
  av1McPrep src srcOff sStride blkW blkH mxS myS filter2d

private def av1Warp8x8Mid (src : Array Nat) (srcOff srcStride : Nat) (abcd : Array Int) (mx : Int) : Array Int := Id.run do
  let mut mid : Array Int := Array.replicate 120 0
  let mut curMx := mx
  let a0 := abcd.getD 0 0
  let a1 := abcd.getD 1 0
  for y in [:15] do
    let sb := srcOff + y * srcStride - 3 * srcStride
    let mb := y * 8
    let mut tmx := curMx
    for x in [:8] do
      let fIdx := ((64 : Int) + av1ArithShiftRight (tmx + 512) 10).toNat * 8
      let s :=
        av1McWarpFilter.getD fIdx 0 * Int.ofNat (src.getD (sb + x - 3) 0) +
        av1McWarpFilter.getD (fIdx + 1) 0 * Int.ofNat (src.getD (sb + x - 2) 0) +
        av1McWarpFilter.getD (fIdx + 2) 0 * Int.ofNat (src.getD (sb + x - 1) 0) +
        av1McWarpFilter.getD (fIdx + 3) 0 * Int.ofNat (src.getD (sb + x) 0) +
        av1McWarpFilter.getD (fIdx + 4) 0 * Int.ofNat (src.getD (sb + x + 1) 0) +
        av1McWarpFilter.getD (fIdx + 5) 0 * Int.ofNat (src.getD (sb + x + 2) 0) +
        av1McWarpFilter.getD (fIdx + 6) 0 * Int.ofNat (src.getD (sb + x + 3) 0) +
        av1McWarpFilter.getD (fIdx + 7) 0 * Int.ofNat (src.getD (sb + x + 4) 0)
      mid := mid.set! (mb + x) (av1ArithShiftRight (s + 4) 3)
      tmx := tmx + a0
    curMx := curMx + a1
  return mid

def av1Warp8x8Put (dst0 : Array Nat) (dstOff dstStride : Nat)
    (src : Array Nat) (srcOff srcStride : Nat) (abcd : Array Int) (mx my : Int) : Array Nat := Id.run do
  let mut dst := dst0
  let mid := av1Warp8x8Mid src srcOff srcStride abcd mx
  let a2 := abcd.getD 2 0
  let a3 := abcd.getD 3 0
  let mut curMy := my
  for y in [:8] do
    let mb := (y + 3) * 8
    let db := dstOff + y * dstStride
    let mut tmy := curMy
    for x in [:8] do
      let fIdx := ((64 : Int) + av1ArithShiftRight (tmy + 512) 10).toNat * 8
      let s :=
        av1McWarpFilter.getD fIdx 0 * mid.getD (mb + x - 24) 0 +
        av1McWarpFilter.getD (fIdx + 1) 0 * mid.getD (mb + x - 16) 0 +
        av1McWarpFilter.getD (fIdx + 2) 0 * mid.getD (mb + x - 8) 0 +
        av1McWarpFilter.getD (fIdx + 3) 0 * mid.getD (mb + x) 0 +
        av1McWarpFilter.getD (fIdx + 4) 0 * mid.getD (mb + x + 8) 0 +
        av1McWarpFilter.getD (fIdx + 5) 0 * mid.getD (mb + x + 16) 0 +
        av1McWarpFilter.getD (fIdx + 6) 0 * mid.getD (mb + x + 24) 0 +
        av1McWarpFilter.getD (fIdx + 7) 0 * mid.getD (mb + x + 32) 0
      dst := dst.set! (db + x) (av1IclipU8 (av1ArithShiftRight (s + 1024) 11))
      tmy := tmy + a2
    curMy := curMy + a3
  return dst

def av1Warp8x8Prep (tmp0 : Array Int) (tmpOff tmpStride : Nat)
    (src : Array Nat) (srcOff srcStride : Nat) (abcd : Array Int) (mx my : Int) : Array Int := Id.run do
  let mut tmp := tmp0
  let mid := av1Warp8x8Mid src srcOff srcStride abcd mx
  let a2 := abcd.getD 2 0
  let a3 := abcd.getD 3 0
  let mut curMy := my
  for y in [:8] do
    let mb := (y + 3) * 8
    let tb := tmpOff + y * tmpStride
    let mut tmy := curMy
    for x in [:8] do
      let fIdx := ((64 : Int) + av1ArithShiftRight (tmy + 512) 10).toNat * 8
      let s :=
        av1McWarpFilter.getD fIdx 0 * mid.getD (mb + x - 24) 0 +
        av1McWarpFilter.getD (fIdx + 1) 0 * mid.getD (mb + x - 16) 0 +
        av1McWarpFilter.getD (fIdx + 2) 0 * mid.getD (mb + x - 8) 0 +
        av1McWarpFilter.getD (fIdx + 3) 0 * mid.getD (mb + x) 0 +
        av1McWarpFilter.getD (fIdx + 4) 0 * mid.getD (mb + x + 8) 0 +
        av1McWarpFilter.getD (fIdx + 5) 0 * mid.getD (mb + x + 16) 0 +
        av1McWarpFilter.getD (fIdx + 6) 0 * mid.getD (mb + x + 24) 0 +
        av1McWarpFilter.getD (fIdx + 7) 0 * mid.getD (mb + x + 32) 0
      tmp := tmp.set! (tb + x) (av1ArithShiftRight (s + 64) 7)
      tmy := tmy + a2
    curMy := curMy + a3
  return tmp

def av1WarpBlockPut (dst0 : Array Nat) (dstOff dstStride bw4 bh4 bx by4 pl : Nat)
    (refPlane : Array Nat) (refW refH refStride : Nat) (wmp : Av1WmParams) : Array Nat := Id.run do
  let mut dst := dst0
  let ssHor : Nat := if pl > 0 then 1 else 0
  let ssVer : Nat := if pl > 0 then 1 else 0
  let hMul := 4 >>> ssHor
  let vMul := 4 >>> ssVer
  let blkW := bw4 * hMul
  let blkH := bh4 * vMul
  let mat := wmp.matrix
  let abcd := wmp.abcd
  let alpha := abcd.getD 0 0
  let beta := abcd.getD 1 0
  let gamma := abcd.getD 2 0
  let delta := abcd.getD 3 0
  let width := (refW + ssHor) >>> ssHor
  let height := (refH + ssVer) >>> ssVer
  let ySteps := blkH / 8
  let xSteps := blkW / 8
  for ys in [:ySteps] do
    let y := ys * 8
    let srcY : Int := Int.ofNat (by4 * 4 + ((y + 4) <<< ssVer))
    let mat3Y := mat.getD 3 0 * srcY + mat.getD 0 0
    let mat5Y := mat.getD 5 0 * srcY + mat.getD 1 0
    for xs in [:xSteps] do
      let x := xs * 8
      let srcX : Int := Int.ofNat (bx * 4 + ((x + 4) <<< ssHor))
      let mvx := av1ArithShiftRight (mat.getD 2 0 * srcX + mat3Y) ssHor
      let mvy := av1ArithShiftRight (mat.getD 4 0 * srcX + mat5Y) ssVer
      let qx := av1ArithShiftRight mvx 16
      let dx := qx - 4
      let remX := mvx - qx * 65536
      let mx := av1ArithShiftRight (remX - alpha * 4 - beta * 7) 6 * 64
      let qy := av1ArithShiftRight mvy 16
      let dy := qy - 4
      let remY := mvy - qy * 65536
      let my := av1ArithShiftRight (remY - gamma * 4 - delta * 4) 6 * 64
      let (rsrc, roff, rstride) :=
        if dx < 3 || dx + 12 > Int.ofNat width || dy < 3 || dy + 12 > Int.ofNat height then
          let (ebuf, estride) := av1EmuEdge 15 15 width height (dx - 3) (dy - 3) refPlane refStride
          (ebuf, estride * 3 + 3, estride)
        else
          (refPlane, refStride * dy.toNat + dx.toNat, refStride)
      dst := av1Warp8x8Put dst (dstOff + y * dstStride + x) dstStride rsrc roff rstride abcd mx my
  return dst

def av1WarpBlockPrep (bw4 bh4 bx by4 pl : Nat)
    (refPlane : Array Nat) (refW refH refStride : Nat) (wmp : Av1WmParams) : Array Int := Id.run do
  let ssHor : Nat := if pl > 0 then 1 else 0
  let ssVer : Nat := if pl > 0 then 1 else 0
  let hMul := 4 >>> ssHor
  let vMul := 4 >>> ssVer
  let blkW := bw4 * hMul
  let blkH := bh4 * vMul
  let mut tmp16 : Array Int := Array.replicate (blkW * blkH) 0
  let mat := wmp.matrix
  let abcd := wmp.abcd
  let alpha := abcd.getD 0 0
  let beta := abcd.getD 1 0
  let gamma := abcd.getD 2 0
  let delta := abcd.getD 3 0
  let width := (refW + ssHor) >>> ssHor
  let height := (refH + ssVer) >>> ssVer
  let ySteps := blkH / 8
  let xSteps := blkW / 8
  for ys in [:ySteps] do
    let y := ys * 8
    let srcY : Int := Int.ofNat (by4 * 4 + ((y + 4) <<< ssVer))
    let mat3Y := mat.getD 3 0 * srcY + mat.getD 0 0
    let mat5Y := mat.getD 5 0 * srcY + mat.getD 1 0
    for xs in [:xSteps] do
      let x := xs * 8
      let srcX : Int := Int.ofNat (bx * 4 + ((x + 4) <<< ssHor))
      let mvx := av1ArithShiftRight (mat.getD 2 0 * srcX + mat3Y) ssHor
      let mvy := av1ArithShiftRight (mat.getD 4 0 * srcX + mat5Y) ssVer
      let qx := av1ArithShiftRight mvx 16
      let dx := qx - 4
      let remX := mvx - qx * 65536
      let mx := av1ArithShiftRight (remX - alpha * 4 - beta * 7) 6 * 64
      let qy := av1ArithShiftRight mvy 16
      let dy := qy - 4
      let remY := mvy - qy * 65536
      let my := av1ArithShiftRight (remY - gamma * 4 - delta * 4) 6 * 64
      let (rsrc, roff, rstride) :=
        if dx < 3 || dx + 12 > Int.ofNat width || dy < 3 || dy + 12 > Int.ofNat height then
          let (ebuf, estride) := av1EmuEdge 15 15 width height (dx - 3) (dy - 3) refPlane refStride
          (ebuf, estride * 3 + 3, estride)
        else
          (refPlane, refStride * dy.toNat + dx.toNat, refStride)
      tmp16 := av1Warp8x8Prep tmp16 (y * blkW + x) blkW rsrc roff rstride abcd mx my
  return tmp16

def av1CompAvg (dst0 : Array Nat) (dstOff dstStride : Nat) (tmp1 tmp2 : Array Int) (w h : Nat) : Array Nat := Id.run do
  let mut dst := dst0
  for y in [:h] do
    let db := dstOff + y * dstStride
    let tb := y * w
    for x in [:w] do
      let v := av1ArithShiftRight (tmp1.getD (tb + x) 0 + tmp2.getD (tb + x) 0 + 16) 5
      dst := dst.set! (db + x) (av1IclipU8 v)
  return dst

def av1CompWAvg (dst0 : Array Nat) (dstOff dstStride : Nat) (tmp1 tmp2 : Array Int) (w h weight : Nat) : Array Nat := Id.run do
  let mut dst := dst0
  let w1 : Int := Int.ofNat weight
  let w2 : Int := Int.ofNat (16 - weight)
  for y in [:h] do
    let db := dstOff + y * dstStride
    let tb := y * w
    for x in [:w] do
      let v := av1ArithShiftRight (tmp1.getD (tb + x) 0 * w1 + tmp2.getD (tb + x) 0 * w2 + 128) 8
      dst := dst.set! (db + x) (av1IclipU8 v)
  return dst

def av1CompMask (dst0 : Array Nat) (dstOff dstStride : Nat) (tmp1 tmp2 : Array Int)
    (w h : Nat) (maskBuf : Array Nat) (maskOff : Nat := 0) : Array Nat := Id.run do
  let mut dst := dst0
  for y in [:h] do
    let db := dstOff + y * dstStride
    let tb := y * w
    let mb := maskOff + y * w
    for x in [:w] do
      let m : Int := Int.ofNat (maskBuf.getD (mb + x) 0)
      let v := av1ArithShiftRight (tmp1.getD (tb + x) 0 * m + tmp2.getD (tb + x) 0 * (64 - m) + 512) 10
      dst := dst.set! (db + x) (av1IclipU8 v)
  return dst

def av1CompWMask420 (dst0 : Array Nat) (dstOff dstStride : Nat) (tmp1 tmp2 : Array Int)
    (w h sign : Nat) : Array Nat × Array Nat := Id.run do
  let mut dst := dst0
  let cw := w >>> 1
  let ch := h >>> 1
  let mut segMask : Array Nat := Array.replicate (cw * ch) 0
  let xSteps := w / 2
  for y in [:h] do
    let db := dstOff + y * dstStride
    let tb := y * w
    let mrow := (y >>> 1) * cw
    let oddY := (y &&& 1) != 0
    for xs in [:xSteps] do
      let x := xs * 2
      let td0 := tmp1.getD (tb + x) 0 - tmp2.getD (tb + x) 0
      let m := Nat.min (38 + ((td0.natAbs + 8) >>> 8)) 64
      let px0 := av1ArithShiftRight (td0 * Int.ofNat m + tmp2.getD (tb + x) 0 * 64 + 512) 10
      dst := dst.set! (db + x) (av1IclipU8 px0)
      let td1 := tmp1.getD (tb + x + 1) 0 - tmp2.getD (tb + x + 1) 0
      let n := Nat.min (38 + ((td1.natAbs + 8) >>> 8)) 64
      let px1 := av1ArithShiftRight (td1 * Int.ofNat n + tmp2.getD (tb + x + 1) 0 * 64 + 512) 10
      dst := dst.set! (db + x + 1) (av1IclipU8 px1)
      let mIdx := mrow + (x >>> 1)
      if oddY then
        segMask := segMask.set! mIdx ((m + n + segMask.getD mIdx 0 + 2 - sign) >>> 2)
      else
        segMask := segMask.set! mIdx (m + n)
  return (dst, segMask)

def av1BlendPxBuf (dst0 : Array Nat) (dstOff dstStride : Nat) (tmp : Array Nat)
    (w h : Nat) (maskBuf : Array Nat) (maskOff : Nat := 0) (maskStrideIn : Nat := 0) : Array Nat := Id.run do
  let mut dst := dst0
  let maskStride := if maskStrideIn == 0 then w else maskStrideIn
  for y in [:h] do
    let db := dstOff + y * dstStride
    let tb := y * w
    let mb := maskOff + y * maskStride
    for x in [:w] do
      let m := maskBuf.getD (mb + x) 0
      let v := (dst.getD (db + x) 0 * (64 - m) + tmp.getD (tb + x) 0 * m + 32) >>> 6
      dst := dst.set! (db + x) v
  return dst

def av1BlendH (dst0 : Array Nat) (dstOff dstStride : Nat) (tmp : Array Nat) (w h : Nat) : Array Nat := Id.run do
  let mut dst := dst0
  let rows := (h * 3) >>> 2
  for y in [:rows] do
    let m := av1ObmcMasks.getD (h + y) 0
    let db := dstOff + y * dstStride
    let tb := y * w
    for x in [:w] do
      let v := (dst.getD (db + x) 0 * (64 - m) + tmp.getD (tb + x) 0 * m + 32) >>> 6
      dst := dst.set! (db + x) v
  return dst

def av1BlendV (dst0 : Array Nat) (dstOff dstStride : Nat) (tmp : Array Nat) (w h : Nat) : Array Nat := Id.run do
  let mut dst := dst0
  let cols := (w * 3) >>> 2
  for y in [:h] do
    let db := dstOff + y * dstStride
    let tb := y * w
    for x in [:cols] do
      let m := av1ObmcMasks.getD (w + x) 0
      let v := (dst.getD (db + x) 0 * (64 - m) + tmp.getD (tb + x) 0 * m + 32) >>> 6
      dst := dst.set! (db + x) v
  return dst

@[inline] def av1LrHaveLeft : Nat := 1
@[inline] def av1LrHaveRight : Nat := 2
@[inline] def av1LrHaveTop : Nat := 4
@[inline] def av1LrHaveBottom : Nat := 8
@[inline] def av1CdefHaveLeft : Nat := 1
@[inline] def av1CdefHaveRight : Nat := 2
@[inline] def av1CdefHaveTop : Nat := 4
@[inline] def av1CdefHaveBottom : Nat := 8
def av1CdefPad : Int := -32768

def av1CalcEih (sharpness : Nat) : Array Nat × Array Nat := Id.run do
  let mut e : Array Nat := Array.replicate 64 0
  let mut i : Array Nat := Array.replicate 64 0
  for level in [:64] do
    let mut limit := level
    if sharpness > 0 then
      limit := limit >>> ((sharpness + 3) >>> 2)
      if limit > 9 - sharpness then
        limit := 9 - sharpness
    if limit < 1 then
      limit := 1
    i := i.set! level limit
    e := e.set! level (2 * (level + 2) + limit)
  return (e, i)

private def av1LfClip63 (v : Int) : Nat :=
  if v < 0 then 0 else if v > 63 then 63 else v.toNat

def av1CalcLfValues (hdr : Av1FrameHdr) (lfDelta : Array Int) : Array Nat := Id.run do
  let lf := hdr.loopfilter
  let seg := hdr.segmentation
  let nSeg := if seg.enabled then 8 else 1
  let mut out : Array Nat := Array.replicate (8 * 4 * 8 * 2) 0
  if lf.levelY.getD 0 0 == 0 && lf.levelY.getD 1 0 == 0 then
    return out
  let mr := lf.modeRefDeltaEnabled
  let multi := hdr.delta.lfMulti
  let baseOf (baseLvl : Nat) (dlt segD : Int) : Nat :=
    av1LfClip63 (Int.ofNat (av1LfClip63 (Int.ofNat baseLvl + dlt)) + segD)
  let fill (dst0 : Array Nat) (baseOff base : Nat) : Array Nat := Id.run do
    let mut dst := dst0
    if !mr then
      for r in [:8] do
        dst := dst.set! (baseOff + r * 2) base
        dst := dst.set! (baseOff + r * 2 + 1) base
      return dst
    let sh : Nat := if base >= 32 then 1 else 0
    let v0 := Int.ofNat base + (lf.refDelta.getD 0 0 <<< sh)
    let c0 := av1LfClip63 v0
    dst := dst.set! (baseOff + 0) c0
    dst := dst.set! (baseOff + 1) c0
    for r in [1:8] do
      for m in [:2] do
        let v := Int.ofNat base + ((lf.modeDelta.getD m 0 + lf.refDelta.getD r 0) <<< sh)
        dst := dst.set! (baseOff + r * 2 + m) (av1LfClip63 v)
    return dst
  for s in [:nSeg] do
    let sd := if seg.enabled then seg.d.getD s {} else {}
    let segOn := seg.enabled
    let b0 := baseOf (lf.levelY.getD 0 0) (lfDelta.getD 0 0) (if segOn then sd.deltaLfYV else 0)
    out := fill out (s * 64 + 0 * 16) b0
    let d1 := if multi then lfDelta.getD 1 0 else lfDelta.getD 0 0
    let b1 := baseOf (lf.levelY.getD 1 0) d1 (if segOn then sd.deltaLfYH else 0)
    out := fill out (s * 64 + 1 * 16) b1
    let du := if multi then lfDelta.getD 2 0 else lfDelta.getD 0 0
    let dv := if multi then lfDelta.getD 3 0 else lfDelta.getD 0 0
    if lf.levelU != 0 then
      out := fill out (s * 64 + 2 * 16) (baseOf lf.levelU du (if segOn then sd.deltaLfU else 0))
    if lf.levelV != 0 then
      out := fill out (s * 64 + 3 * 16) (baseOf lf.levelV dv (if segOn then sd.deltaLfV else 0))
  return out

@[inline] def av1LfAt (lvl : Array Nat) (seg pl refIdx mode : Nat) : Nat :=
  lvl.getD (seg * 64 + pl * 16 + refIdx * 2 + mode) 0

structure Av1LfMask where
  filterY : Array Nat := Array.replicate (2 * 32 * 3 * 2) 0
  filterUv : Array Nat := Array.replicate (2 * 32 * 2 * 2) 0
  cdefIdx : Array Int := #[-1, -1, -1, -1]
  noskip : Array Nat := Array.replicate (16 * 2) 0
  deriving Inhabited

@[inline] def av1LfYAt (m : Array Nat) (edge pos lvl sidx : Nat) : Nat :=
  m.getD (edge * 192 + pos * 6 + lvl * 2 + sidx) 0

@[inline] def av1LfYOr (m : Array Nat) (edge pos lvl sidx smask : Nat) : Array Nat :=
  let i := edge * 192 + pos * 6 + lvl * 2 + sidx
  m.set! i (m.getD i 0 ||| smask)

@[inline] def av1LfUvAt (m : Array Nat) (edge pos lvl sidx : Nat) : Nat :=
  m.getD (edge * 128 + pos * 4 + lvl * 2 + sidx) 0

@[inline] def av1LfUvOr (m : Array Nat) (edge pos lvl sidx smask : Nat) : Array Nat :=
  let i := edge * 128 + pos * 4 + lvl * 2 + sidx
  m.set! i (m.getD i 0 ||| smask)

def av1MaskEdgesIntra (masks0 : Array Nat) (by4 bx4 w4 h4 tx : Nat) (a l : Array Nat) : Array Nat × Array Nat × Array Nat := Id.run do
  let (w4t, h4t, lw, lh, _) := av1TxDim tx
  let twc := Nat.min 2 lw
  let thc := Nat.min 2 lh
  let mut masks := masks0
  let mut mask := 1 <<< by4
  for y in [:h4] do
    let sidx := if mask >= 0x10000 then 1 else 0
    masks := av1LfYOr masks 0 bx4 (Nat.min twc (l.getD y 0)) sidx (mask >>> (sidx <<< 4))
    mask := mask <<< 1
  mask := 1 <<< bx4
  for x in [:w4] do
    let sidx := if mask >= 0x10000 then 1 else 0
    masks := av1LfYOr masks 1 by4 (Nat.min thc (a.getD x 0)) sidx (mask >>> (sidx <<< 4))
    mask := mask <<< 1
  let t1 := 1 <<< by4
  let inner := ((t1 <<< h4) - t1) &&& 0xFFFFFFFF
  let inner1 := inner &&& 0xFFFF
  let inner2 := inner >>> 16
  let mut x := w4t
  while x < w4 do
    if inner1 != 0 then
      masks := av1LfYOr masks 0 (bx4 + x) twc 0 inner1
    if inner2 != 0 then
      masks := av1LfYOr masks 0 (bx4 + x) twc 1 inner2
    x := x + w4t
  let t2 := 1 <<< bx4
  let innerB := ((t2 <<< w4) - t2) &&& 0xFFFFFFFF
  let innerB1 := innerB &&& 0xFFFF
  let innerB2 := innerB >>> 16
  let mut y := h4t
  while y < h4 do
    if innerB1 != 0 then
      masks := av1LfYOr masks 1 (by4 + y) thc 0 innerB1
    if innerB2 != 0 then
      masks := av1LfYOr masks 1 (by4 + y) thc 1 innerB2
    y := y + h4t
  let mut aOut := a
  let mut lOut := l
  for xi in [:w4] do
    aOut := aOut.set! xi thc
  for yi in [:h4] do
    lOut := lOut.set! yi twc
  return (masks, aOut, lOut)

def av1MaskEdgesChroma (masks0 : Array Nat) (by4 bx4 w4 h4 : Nat) (skip : Bool) (tx : Nat) (a l : Array Nat) : Array Nat × Array Nat × Array Nat := Id.run do
  let (w4t, h4t, lw, lh, _) := av1TxDim tx
  let twc := if lw != 0 then 1 else 0
  let thc := if lh != 0 then 1 else 0
  let mut masks := masks0
  let mut mask := 1 <<< by4
  for y in [:h4] do
    let sidx := if mask >= 256 then 1 else 0
    masks := av1LfUvOr masks 0 bx4 (Nat.min twc (l.getD y 0)) sidx (mask >>> (sidx <<< 3))
    mask := mask <<< 1
  mask := 1 <<< bx4
  for x in [:w4] do
    let sidx := if mask >= 256 then 1 else 0
    masks := av1LfUvOr masks 1 by4 (Nat.min thc (a.getD x 0)) sidx (mask >>> (sidx <<< 3))
    mask := mask <<< 1
  if !skip then
    let t1 := 1 <<< by4
    let inner := ((t1 <<< h4) - t1) &&& 0xFFFFFFFF
    let inner1 := inner &&& 255
    let inner2 := inner >>> 8
    let mut x := w4t
    while x < w4 do
      if inner1 != 0 then
        masks := av1LfUvOr masks 0 (bx4 + x) twc 0 inner1
      if inner2 != 0 then
        masks := av1LfUvOr masks 0 (bx4 + x) twc 1 inner2
      x := x + w4t
    let t2 := 1 <<< bx4
    let innerB := ((t2 <<< w4) - t2) &&& 0xFFFFFFFF
    let innerB1 := innerB &&& 255
    let innerB2 := innerB >>> 8
    let mut y := h4t
    while y < h4 do
      if innerB1 != 0 then
        masks := av1LfUvOr masks 1 (by4 + y) thc 0 innerB1
      if innerB2 != 0 then
        masks := av1LfUvOr masks 1 (by4 + y) thc 1 innerB2
      y := y + h4t
  let mut aOut := a
  let mut lOut := l
  for xi in [:w4] do
    aOut := aOut.set! xi thc
  for yi in [:h4] do
    lOut := lOut.set! yi twc
  return (masks, aOut, lOut)

private partial def av1DecompTx (txa0 : Array Nat) (ox oy tx depth yOff xOff : Nat) (txMasks : Array Nat) : Array Nat :=
  let (w4t, h4t, lw, lh, sub) := av1TxDim tx
  let isSplit := if tx == 0 || depth > 1 then 0 else (txMasks.getD depth 0 >>> (yOff * 4 + xOff)) &&& 1
  if isSplit != 0 then
    let htw := w4t >>> 1
    let hth := h4t >>> 1
    let t1 := av1DecompTx txa0 ox oy sub (depth + 1) (yOff * 2) (xOff * 2) txMasks
    let t2 := if w4t >= h4t then av1DecompTx t1 (ox + htw) oy sub (depth + 1) (yOff * 2) (xOff * 2 + 1) txMasks else t1
    let t3 := if h4t >= w4t then av1DecompTx t2 ox (oy + hth) sub (depth + 1) (yOff * 2 + 1) (xOff * 2) txMasks else t2
    if h4t >= w4t && w4t >= h4t then av1DecompTx t3 (ox + htw) (oy + hth) sub (depth + 1) (yOff * 2 + 1) (xOff * 2 + 1) txMasks else t3
  else Id.run do
    let mut txa := txa0
    let clw := Nat.min 2 lw
    let clh := Nat.min 2 lh
    for y in [:h4t] do
      for x in [:w4t] do
        txa := txa.set! (0 * 2 * 1024 + 0 * 1024 + (oy + y) * 32 + (ox + x)) clw
        txa := txa.set! (1 * 2 * 1024 + 0 * 1024 + (oy + y) * 32 + (ox + x)) clh
      txa := txa.set! (0 * 2 * 1024 + 1 * 1024 + (oy + y) * 32 + ox) w4t
    for x in [:w4t] do
      txa := txa.set! (1 * 2 * 1024 + 1 * 1024 + oy * 32 + (ox + x)) h4t
    return txa

@[inline] private def av1TxaAt (txa : Array Nat) (d k y x : Nat) : Nat :=
  txa.getD (d * 2 * 1024 + k * 1024 + y * 32 + x) 0

def av1MaskEdgesInter (masks0 : Array Nat) (by4 bx4 w4 h4 : Nat) (skip : Bool) (maxTx : Nat) (txMasks a l : Array Nat) : Array Nat × Array Nat × Array Nat := Id.run do
  let (w4t, h4t, _, _, _) := av1TxDim maxTx
  let mut txa : Array Nat := Array.replicate (2 * 2 * 32 * 32) 0
  let mut y := 0
  let mut yOff := 0
  while y < h4 do
    let mut x := 0
    let mut xOff := 0
    while x < w4 do
      txa := av1DecompTx txa x y maxTx 0 yOff xOff txMasks
      x := x + w4t
      xOff := xOff + 1
    y := y + h4t
    yOff := yOff + 1
  let mut masks := masks0
  let mut mask := 1 <<< by4
  for yi in [:h4] do
    let sidx := if mask >= 0x10000 then 1 else 0
    masks := av1LfYOr masks 0 bx4 (Nat.min (av1TxaAt txa 0 0 yi 0) (l.getD yi 0)) sidx (mask >>> (sidx <<< 4))
    mask := mask <<< 1
  mask := 1 <<< bx4
  for xi in [:w4] do
    let sidx := if mask >= 0x10000 then 1 else 0
    masks := av1LfYOr masks 1 by4 (Nat.min (av1TxaAt txa 1 0 0 xi) (a.getD xi 0)) sidx (mask >>> (sidx <<< 4))
    mask := mask <<< 1
  if !skip then
    mask := 1 <<< by4
    for yi in [:h4] do
      let sidx := if mask >= 0x10000 then 1 else 0
      let smask := mask >>> (sidx <<< 4)
      let mut ltx := av1TxaAt txa 0 0 yi 0
      let mut step := av1TxaAt txa 0 1 yi 0
      let mut x := step
      while x < w4 do
        let rtx := av1TxaAt txa 0 0 yi x
        masks := av1LfYOr masks 0 (bx4 + x) (Nat.min rtx ltx) sidx smask
        ltx := rtx
        step := av1TxaAt txa 0 1 yi x
        x := x + step
      mask := mask <<< 1
    mask := 1 <<< bx4
    for xi in [:w4] do
      let sidx := if mask >= 0x10000 then 1 else 0
      let smask := mask >>> (sidx <<< 4)
      let mut ttx := av1TxaAt txa 1 0 0 xi
      let mut step := av1TxaAt txa 1 1 0 xi
      let mut yy := step
      while yy < h4 do
        let btx := av1TxaAt txa 1 0 yy xi
        masks := av1LfYOr masks 1 (by4 + yy) (Nat.min ttx btx) sidx smask
        ttx := btx
        step := av1TxaAt txa 1 1 yy xi
        yy := yy + step
      mask := mask <<< 1
  let mut aOut := a
  let mut lOut := l
  for yi in [:h4] do
    lOut := lOut.set! yi (av1TxaAt txa 0 0 yi (w4 - 1))
  for xi in [:w4] do
    aOut := aOut.set! xi (av1TxaAt txa 1 0 (h4 - 1) xi)
  return (masks, aOut, lOut)

@[inline] private def av1PfPx (plane : Array Nat) (stride : Nat) (x y : Int) : Int :=
  Int.ofNat (plane.getD (y.toNat * stride + x.toNat) 0)

@[inline] private def av1PfSet (plane : Array Nat) (stride : Nat) (x y v : Int) : Array Nat :=
  plane.set! (y.toNat * stride + x.toNat) (av1IclipU8 v)

def av1LoopFilterEdge (dst0 : Array Nat) (pStride x0 y0 dx dy eLim iLim hLim wd : Nat) : Array Nat := Id.run do
  let mut dst := dst0
  let dxI := Int.ofNat dx
  let dyI := Int.ofNat dy
  let eI := Int.ofNat eLim
  let iI := Int.ofNat iLim
  let hI := Int.ofNat hLim
  for step in [:4] do
    let stepI := Int.ofNat step
    let px := Int.ofNat x0 + stepI * (1 - dxI)
    let py := Int.ofNat y0 + stepI * (1 - dyI)
    let atPx (k : Int) : Int := av1PfPx dst pStride (px + k * dxI) (py + k * dyI)
    let p1 := atPx (-2)
    let p0 := atPx (-1)
    let q0 := atPx 0
    let q1 := atPx 1
    let mut fm := Int.ofNat (p1 - p0).natAbs <= iI && Int.ofNat (q1 - q0).natAbs <= iI &&
      Int.ofNat (p0 - q0).natAbs * 2 + Int.ofNat ((p1 - q1).natAbs >>> 1) <= eI
    let mut p2 : Int := 0
    let mut q2 : Int := 0
    let mut p3 : Int := 0
    let mut q3 : Int := 0
    if wd > 4 then
      p2 := atPx (-3)
      q2 := atPx 2
      fm := fm && Int.ofNat (p2 - p1).natAbs <= iI && Int.ofNat (q2 - q1).natAbs <= iI
      if wd > 6 then
        p3 := atPx (-4)
        q3 := atPx 3
        fm := fm && Int.ofNat (p3 - p2).natAbs <= iI && Int.ofNat (q3 - q2).natAbs <= iI
    if fm then
      let mut flat8out := false
      let mut flat8in := false
      let mut p6 : Int := 0; let mut p5 : Int := 0; let mut p4 : Int := 0
      let mut q4 : Int := 0; let mut q5 : Int := 0; let mut q6 : Int := 0
      if wd >= 16 then
        p6 := atPx (-7); p5 := atPx (-6); p4 := atPx (-5)
        q4 := atPx 4; q5 := atPx 5; q6 := atPx 6
        flat8out := (p6 - p0).natAbs <= 1 && (p5 - p0).natAbs <= 1 && (p4 - p0).natAbs <= 1 &&
                    (q4 - q0).natAbs <= 1 && (q5 - q0).natAbs <= 1 && (q6 - q0).natAbs <= 1
      if wd >= 6 then
        flat8in := (p2 - p0).natAbs <= 1 && (p1 - p0).natAbs <= 1 && (q1 - q0).natAbs <= 1 && (q2 - q0).natAbs <= 1
      if wd >= 8 then
        flat8in := flat8in && (p3 - p0).natAbs <= 1 && (q3 - q0).natAbs <= 1
      if wd >= 16 && flat8out && flat8in then
        let vals : Array Int := #[
          av1ArithShiftRight (p6 * 7 + p5 * 2 + p4 * 2 + p3 + p2 + p1 + p0 + q0 + 8) 4,
          av1ArithShiftRight (p6 * 5 + p5 * 2 + p4 * 2 + p3 * 2 + p2 + p1 + p0 + q0 + q1 + 8) 4,
          av1ArithShiftRight (p6 * 4 + p5 + p4 * 2 + p3 * 2 + p2 * 2 + p1 + p0 + q0 + q1 + q2 + 8) 4,
          av1ArithShiftRight (p6 * 3 + p5 + p4 + p3 * 2 + p2 * 2 + p1 * 2 + p0 + q0 + q1 + q2 + q3 + 8) 4,
          av1ArithShiftRight (p6 * 2 + p5 + p4 + p3 + p2 * 2 + p1 * 2 + p0 * 2 + q0 + q1 + q2 + q3 + q4 + 8) 4,
          av1ArithShiftRight (p6 + p5 + p4 + p3 + p2 + p1 * 2 + p0 * 2 + q0 * 2 + q1 + q2 + q3 + q4 + q5 + 8) 4,
          av1ArithShiftRight (p5 + p4 + p3 + p2 + p1 + p0 * 2 + q0 * 2 + q1 * 2 + q2 + q3 + q4 + q5 + q6 + 8) 4,
          av1ArithShiftRight (p4 + p3 + p2 + p1 + p0 + q0 * 2 + q1 * 2 + q2 * 2 + q3 + q4 + q5 + q6 * 2 + 8) 4,
          av1ArithShiftRight (p3 + p2 + p1 + p0 + q0 + q1 * 2 + q2 * 2 + q3 * 2 + q4 + q5 + q6 * 3 + 8) 4,
          av1ArithShiftRight (p2 + p1 + p0 + q0 + q1 + q2 * 2 + q3 * 2 + q4 * 2 + q5 + q6 * 4 + 8) 4,
          av1ArithShiftRight (p1 + p0 + q0 + q1 + q2 + q3 * 2 + q4 * 2 + q5 * 2 + q6 * 5 + 8) 4,
          av1ArithShiftRight (p0 + q0 + q1 + q2 + q3 + q4 * 2 + q5 * 2 + q6 * 7 + 8) 4
        ]
        for k in [:12] do
          let kOff := Int.ofNat k - 6
          dst := av1PfSet dst pStride (px + kOff * dxI) (py + kOff * dyI) (vals.getD k 0)
      else if wd >= 8 && flat8in then
        let vals : Array Int := #[
          av1ArithShiftRight (p3 * 3 + 2 * p2 + p1 + p0 + q0 + 4) 3,
          av1ArithShiftRight (p3 * 2 + p2 + 2 * p1 + p0 + q0 + q1 + 4) 3,
          av1ArithShiftRight (p3 + p2 + p1 + 2 * p0 + q0 + q1 + q2 + 4) 3,
          av1ArithShiftRight (p2 + p1 + p0 + 2 * q0 + q1 + q2 + q3 + 4) 3,
          av1ArithShiftRight (p1 + p0 + q0 + 2 * q1 + q2 + q3 * 2 + 4) 3,
          av1ArithShiftRight (p0 + q0 + q1 + 2 * q2 + q3 * 3 + 4) 3
        ]
        for k in [:6] do
          let kOff := Int.ofNat k - 3
          dst := av1PfSet dst pStride (px + kOff * dxI) (py + kOff * dyI) (vals.getD k 0)
      else if wd == 6 && flat8in then
        let vals : Array Int := #[
          av1ArithShiftRight (p2 * 3 + 2 * p1 + 2 * p0 + q0 + 4) 3,
          av1ArithShiftRight (p2 + 2 * p1 + 2 * p0 + 2 * q0 + q1 + 4) 3,
          av1ArithShiftRight (p1 + 2 * p0 + 2 * q0 + 2 * q1 + q2 + 4) 3,
          av1ArithShiftRight (p0 + 2 * q0 + 2 * q1 + q2 * 3 + 4) 3
        ]
        for k in [:4] do
          let kOff := Int.ofNat k - 2
          dst := av1PfSet dst pStride (px + kOff * dxI) (py + kOff * dyI) (vals.getD k 0)
      else
        let hev := Int.ofNat (p1 - p0).natAbs > hI || Int.ofNat (q1 - q0).natAbs > hI
        let clipd (v : Int) : Int := if v < -128 then -128 else if v > 127 then 127 else v
        let min127 (v : Int) : Int := if v > 127 then 127 else v
        if hev then
          let f := clipd (3 * (q0 - p0) + clipd (p1 - q1))
          let f1 := av1ArithShiftRight (min127 (f + 4)) 3
          let f2 := av1ArithShiftRight (min127 (f + 3)) 3
          dst := av1PfSet dst pStride (px - dxI) (py - dyI) (p0 + f2)
          dst := av1PfSet dst pStride px py (q0 - f1)
        else
          let f := clipd (3 * (q0 - p0))
          let f1 := av1ArithShiftRight (min127 (f + 4)) 3
          let f2 := av1ArithShiftRight (min127 (f + 3)) 3
          dst := av1PfSet dst pStride (px - dxI) (py - dyI) (p0 + f2)
          dst := av1PfSet dst pStride px py (q0 - f1)
          let fOuter := av1ArithShiftRight (f1 + 1) 1
          dst := av1PfSet dst pStride (px - 2 * dxI) (py - 2 * dyI) (p1 + fOuter)
          dst := av1PfSet dst pStride (px + dxI) (py + dyI) (q1 - fOuter)
  return dst

def av1FilterSbColsY (plane0 : Array Nat) (pStride xPx yPx : Nat) (levels : Array Nat)
    (b4Stride ly0 lx0 : Nat) (masks : Array Nat) (haveLeft : Bool)
    (w4 starty4 endy4 : Nat) (eLut iLut : Array Nat) : Array Nat := Id.run do
  let mut plane := plane0
  let maxY := (1 <<< (endy4 - starty4)) - 1
  for x in [:w4] do
    if haveLeft || x != 0 then
      let hm0 := if starty4 == 0 then av1LfYAt masks 0 x 0 0 ||| (if endy4 > 16 then av1LfYAt masks 0 x 0 1 <<< 16 else 0) else av1LfYAt masks 0 x 0 1
      let hm1 := if starty4 == 0 then av1LfYAt masks 0 x 1 0 ||| (if endy4 > 16 then av1LfYAt masks 0 x 1 1 <<< 16 else 0) else av1LfYAt masks 0 x 1 1
      let hm2 := if starty4 == 0 then av1LfYAt masks 0 x 2 0 ||| (if endy4 > 16 then av1LfYAt masks 0 x 2 1 <<< 16 else 0) else av1LfYAt masks 0 x 2 1
      let h0 := hm0 &&& maxY
      let h1 := hm1 &&& maxY
      let h2 := hm2 &&& maxY
      let vm := h0 ||| h1 ||| h2
      let mut bit := 1
      let mut yy := 0
      while vm >= bit do
        if (vm &&& bit) != 0 then
          let ry := ly0 + starty4 + yy
          let rx := lx0 + x
          let lCur := levels.getD ((ry * b4Stride + rx) * 2) 0
          let lvl := if lCur != 0 then lCur else levels.getD ((ry * b4Stride + rx - 1) * 2) 0
          if lvl != 0 then
            let idx := if (h2 &&& bit) != 0 then 2 else if (h1 &&& bit) != 0 then 1 else 0
            plane := av1LoopFilterEdge plane pStride (xPx + x * 4) (yPx + (starty4 + yy) * 4) 1 0
              (eLut.getD lvl 0) (iLut.getD lvl 0) (lvl >>> 4) (4 <<< idx)
        bit := bit <<< 1
        yy := yy + 1
  return plane

def av1FilterSbRowsY (plane0 : Array Nat) (pStride xPx yPx : Nat) (levels : Array Nat)
    (b4Stride ly0 lx0 : Nat) (masks : Array Nat) (haveTop : Bool)
    (w4 starty4 endy4 : Nat) (eLut iLut : Array Nat) : Array Nat := Id.run do
  let mut plane := plane0
  for y in [starty4:endy4] do
    if haveTop || y != 0 then
      let v0 := av1LfYAt masks 1 y 0 0 ||| (av1LfYAt masks 1 y 0 1 <<< 16)
      let v1 := av1LfYAt masks 1 y 1 0 ||| (av1LfYAt masks 1 y 1 1 <<< 16)
      let v2 := av1LfYAt masks 1 y 2 0 ||| (av1LfYAt masks 1 y 2 1 <<< 16)
      let vm := v0 ||| v1 ||| v2
      let mut bit := 1
      let mut xx := 0
      while vm >= bit && xx < w4 do
        if (vm &&& bit) != 0 then
          let ry := ly0 + y
          let rx := lx0 + xx
          let lCur := levels.getD ((ry * b4Stride + rx) * 2 + 1) 0
          let lvl := if lCur != 0 then lCur else levels.getD (((ry - 1) * b4Stride + rx) * 2 + 1) 0
          if lvl != 0 then
            let idx := if (v2 &&& bit) != 0 then 2 else if (v1 &&& bit) != 0 then 1 else 0
            plane := av1LoopFilterEdge plane pStride (xPx + xx * 4) (yPx + y * 4) 0 1
              (eLut.getD lvl 0) (iLut.getD lvl 0) (lvl >>> 4) (4 <<< idx)
        bit := bit <<< 1
        xx := xx + 1
  return plane

def av1FilterSbColsUv (u0 v0 : Array Nat) (uvStride xPx yPx : Nat) (levels : Array Nat)
    (b4Stride ly0 lx0 : Nat) (masks : Array Nat) (haveLeft : Bool)
    (w4 starty4 endy4 : Nat) (eLut iLut : Array Nat) : Array Nat × Array Nat := Id.run do
  let mut u := u0
  let mut v := v0
  let maxY := (1 <<< (endy4 - starty4)) - 1
  for x in [:w4] do
    if haveLeft || x != 0 then
      let hm0 := if starty4 == 0 then av1LfUvAt masks 0 x 0 0 ||| (if endy4 > 8 then av1LfUvAt masks 0 x 0 1 <<< 8 else 0) else av1LfUvAt masks 0 x 0 1
      let hm1 := if starty4 == 0 then av1LfUvAt masks 0 x 1 0 ||| (if endy4 > 8 then av1LfUvAt masks 0 x 1 1 <<< 8 else 0) else av1LfUvAt masks 0 x 1 1
      let h0 := hm0 &&& maxY
      let h1 := hm1 &&& maxY
      let vm := h0 ||| h1
      let mut bit := 1
      let mut yy := 0
      while vm >= bit do
        if (vm &&& bit) != 0 then
          let ry := ly0 + starty4 + yy
          let rx := lx0 + x
          let cBase := (ry * b4Stride + rx) * 2
          let pBase := (ry * b4Stride + rx - 1) * 2
          let lu := if levels.getD cBase 0 != 0 then levels.getD cBase 0 else levels.getD pBase 0
          let lv := if levels.getD (cBase + 1) 0 != 0 then levels.getD (cBase + 1) 0 else levels.getD (pBase + 1) 0
          let idx := if (h1 &&& bit) != 0 then 1 else 0
          if lu != 0 then
            u := av1LoopFilterEdge u uvStride (xPx + x * 4) (yPx + (starty4 + yy) * 4) 1 0
              (eLut.getD lu 0) (iLut.getD lu 0) (lu >>> 4) (4 + 2 * idx)
          if lv != 0 then
            v := av1LoopFilterEdge v uvStride (xPx + x * 4) (yPx + (starty4 + yy) * 4) 1 0
              (eLut.getD lv 0) (iLut.getD lv 0) (lv >>> 4) (4 + 2 * idx)
        bit := bit <<< 1
        yy := yy + 1
  return (u, v)

def av1FilterSbRowsUv (u0 v0 : Array Nat) (uvStride xPx yPx : Nat) (levels : Array Nat)
    (b4Stride ly0 lx0 : Nat) (masks : Array Nat) (haveTop : Bool)
    (w4 starty4 endy4 : Nat) (eLut iLut : Array Nat) : Array Nat × Array Nat := Id.run do
  let mut u := u0
  let mut v := v0
  for y in [starty4:endy4] do
    if haveTop || y != 0 then
      let v0m := av1LfUvAt masks 1 y 0 0 ||| (av1LfUvAt masks 1 y 0 1 <<< 8)
      let v1m := av1LfUvAt masks 1 y 1 0 ||| (av1LfUvAt masks 1 y 1 1 <<< 8)
      let vm := v0m ||| v1m
      let mut bit := 1
      let mut xx := 0
      while vm >= bit && xx < w4 do
        if (vm &&& bit) != 0 then
          let ry := ly0 + y
          let rx := lx0 + xx
          let cBase := (ry * b4Stride + rx) * 2
          let pBase := ((ry - 1) * b4Stride + rx) * 2
          let lu := if levels.getD cBase 0 != 0 then levels.getD cBase 0 else levels.getD pBase 0
          let lv := if levels.getD (cBase + 1) 0 != 0 then levels.getD (cBase + 1) 0 else levels.getD (pBase + 1) 0
          let idx := if (v1m &&& bit) != 0 then 1 else 0
          if lu != 0 then
            u := av1LoopFilterEdge u uvStride (xPx + xx * 4) (yPx + y * 4) 0 1
              (eLut.getD lu 0) (iLut.getD lu 0) (lu >>> 4) (4 + 2 * idx)
          if lv != 0 then
            v := av1LoopFilterEdge v uvStride (xPx + xx * 4) (yPx + y * 4) 0 1
              (eLut.getD lv 0) (iLut.getD lv 0) (lv >>> 4) (4 + 2 * idx)
        bit := bit <<< 1
        xx := xx + 1
  return (u, v)

private def av1CdefUmin (a b : Int) : Int :=
  let toU32 (x : Int) : Nat :=
    if x >= 0 then x.toNat % 0x100000000
    else ((x % 0x100000000 + 0x100000000) % 0x100000000).toNat
  if toU32 a < toU32 b then a else b

def av1CdefFindDir (plane : Array Nat) (pStride x0 y0 : Nat) : Nat × Nat := Id.run do
  let mut hv0 : Array Int := Array.replicate 8 0
  let mut hv1 : Array Int := Array.replicate 8 0
  let mut diag0 : Array Int := Array.replicate 15 0
  let mut diag1 : Array Int := Array.replicate 15 0
  let mut alt : Array Int := Array.replicate (4 * 11) 0
  for y in [:8] do
    let rowBase := (y0 + y) * pStride + x0
    for x in [:8] do
      let px : Int := Int.ofNat (plane.getD (rowBase + x) 0) - 128
      diag0 := diag0.set! (y + x) (diag0.getD (y + x) 0 + px)
      let a0 := 0 * 11 + y + (x >>> 1)
      alt := alt.set! a0 (alt.getD a0 0 + px)
      hv0 := hv0.set! y (hv0.getD y 0 + px)
      let a1 := 1 * 11 + 3 + y - (x >>> 1)
      alt := alt.set! a1 (alt.getD a1 0 + px)
      diag1 := diag1.set! (7 + y - x) (diag1.getD (7 + y - x) 0 + px)
      let a2 := 2 * 11 + 3 - (y >>> 1) + x
      alt := alt.set! a2 (alt.getD a2 0 + px)
      hv1 := hv1.set! x (hv1.getD x 0 + px)
      let a3 := 3 * 11 + (y >>> 1) + x
      alt := alt.set! a3 (alt.getD a3 0 + px)
  let mut cost : Array Int := Array.replicate 8 0
  let mut c2 : Int := 0
  let mut c6 : Int := 0
  for n in [:8] do
    c2 := c2 + hv0.getD n 0 * hv0.getD n 0
    c6 := c6 + hv1.getD n 0 * hv1.getD n 0
  cost := cost.set! 2 (c2 * 105)
  cost := cost.set! 6 (c6 * 105)
  let divTable : Array Int := #[840, 420, 280, 210, 168, 140, 120]
  let mut c0 : Int := diag0.getD 7 0 * diag0.getD 7 0 * 105
  let mut c4 : Int := diag1.getD 7 0 * diag1.getD 7 0 * 105
  for n in [:7] do
    let d := divTable.getD n 0
    c0 := c0 + (diag0.getD n 0 * diag0.getD n 0 + diag0.getD (14 - n) 0 * diag0.getD (14 - n) 0) * d
    c4 := c4 + (diag1.getD n 0 * diag1.getD n 0 + diag1.getD (14 - n) 0 * diag1.getD (14 - n) 0) * d
  cost := cost.set! 0 c0
  cost := cost.set! 4 c4
  for n in [:4] do
    let mut c : Int := 0
    for m in [:5] do
      let v := alt.getD (n * 11 + 3 + m) 0
      c := c + v * v
    c := c * 105
    for m in [:3] do
      let d := divTable.getD (2 * m + 1) 0
      let vL := alt.getD (n * 11 + m) 0
      let vR := alt.getD (n * 11 + 10 - m) 0
      c := c + (vL * vL + vR * vR) * d
    cost := cost.set! (n * 2 + 1) c
  let mut best : Nat := 0
  for n in [1:8] do
    if cost.getD n 0 > cost.getD best 0 then
      best := n
  let var := (av1ArithShiftRight (cost.getD best 0 - cost.getD (best ^^^ 4) 0) 10).toNat
  return (best, var)

def av1CdefAdjustStrength (strength var : Nat) : Nat :=
  if var == 0 then 0
  else
    let v6 := var >>> 6
    let i := if v6 != 0 then Nat.min (av1Ulog2 v6) 12 else 0
    (strength * (4 + i) + 8) >>> 4

def av1CdefConstrain (diff : Int) (threshold shift : Nat) : Int :=
  let ad := diff.natAbs
  let shifted := ad >>> shift
  let rem := if threshold > shifted then threshold - shifted else 0
  let v := Int.ofNat (Nat.min ad rem)
  if diff < 0 then -v else if diff > 0 then v else 0

def av1CdefFilter (plane0 : Array Nat) (pStride x0 y0 : Nat)
    (left : Array Nat) (top : Array Nat) (topStride topOff : Nat)
    (botOpt : Option (Array Nat × Nat × Nat))
    (pri sec direction damping w h edges : Nat) : Array Nat := Id.run do
  let mut plane := plane0
  let ts : Nat := 12
  let mut tmp : Array Int := Array.replicate (ts * (h + 4)) av1CdefPad
  let base : Int := Int.ofNat (2 * ts + 2)
  let xs : Int := if (edges &&& av1CdefHaveLeft) != 0 then -2 else 0
  let xe : Int := Int.ofNat (w + (if (edges &&& av1CdefHaveRight) != 0 then 2 else 0))
  if (edges &&& av1CdefHaveTop) != 0 then
    for yr in [:2] do
      let y : Int := Int.ofNat yr - 2
      let tRowBase : Int := Int.ofNat (topOff + yr * topStride) + Int.ofNat x0
      let mut x := xs
      while x < xe do
        let ti := (base + x + y * Int.ofNat ts).toNat
        tmp := tmp.set! ti (Int.ofNat (top.getD (tRowBase + x).toNat 0))
        x := x + 1
  for y in [:h] do
    let pRowBase := (y0 + y) * pStride
    let mut x := xs
    while x < 0 do
      let ti := (base + x + Int.ofNat (y * ts)).toNat
      tmp := tmp.set! ti (Int.ofNat (left.getD (y * 2 + (2 + x).toNat) 0))
      x := x + 1
    let mut xp : Nat := 0
    let xeN := xe.toNat
    while xp < xeN do
      let ti := (base + Int.ofNat xp + Int.ofNat (y * ts)).toNat
      tmp := tmp.set! ti (Int.ofNat (plane.getD (pRowBase + x0 + xp) 0))
      xp := xp + 1
  if (edges &&& av1CdefHaveBottom) != 0 then
    if let some (bot, botStride, botOff) := botOpt then
      for yr in [:2] do
        let y : Int := Int.ofNat (h + yr)
        let bRowBase : Int := Int.ofNat (botOff + yr * botStride) + Int.ofNat x0
        let mut x := xs
        while x < xe do
          let ti := (base + x + y * Int.ofNat ts).toNat
          tmp := tmp.set! ti (Int.ofNat (bot.getD (bRowBase + x).toNat 0))
          x := x + 1
  let di := direction * 2
  if pri != 0 then
    let priTap : Int := Int.ofNat (4 - (pri &&& 1))
    let uPri := av1Ulog2 pri
    let priShift : Nat := if damping > uPri then damping - uPri else 0
    if sec != 0 then
      let uSec := av1Ulog2 sec
      let secShift : Nat := if damping > uSec then damping - uSec else 0
      for y in [:h] do
        let t : Int := base + Int.ofNat (y * ts)
        let pRow := (y0 + y) * pStride + x0
        for x in [:w] do
          let px : Int := Int.ofNat (plane.getD (pRow + x) 0)
          let mut sm : Int := 0
          let mut lo : Int := px
          let mut hi : Int := px
          let mut tap := priTap
          let tx : Int := t + Int.ofNat x
          for k in [:2] do
            let o1 := av1CdefDirections.getD (di + 4 + k) 0
            let o2 := av1CdefDirections.getD (di + 8 + k) 0
            let o3 := av1CdefDirections.getD (di + k) 0
            let p0 := tmp.getD (tx + o1).toNat av1CdefPad
            let p1 := tmp.getD (tx - o1).toNat av1CdefPad
            sm := sm + tap * av1CdefConstrain (p0 - px) pri priShift
            sm := sm + tap * av1CdefConstrain (p1 - px) pri priShift
            tap := Int.ofNat ((tap.toNat &&& 3) ||| 2)
            lo := av1CdefUmin p0 (av1CdefUmin p1 lo)
            if p0 > hi then hi := p0
            if p1 > hi then hi := p1
            let st : Int := Int.ofNat (2 - k)
            let s0 := tmp.getD (tx + o2).toNat av1CdefPad
            let s1 := tmp.getD (tx - o2).toNat av1CdefPad
            let s2 := tmp.getD (tx + o3).toNat av1CdefPad
            let s3 := tmp.getD (tx - o3).toNat av1CdefPad
            for s in #[s0, s1, s2, s3] do
              sm := sm + st * av1CdefConstrain (s - px) sec secShift
              lo := av1CdefUmin s lo
              if s > hi then hi := s
          let bias : Int := if sm < 0 then 1 else 0
          let v := px + av1ArithShiftRight (sm - bias + 8) 4
          let clamped := if v < lo then lo else if v > hi then hi else v
          plane := plane.set! (pRow + x) (av1IclipU8 clamped)
    else
      for y in [:h] do
        let t : Int := base + Int.ofNat (y * ts)
        let pRow := (y0 + y) * pStride + x0
        for x in [:w] do
          let px : Int := Int.ofNat (plane.getD (pRow + x) 0)
          let mut sm : Int := 0
          let mut tap := priTap
          let tx : Int := t + Int.ofNat x
          for k in [:2] do
            let o1 := av1CdefDirections.getD (di + 4 + k) 0
            let p0 := tmp.getD (tx + o1).toNat av1CdefPad
            let p1 := tmp.getD (tx - o1).toNat av1CdefPad
            sm := sm + tap * av1CdefConstrain (p0 - px) pri priShift
            sm := sm + tap * av1CdefConstrain (p1 - px) pri priShift
            tap := Int.ofNat ((tap.toNat &&& 3) ||| 2)
          let bias : Int := if sm < 0 then 1 else 0
          let v := px + av1ArithShiftRight (sm - bias + 8) 4
          plane := plane.set! (pRow + x) (av1IclipU8 v)
  else if sec != 0 then
    let uSec := av1Ulog2 sec
    let secShift : Nat := if damping > uSec then damping - uSec else 0
    for y in [:h] do
      let t : Int := base + Int.ofNat (y * ts)
      let pRow := (y0 + y) * pStride + x0
      for x in [:w] do
        let px : Int := Int.ofNat (plane.getD (pRow + x) 0)
        let mut sm : Int := 0
        let tx : Int := t + Int.ofNat x
        for k in [:2] do
          let o1 := av1CdefDirections.getD (di + 8 + k) 0
          let o2 := av1CdefDirections.getD (di + k) 0
          let st : Int := Int.ofNat (2 - k)
          let s0 := tmp.getD (tx + o1).toNat av1CdefPad
          let s1 := tmp.getD (tx - o1).toNat av1CdefPad
          let s2 := tmp.getD (tx + o2).toNat av1CdefPad
          let s3 := tmp.getD (tx - o2).toNat av1CdefPad
          for s in #[s0, s1, s2, s3] do
            sm := sm + st * av1CdefConstrain (s - px) sec secShift
        let bias : Int := if sm < 0 then 1 else 0
        let v := px + av1ArithShiftRight (sm - bias + 8) 4
        plane := plane.set! (pRow + x) (av1IclipU8 v)
  return plane

structure Av1LrUnit where
  lrType     : Nat := 0
  filterH    : Array Int := #[3, -7, 15]
  filterV    : Array Int := #[3, -7, 15]
  sgrWeights : Array Int := #[-32, 31]
  deriving Inhabited, Repr, DecidableEq

private def av1LrExtendRow (src : Array Nat) (rowOff x0 w pw : Nat)
    (leftOpt : Option (Array Nat × Nat)) (edges : Nat) : Array Int := Id.run do
  let mut out : Array Int := Array.replicate (w + 6) 0
  for i in [:w] do
    out := out.set! (3 + i) (Int.ofNat (src.getD (rowOff + x0 + i) 0))
  if (edges &&& av1LrHaveLeft) != 0 then
    match leftOpt with
    | some (lbuf, loff) =>
      out := out.set! 0 (Int.ofNat (lbuf.getD (loff + 1) 0))
      out := out.set! 1 (Int.ofNat (lbuf.getD (loff + 2) 0))
      out := out.set! 2 (Int.ofNat (lbuf.getD (loff + 3) 0))
    | none =>
      out := out.set! 0 (Int.ofNat (src.getD (rowOff + x0 - 3) 0))
      out := out.set! 1 (Int.ofNat (src.getD (rowOff + x0 - 2) 0))
      out := out.set! 2 (Int.ofNat (src.getD (rowOff + x0 - 1) 0))
  else
    let v0 := Int.ofNat (src.getD (rowOff + x0) 0)
    out := out.set! 0 v0
    out := out.set! 1 v0
    out := out.set! 2 v0
  if (edges &&& av1LrHaveRight) != 0 then
    for k in [:3] do
      let idx := Nat.min (pw - 1) (x0 + w + k)
      out := out.set! (3 + w + k) (Int.ofNat (src.getD (rowOff + idx) 0))
  else
    let vLast := Int.ofNat (src.getD (rowOff + x0 + w - 1) 0)
    out := out.set! (3 + w) vLast
    out := out.set! (4 + w) vLast
    out := out.set! (5 + w) vLast
  return out

private def av1LrRows (plane : Array Nat) (pStride pw x0 y0 w h : Nat)
    (leftOpt : Option (Array Nat × Nat))
    (lpfPlane : Array Nat) (lpfStride topIdx botIdx edges : Nat) : Array Int := Id.run do
  let pw6 := w + 6
  let mut patch : Array Int := Array.replicate ((h + 6) * pw6) 0
  let copyRow (dstRow : Nat) (r : Array Int) (p : Array Int) : Array Int := Id.run do
    let mut dst := p
    let base := dstRow * pw6
    for i in [:pw6] do
      dst := dst.set! (base + i) (r.getD i 0)
    return dst
  let mut mid0 : Array Int := #[]
  let mut midLast : Array Int := #[]
  for y in [:h] do
    let lRowOpt := match leftOpt with
      | some (lb, lRow0) => some (lb, (lRow0 + y) * 4)
      | none => none
    let r := av1LrExtendRow plane ((y0 + y) * pStride) x0 w pw lRowOpt edges
    if y == 0 then mid0 := r
    if y + 1 == h then midLast := r
    patch := copyRow (3 + y) r patch
  if (edges &&& av1LrHaveTop) != 0 then
    let rm2 := av1LrExtendRow lpfPlane (topIdx * lpfStride) x0 w pw none edges
    let rm1 := av1LrExtendRow lpfPlane ((topIdx + 1) * lpfStride) x0 w pw none edges
    patch := copyRow 0 rm2 patch
    patch := copyRow 1 rm2 patch
    patch := copyRow 2 rm1 patch
  else
    patch := copyRow 0 mid0 patch
    patch := copyRow 1 mid0 patch
    patch := copyRow 2 mid0 patch
  if (edges &&& av1LrHaveBottom) != 0 then
    let rp0 := av1LrExtendRow lpfPlane (botIdx * lpfStride) x0 w pw none edges
    let rp1 := av1LrExtendRow lpfPlane ((botIdx + 1) * lpfStride) x0 w pw none edges
    patch := copyRow (3 + h) rp0 patch
    patch := copyRow (4 + h) rp1 patch
    patch := copyRow (5 + h) rp1 patch
  else
    patch := copyRow (3 + h) midLast patch
    patch := copyRow (4 + h) midLast patch
    patch := copyRow (5 + h) midLast patch
  return patch

def av1WienerBlock (plane0 : Array Nat) (pStride pw x0 y0 w h : Nat)
    (fh3 fv3 : Array Int) (leftOpt : Option (Array Nat × Nat))
    (lpfPlane : Array Nat) (lpfStride topIdx botIdx edges : Nat) : Array Nat := Id.run do
  let mut plane := plane0
  let fh0 := fh3.getD 0 0; let fh1 := fh3.getD 1 0; let fh2 := fh3.getD 2 0
  let fv0 := fv3.getD 0 0; let fv1 := fv3.getD 1 0; let fv2 := fv3.getD 2 0
  let fh : Array Int := #[fh0, fh1, fh2, -(fh0 + fh1 + fh2) * 2, fh2, fh1, fh0]
  let fv : Array Int := #[fv0, fv1, fv2, 128 - (fv0 + fv1 + fv2) * 2, fv2, fv1, fv0]
  let patch := av1LrRows plane pStride pw x0 y0 w h leftOpt lpfPlane lpfStride topIdx botIdx edges
  let pw6 := w + 6
  let mut hor : Array Int := Array.replicate ((h + 6) * w) 0
  for r in [:h + 6] do
    let rBase := r * pw6
    let hBase := r * w
    for x in [:w] do
      let mut sm : Int := (1 <<< 14) + patch.getD (rBase + x + 3) 0 * 128
      for k in [:7] do
        sm := sm + patch.getD (rBase + x + k) 0 * fh.getD k 0
      let v := av1ArithShiftRight (sm + 4) 3
      let clamped : Int := if v < 0 then 0 else if v > 32767 then 32767 else v
      hor := hor.set! (hBase + x) clamped
  for y in [:h] do
    let pRow := (y0 + y) * pStride + x0
    for x in [:w] do
      let mut sm : Int := -(1 <<< 18)
      for k in [:7] do
        sm := sm + hor.getD ((y + k) * w + x) 0 * fv.getD k 0
      plane := plane.set! (pRow + x) (av1IclipU8 (av1ArithShiftRight (sm + 1024) 11))
  return plane

private def av1SgrAb (patch : Array Int) (w h radius s : Nat) : Array Int × Array Int := Id.run do
  let n : Int := if radius == 1 then 9 else 25
  let oneByX : Int := if radius == 1 then 455 else 164
  let pw6 := w + 6
  let w2 := w + 2
  let mut matA : Array Int := Array.replicate ((h + 2) * w2) 0
  let mut matB : Array Int := Array.replicate ((h + 2) * w2) 0
  let span := 2 * radius + 1
  for ry in [:h + 2] do
    let cy := ry + 2
    for rx in [:w2] do
      let cx := rx + 2
      let mut sm : Int := 0
      let mut sq : Int := 0
      for dyi in [:span] do
        let rowOff := (cy + dyi - radius) * pw6
        for dxi in [:span] do
          let v := patch.getD (rowOff + cx + dxi - radius) 0
          sm := sm + v
          sq := sq + v * v
      let diff := sq * n - sm * sm
      let p : Int := if diff > 0 then diff else 0
      let z := (av1ArithShiftRight (p * Int.ofNat s + (1 <<< 19)) 20).toNat
      let xv : Int := Int.ofNat (av1SgrXByX.getD (if z < 255 then z else 255) 0)
      let idx := ry * w2 + rx
      matA := matA.set! idx (av1ArithShiftRight (xv * sm * oneByX + (1 <<< 11)) 12)
      matB := matB.set! idx xv
  return (matA, matB)

private def av1SgrT3 (patch : Array Int) (w h s1 : Nat) : Array Int := Id.run do
  let (matA, matB) := av1SgrAb patch w h 1 s1
  let pw6 := w + 6
  let w2 := w + 2
  let mut out : Array Int := Array.replicate (h * w) 0
  for y in [:h] do
    let srcOff := (y + 3) * pw6
    let r0 := y * w2
    let r1 := (y + 1) * w2
    let r2 := (y + 2) * w2
    let oRow := y * w
    for x in [:w] do
      let i := x + 1
      let a := (matB.getD (r1 + i) 0 + matB.getD (r1 + i - 1) 0 + matB.getD (r1 + i + 1) 0 +
                matB.getD (r0 + i) 0 + matB.getD (r2 + i) 0) * 4 +
               (matB.getD (r0 + i - 1) 0 + matB.getD (r2 + i - 1) 0 +
                matB.getD (r0 + i + 1) 0 + matB.getD (r2 + i + 1) 0) * 3
      let b := (matA.getD (r1 + i) 0 + matA.getD (r1 + i - 1) 0 + matA.getD (r1 + i + 1) 0 +
                matA.getD (r0 + i) 0 + matA.getD (r2 + i) 0) * 4 +
               (matA.getD (r0 + i - 1) 0 + matA.getD (r2 + i - 1) 0 +
                matA.getD (r0 + i + 1) 0 + matA.getD (r2 + i + 1) 0) * 3
      out := out.set! (oRow + x) (av1ArithShiftRight (b - a * patch.getD (srcOff + x + 3) 0 + 256) 9)
  return out

private def av1SgrT5 (patch : Array Int) (w h s0 : Nat) : Array Int := Id.run do
  let (matA, matB) := av1SgrAb patch w h 2 s0
  let pw6 := w + 6
  let w2 := w + 2
  let mut out : Array Int := Array.replicate (h * w) 0
  let mut y : Nat := 0
  while y < h do
    let src0 := (y + 3) * pw6
    let r0 := y * w2
    let r1 := (y + 2) * w2
    let oRow0 := y * w
    for x in [:w] do
      let i := x + 1
      let a := (matB.getD (r0 + i) 0 + matB.getD (r1 + i) 0) * 6 +
               (matB.getD (r0 + i - 1) 0 + matB.getD (r1 + i - 1) 0 +
                matB.getD (r0 + i + 1) 0 + matB.getD (r1 + i + 1) 0) * 5
      let b := (matA.getD (r0 + i) 0 + matA.getD (r1 + i) 0) * 6 +
               (matA.getD (r0 + i - 1) 0 + matA.getD (r1 + i - 1) 0 +
                matA.getD (r0 + i + 1) 0 + matA.getD (r1 + i + 1) 0) * 5
      out := out.set! (oRow0 + x) (av1ArithShiftRight (b - a * patch.getD (src0 + x + 3) 0 + 256) 9)
    if y + 1 < h then
      let src1 := (y + 4) * pw6
      let oRow1 := (y + 1) * w
      for x in [:w] do
        let i := x + 1
        let a := matB.getD (r1 + i) 0 * 6 + (matB.getD (r1 + i - 1) 0 + matB.getD (r1 + i + 1) 0) * 5
        let b := matA.getD (r1 + i) 0 * 6 + (matA.getD (r1 + i - 1) 0 + matA.getD (r1 + i + 1) 0) * 5
        out := out.set! (oRow1 + x) (av1ArithShiftRight (b - a * patch.getD (src1 + x + 3) 0 + 128) 8)
    y := y + 2
  return out

def av1SgrBlock (plane0 : Array Nat) (pStride pw x0 y0 w h sgrIdx : Nat)
    (weights : Array Int) (leftOpt : Option (Array Nat × Nat))
    (lpfPlane : Array Nat) (lpfStride topIdx botIdx edges : Nat) : Array Nat := Id.run do
  let mut plane := plane0
  let s0 := av1SgrParams.getD (sgrIdx * 2) 0
  let s1 := av1SgrParams.getD (sgrIdx * 2 + 1) 0
  let w0 := weights.getD 0 0
  let w1 := 128 - (w0 + weights.getD 1 0)
  let patch := av1LrRows plane pStride pw x0 y0 w h leftOpt lpfPlane lpfStride topIdx botIdx edges
  if s0 != 0 && s1 != 0 then
    let t5 := av1SgrT5 patch w h s0
    let t3 := av1SgrT3 patch w h s1
    for y in [:h] do
      let pRow := (y0 + y) * pStride + x0
      let tRow := y * w
      for x in [:w] do
        let cur := Int.ofNat (plane.getD (pRow + x) 0)
        let adj := av1ArithShiftRight (w0 * t5.getD (tRow + x) 0 + w1 * t3.getD (tRow + x) 0 + 1024) 11
        plane := plane.set! (pRow + x) (av1IclipU8 (cur + adj))
  else if s0 != 0 then
    let t5 := av1SgrT5 patch w h s0
    for y in [:h] do
      let pRow := (y0 + y) * pStride + x0
      let tRow := y * w
      for x in [:w] do
        let cur := Int.ofNat (plane.getD (pRow + x) 0)
        let adj := av1ArithShiftRight (w0 * t5.getD (tRow + x) 0 + 1024) 11
        plane := plane.set! (pRow + x) (av1IclipU8 (cur + adj))
  else
    let t3 := av1SgrT3 patch w h s1
    for y in [:h] do
      let pRow := (y0 + y) * pStride + x0
      let tRow := y * w
      for x in [:w] do
        let cur := Int.ofNat (plane.getD (pRow + x) 0)
        let adj := av1ArithShiftRight (w1 * t3.getD (tRow + x) 0 + 1024) 11
        plane := plane.set! (pRow + x) (av1IclipU8 (cur + adj))
  return plane

private def av1ScaleFac (inW outW : Nat) : Nat :=
  if outW == 0 then 16384 else ((inW <<< 14) + (outW >>> 1)) / outW

private def av1GetUpscaleX0 (inW outW step : Nat) : Nat :=
  if outW == 0 then 0
  else
    let inWi : Int := Int.ofNat inW
    let outWi : Int := Int.ofNat outW
    let err : Int := outWi * Int.ofNat step - (inWi <<< 14)
    let num : Int := -((outWi - inWi) <<< 13) + Int.ofNat (outW >>> 1)
    let x0 : Int := Int.tdiv num outWi + 128 - Int.tdiv err 2
    ((x0 % 16384 + 16384) % 16384).toNat

private def av1ResizePlane (dst0 : Array Nat) (dstOff dstStride : Nat)
    (src : Array Nat) (srcOff srcStride dstW nRows srcW dx mx0 : Nat) : Array Nat := Id.run do
  if dstW == 0 || nRows == 0 || srcW == 0 then
    return dst0
  let mut dst := dst0
  let srcMax : Int := Int.ofNat (srcW - 1)
  for r in [:nRows] do
    let dRow := dstOff + r * dstStride
    let sRow := srcOff + r * srcStride
    let mut mx : Nat := mx0
    let mut srcX : Int := -1
    for x in [:dstW] do
      let fBase := (mx >>> 8) * 8
      let mut acc : Int := 0
      for k in [:8] do
        let sx := (av1Iclip (srcX - 3 + Int.ofNat k) 0 srcMax).toNat
        acc := acc + av1ResizeFilter.getD (fBase + k) 0 * Int.ofNat (src.getD (sRow + sx) 0)
      let px := av1IclipU8 (av1ArithShiftRight (-acc + 64) 7)
      dst := dst.set! (dRow + x) px
      mx := mx + dx
      srcX := srcX + Int.ofNat (mx >>> 14)
      mx := mx &&& 0x3FFF
  return dst

private def av1CopyLpfPlane (plane : Array Nat) (pStride : Nat) (dstLines0 : Array Nat)
    (lpfStride sby sb128 ss srcW dstW h : Nat) (doResize : Bool := false)
    (dx : Nat := 16384) (mx0 : Nat := 0) : Array Nat := Id.run do
  let mut dstLines := dstLines0
  let offset := (if sby != 0 then 8 else 0) >>> ss
  let mut row := (sby <<< ((6 - ss) + sb128)) - offset
  let rowH := Nat.min ((sby + 1) <<< ((6 - ss) + sb128)) (h - 1)
  let mut stripeH := (64 - (if row != 0 then 0 else 8)) >>> ss
  if row != 0 then
    let top := 4 <<< sb128
    for k in [:4] do
      let dOff := k * lpfStride
      let sOff := (top + k) * lpfStride
      for i in [:dstW] do
        dstLines := dstLines.set! (dOff + i) (dstLines.getD (sOff + i) 0)
  let mut d : Nat := 4
  let mut sy : Nat := row + stripeH - 2
  if doResize then
    while row + stripeH <= rowH do
      let nLines := 4 - (if row + stripeH + 1 == h then 1 else 0)
      dstLines := av1ResizePlane dstLines (d * lpfStride) lpfStride plane (sy * pStride) pStride dstW nLines srcW dx mx0
      row := row + stripeH
      stripeH := 64 >>> ss
      sy := sy + stripeH
      d := d + nLines
      if nLines == 3 then
        let prevOff := (d - 1) * lpfStride
        let dOff := d * lpfStride
        for c in [:dstW] do
          dstLines := dstLines.set! (dOff + c) (dstLines.getD (prevOff + c) 0)
        d := d + 1
  else
    while row + stripeH <= rowH do
      let nLines := 4 - (if row + stripeH + 1 == h then 1 else 0)
      for i in [:4] do
        let dOff := d * lpfStride
        if i == nLines then
          let prevOff := (d - 1) * lpfStride
          for c in [:srcW] do
            dstLines := dstLines.set! (dOff + c) (dstLines.getD (prevOff + c) 0)
        else
          let pOff := sy * pStride
          for c in [:srcW] do
            dstLines := dstLines.set! (dOff + c) (plane.getD (pOff + c) 0)
        d := d + 1
        sy := sy + 1
      row := row + stripeH
      stripeH := 64 >>> ss
      sy := sy + stripeH - 4
  return dstLines

private def av1CdefSbrow (hdr : Av1FrameHdr) (yPlane0 uPlane0 vPlane0 : Array Nat)
    (yStride uvStride : Nat) (cdefY0 cdefU0 cdefV0 : Array Nat)
    (cdefYStride cdefUvStride : Nat)
    (lfMasks : Array Av1LfMask) (rowMaskOff byStart byEnd bw bh : Nat) :
    Array Nat × Array Nat × Array Nat × Array Nat × Array Nat × Array Nat := Id.run do
  let mut yPlane := yPlane0
  let mut uPlane := uPlane0
  let mut vPlane := vPlane0
  let mut cdefY := cdefY0
  let mut cdefU := cdefU0
  let mut cdefV := cdefV0
  let cdef := hdr.cdef
  let damping := cdef.damping
  let sb64w := (bw + 15) >>> 4
  let mut edges := av1CdefHaveBottom ||| (if byStart > 0 then av1CdefHaveTop else 0)
  let mut by4 := byStart
  while by4 < byEnd do
    let tf := (by4 >>> 1) &&& 1
    let byIdx := (by4 &&& 30) >>> 1
    if by4 + 2 >= bh then
      edges := edges - (edges &&& av1CdefHaveBottom)
    let y0 := by4 * 4
    let cy0 := by4 * 2
    if (edges &&& av1CdefHaveBottom) != 0 then
      let ntf := 1 - tf
      for r in [:2] do
        let dstOffY := (ntf * 2 + r) * cdefYStride
        let srcOffY := (y0 + 6 + r) * yStride
        for c in [:bw * 4] do
          cdefY := cdefY.set! (dstOffY + c) (yPlane.getD (srcOffY + c) 0)
        let dstOffC := (ntf * 2 + r) * cdefUvStride
        let srcOffC := (cy0 + 2 + r) * uvStride
        for c in [:bw * 2] do
          cdefU := cdefU.set! (dstOffC + c) (uPlane.getD (srcOffC + c) 0)
          cdefV := cdefV.set! (dstOffC + c) (vPlane.getD (srcOffC + c) 0)
    let mut lrBakY0 : Array Nat := Array.replicate 16 0
    let mut lrBakY1 : Array Nat := Array.replicate 16 0
    let mut lrBakU0 : Array Nat := Array.replicate 8 0
    let mut lrBakU1 : Array Nat := Array.replicate 8 0
    let mut lrBakV0 : Array Nat := Array.replicate 8 0
    let mut lrBakV1 : Array Nat := Array.replicate 8 0
    edges := (edges - (edges &&& av1CdefHaveLeft)) ||| av1CdefHaveRight
    let mut prevFlag : Nat := 0
    let mut bit : Nat := 0
    for sbx in [:sb64w] do
      let sb128x := sbx >>> 1
      let sb64Idx := ((by4 &&& 16) >>> 3) + (sbx &&& 1)
      let rMask := lfMasks.getD (rowMaskOff + sb128x) {}
      let cdefIdx := rMask.cdefIdx.getD sb64Idx (-1)
      if cdefIdx < 0 then
        prevFlag := 0
        edges := edges ||| av1CdefHaveLeft
      else
        let ci := cdefIdx.toNat
        let yLvl := cdef.yStrength.getD ci 0
        let uvLvl := cdef.uvStrength.getD ci 0
        if yLvl == 0 && uvLvl == 0 then
          prevFlag := 0
          edges := edges ||| av1CdefHaveLeft
        else
          let n0 := rMask.noskip.getD (byIdx * 2) 0
          let n1 := rMask.noskip.getD (byIdx * 2 + 1) 0
          let noskipMask := (n1 <<< 16) ||| n0
          let flag := (if yLvl != 0 then 1 else 0) ||| (if uvLvl != 0 then 2 else 0)
          let yPri := yLvl >>> 2
          let ySec := (yLvl &&& 3) + (if (yLvl &&& 3) == 3 then 1 else 0)
          let uvPri := uvLvl >>> 2
          let uvSec := (uvLvl &&& 3) + (if (uvLvl &&& 3) == 3 then 1 else 0)
          let bxEnd := Nat.min ((sbx + 1) * 16) bw
          let mut bx := sbx * 16
          while bx < bxEnd do
            if bx + 2 >= bw then
              edges := edges - (edges &&& av1CdefHaveRight)
            if (noskipMask &&& (3 <<< (bx &&& 30))) == 0 then
              prevFlag := 0
              edges := edges ||| av1CdefHaveLeft
            else
              let doLeft := (prevFlag ^^^ flag) &&& flag
              prevFlag := flag
              let x0 := bx * 4
              let cx0 := bx * 2
              if doLeft != 0 && (edges &&& av1CdefHaveLeft) != 0 then
                if (doLeft &&& 1) != 0 then
                  for yy in [:8] do
                    let v0 := yPlane.getD ((y0 + yy) * yStride + x0 - 2) 0
                    let v1 := yPlane.getD ((y0 + yy) * yStride + x0 - 1) 0
                    if bit == 0 then
                      lrBakY0 := (lrBakY0.set! (yy * 2) v0).set! (yy * 2 + 1) v1
                    else
                      lrBakY1 := (lrBakY1.set! (yy * 2) v0).set! (yy * 2 + 1) v1
                if (doLeft &&& 2) != 0 then
                  for yy in [:4] do
                    let u0v := uPlane.getD ((cy0 + yy) * uvStride + cx0 - 2) 0
                    let u1v := uPlane.getD ((cy0 + yy) * uvStride + cx0 - 1) 0
                    let v0v := vPlane.getD ((cy0 + yy) * uvStride + cx0 - 2) 0
                    let v1v := vPlane.getD ((cy0 + yy) * uvStride + cx0 - 1) 0
                    if bit == 0 then
                      lrBakU0 := (lrBakU0.set! (yy * 2) u0v).set! (yy * 2 + 1) u1v
                      lrBakV0 := (lrBakV0.set! (yy * 2) v0v).set! (yy * 2 + 1) v1v
                    else
                      lrBakU1 := (lrBakU1.set! (yy * 2) u0v).set! (yy * 2 + 1) u1v
                      lrBakV1 := (lrBakV1.set! (yy * 2) v0v).set! (yy * 2 + 1) v1v
              if (edges &&& av1CdefHaveRight) != 0 then
                let nbit := 1 - bit
                if (flag &&& 1) != 0 then
                  for yy in [:8] do
                    let v0 := yPlane.getD ((y0 + yy) * yStride + x0 + 6) 0
                    let v1 := yPlane.getD ((y0 + yy) * yStride + x0 + 7) 0
                    if nbit == 0 then
                      lrBakY0 := (lrBakY0.set! (yy * 2) v0).set! (yy * 2 + 1) v1
                    else
                      lrBakY1 := (lrBakY1.set! (yy * 2) v0).set! (yy * 2 + 1) v1
                if (flag &&& 2) != 0 then
                  for yy in [:4] do
                    let u0v := uPlane.getD ((cy0 + yy) * uvStride + cx0 + 2) 0
                    let u1v := uPlane.getD ((cy0 + yy) * uvStride + cx0 + 3) 0
                    let v0v := vPlane.getD ((cy0 + yy) * uvStride + cx0 + 2) 0
                    let v1v := vPlane.getD ((cy0 + yy) * uvStride + cx0 + 3) 0
                    if nbit == 0 then
                      lrBakU0 := (lrBakU0.set! (yy * 2) u0v).set! (yy * 2 + 1) u1v
                      lrBakV0 := (lrBakV0.set! (yy * 2) v0v).set! (yy * 2 + 1) v1v
                    else
                      lrBakU1 := (lrBakU1.set! (yy * 2) u0v).set! (yy * 2 + 1) u1v
                      lrBakV1 := (lrBakV1.set! (yy * 2) v0v).set! (yy * 2 + 1) v1v
              let (direction, var) :=
                if yPri != 0 || uvPri != 0 then av1CdefFindDir yPlane yStride x0 y0 else (0, 0)
              let botYOpt :=
                if (edges &&& av1CdefHaveBottom) != 0 then some (yPlane, yStride, (y0 + 8) * yStride) else none
              let leftY := if bit == 0 then lrBakY0 else lrBakY1
              if yPri != 0 then
                let adj := av1CdefAdjustStrength yPri var
                if adj != 0 || ySec != 0 then
                  yPlane := av1CdefFilter yPlane yStride x0 y0 leftY cdefY cdefYStride (tf * 2 * cdefYStride)
                    botYOpt adj ySec direction damping 8 8 edges
              else if ySec != 0 then
                yPlane := av1CdefFilter yPlane yStride x0 y0 leftY cdefY cdefYStride (tf * 2 * cdefYStride)
                  botYOpt 0 ySec 0 damping 8 8 edges
              if uvLvl != 0 then
                let uvdir := if uvPri != 0 then direction else 0
                let leftU := if bit == 0 then lrBakU0 else lrBakU1
                let leftV := if bit == 0 then lrBakV0 else lrBakV1
                let botUOpt :=
                  if (edges &&& av1CdefHaveBottom) != 0 then some (uPlane, uvStride, (cy0 + 4) * uvStride) else none
                let botVOpt :=
                  if (edges &&& av1CdefHaveBottom) != 0 then some (vPlane, uvStride, (cy0 + 4) * uvStride) else none
                uPlane := av1CdefFilter uPlane uvStride cx0 cy0 leftU cdefU cdefUvStride (tf * 2 * cdefUvStride)
                  botUOpt uvPri uvSec uvdir (damping - 1) 4 4 edges
                vPlane := av1CdefFilter vPlane uvStride cx0 cy0 leftV cdefV cdefUvStride (tf * 2 * cdefUvStride)
                  botVOpt uvPri uvSec uvdir (damping - 1) 4 4 edges
              bit := bit ^^^ 1
              edges := edges ||| av1CdefHaveLeft
            bx := bx + 2
          edges := edges ||| av1CdefHaveLeft
    edges := edges ||| av1CdefHaveTop
    by4 := by4 + 2
  return (yPlane, uPlane, vPlane, cdefY, cdefU, cdefV)

private def av1LrStripe (plane0 : Array Nat) (pStride pw : Nat)
    (lpfPlane : Array Nat) (lpfStride : Nat)
    (x y0 unitW rowH sby sbh ss : Nat) (lr : Av1LrUnit)
    (leftOpt0 : Option (Array Nat × Nat)) (edges0 : Nat) : Array Nat := Id.run do
  let mut plane := plane0
  let mut y := y0
  let mut leftOpt := leftOpt0
  let mut edges := edges0
  let mut stripeH := Nat.min ((64 - (if y == 0 then 8 else 0)) >>> ss) (rowH - y)
  let mut lpfIdx : Nat := 0
  while y + stripeH <= rowH && stripeH > 0 do
    if sby + 1 != sbh || y + stripeH != rowH then
      edges := edges ||| av1LrHaveBottom
    else
      edges := edges - (edges &&& av1LrHaveBottom)
    if lr.lrType == 2 then
      plane := av1WienerBlock plane pStride pw x y unitW stripeH lr.filterH lr.filterV leftOpt
        lpfPlane lpfStride lpfIdx (lpfIdx + 6) edges
    else if lr.lrType >= 3 then
      plane := av1SgrBlock plane pStride pw x y unitW stripeH (lr.lrType - 3) lr.sgrWeights leftOpt
        lpfPlane lpfStride lpfIdx (lpfIdx + 6) edges
    if let some (lb, lRow) := leftOpt then
      leftOpt := some (lb, lRow + stripeH)
    y := y + stripeH
    edges := edges ||| av1LrHaveTop
    stripeH := Nat.min (64 >>> ss) (rowH - y)
    lpfIdx := lpfIdx + 4
  return plane

private def av1LrPlaneSbrow (plane0 : Array Nat) (pStride : Nat)
    (lpfPlane : Array Nat) (lpfStride : Nat)
    (lrUnits : Array Av1LrUnit) (pl unitSizeLog2 y w h rowH sby sbh sb128w : Nat) : Array Nat := Id.run do
  let mut plane := plane0
  let ss : Nat := if pl != 0 then 1 else 0
  let unitSize := 1 <<< unitSizeLog2
  let halfUnit := unitSize >>> 1
  let maxUnit := unitSize + halfUnit
  let rowY := y + (if y != 0 then 8 >>> ss else 0)
  let shiftHor := 7 - ss
  let mut edges := (if y > 0 then av1LrHaveTop else 0) ||| av1LrHaveRight
  let mask := unitSize - 1
  let mut aligned := rowY - (rowY &&& mask)
  if aligned != 0 && aligned + halfUnit > h then
    aligned := aligned - unitSize
  aligned := aligned <<< ss
  let sbIdx := (aligned >>> 7) * sb128w
  let unitIdx := ((aligned >>> 6) &&& 1) <<< 1
  let lrAt (sb u : Nat) : Av1LrUnit := lrUnits.getD ((sb * 3 + pl) * 4 + u) {}
  let mut curLr := lrAt sbIdx unitIdx
  let mut restore := curLr.lrType != 0
  let backupH := rowH - y
  let mut border0 : Array Nat := Array.replicate (backupH * 4) 0
  let mut border1 : Array Nat := Array.replicate (backupH * 4) 0
  let mut x : Nat := 0
  let mut bit : Nat := 0
  while x + maxUnit <= w do
    let nextX := x + unitSize
    let nextU := unitIdx + ((nextX >>> (shiftHor - 1)) &&& 1)
    let nextLr := lrAt (sbIdx + (nextX >>> shiftHor)) nextU
    let restoreNext := nextLr.lrType != 0
    if restoreNext then
      for r in [:backupH] do
        let srcOff := (y + r) * pStride + x + unitSize - 4
        let dstOff := r * 4
        for k in [:4] do
          let px := plane.getD (srcOff + k) 0
          if bit == 0 then
            border0 := border0.set! (dstOff + k) px
          else
            border1 := border1.set! (dstOff + k) px
    if restore then
      let leftOpt :=
        if (edges &&& av1LrHaveLeft) != 0 then
          some (if bit == 0 then border1 else border0, 0)
        else none
      plane := av1LrStripe plane pStride w lpfPlane lpfStride x y unitSize rowH sby sbh ss curLr leftOpt edges
    x := nextX
    curLr := nextLr
    restore := restoreNext
    edges := edges ||| av1LrHaveLeft
    bit := bit ^^^ 1
  if restore then
    edges := edges - (edges &&& av1LrHaveRight)
    let leftOpt :=
      if (edges &&& av1LrHaveLeft) != 0 then
        some (if bit == 0 then border1 else border0, 0)
      else none
    plane := av1LrStripe plane pStride w lpfPlane lpfStride x y (w - x) rowH sby sbh ss curLr leftOpt edges
  return plane

def av1PostfilterFrame (seq : Av1SeqHdr) (hdr : Av1FrameHdr)
    (yPlane0 uPlane0 vPlane0 : Array Nat) (yStride uvStride : Nat)
    (lfMasks0 : Array Av1LfMask) (levelY levelUv : Array Nat) (b4Stride : Nat)
    (lrUnits : Array Av1LrUnit)
    (txLpfRightEdgeY : Array Nat := #[]) (txLpfRightEdgeUv : Array Nat := #[])
    (aboveRows : Array (Array Av1BlockContext) := #[])
    (startOfTileRow : Array Nat := #[]) (alignH : Nat := 0) :
    Array Nat × Array Nat × Array Nat × Nat × Nat := Id.run do
  let mut yPlane := yPlane0
  let mut uPlane := uPlane0
  let mut vPlane := vPlane0
  let mut lfMasks := lfMasks0
  let sb128 := seq.sb128
  let isSb64 := 1 - sb128
  let sbsz := 32 >>> isSb64
  let sbl2 := 5 - isSb64
  let w0 := hdr.width0
  let h := hdr.height
  let w4 := (w0 + 3) >>> 2
  let h4 := (h + 3) >>> 2
  let bw := ((w0 + 7) >>> 3) <<< 1
  let bh := ((h + 7) >>> 3) <<< 1
  let sb128w := (bw + 31) >>> 5
  let sbh := (bh + sbsz - 1) / sbsz
  let lf := hdr.loopfilter
  let doLf := lf.levelY.getD 0 0 != 0 || lf.levelY.getD 1 0 != 0
  let doCdef := !hdr.allLossless && seq.cdef && !hdr.allowIntrabc
  let rest := hdr.restoration
  let restorePlanes :=
    (if rest.lrType.getD 0 0 != 0 then 1 else 0) |||
    (if rest.lrType.getD 1 0 != 0 then 2 else 0) |||
    (if rest.lrType.getD 2 0 != 0 then 4 else 0)
  let (eLut, iLut) := if doLf then av1CalcEih lf.sharpness else (#[], #[])
  let w1 := hdr.width1
  let superRes := w0 != w1
  let lpfYStride := bw <<< 2
  let lpfUvStride := bw <<< 1
  let srBw := ((w1 + 7) >>> 3) <<< 1
  let srSb128w := (srBw + 31) >>> 5
  let srYStride := ((((srBw * 4 + 127) &&& (0xFFFFFFFF - 127)) + 128))
  let srUvStride := srYStride >>> 1
  let lrLpfYStride := if superRes then srYStride else lpfYStride
  let lrLpfUvStride := if superRes then srUvStride else lpfUvStride
  let needLpf := seq.cdef || restorePlanes != 0
  let mut lpfY : Array Nat := if needLpf && (restorePlanes != 0 || !superRes) then Array.replicate (12 * lrLpfYStride) 0 else #[]
  let mut lpfU : Array Nat := if needLpf && (restorePlanes != 0 || !superRes) then Array.replicate (12 * lrLpfUvStride) 0 else #[]
  let mut lpfV : Array Nat := if needLpf && (restorePlanes != 0 || !superRes) then Array.replicate (12 * lrLpfUvStride) 0 else #[]
  let mut cdefY : Array Nat := if doCdef then Array.replicate (4 * lpfYStride) 0 else #[]
  let mut cdefU : Array Nat := if doCdef then Array.replicate (4 * lpfUvStride) 0 else #[]
  let mut cdefV : Array Nat := if doCdef then Array.replicate (4 * lpfUvStride) 0 else #[]
  let yRows := (((bh * 4 + 127) &&& (0xFFFFFFFF - 127)) + 128)
  let uvRows := yRows >>> 1
  let mut srY : Array Nat := if superRes then Array.replicate (srYStride * yRows) 128 else #[]
