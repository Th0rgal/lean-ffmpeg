private def av1FlipArray (arr : Array Int) : Array Int := Id.run do
  let n := arr.size
  let mut out := Array.mkEmpty n
  for i in [:n] do
    out := out.push (arr.getD (n - 1 - i) 0)
  return out

def av1Itx1d (kind n : Nat) (x : Array Int) : Array Int :=
  match kind with
  | 0 =>
    match n with
    | 4  => av1InvDct4 x
    | 8  => av1InvDct8 x
    | 16 => av1InvDct16 x
    | 32 => av1InvDct32 x
    | 64 => av1InvDct64 x
    | _  => x
  | 1 =>
    match n with
    | 4  => av1InvAdst4 x
    | 8  => av1InvAdst8 x
    | 16 => av1InvAdst16 x
    | _  => x
  | 2 =>
    match n with
    | 4  => av1FlipArray (av1InvAdst4 x)
    | 8  => av1FlipArray (av1InvAdst8 x)
    | 16 => av1FlipArray (av1InvAdst16 x)
    | _  => x
  | _ => av1InvIdtx n x

