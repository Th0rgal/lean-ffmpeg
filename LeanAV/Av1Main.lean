private def av1WedgeMasterBorderEven : Array Nat := #[1, 4, 11, 27, 46, 58, 62, 63]
private def av1WedgeMasterBorderVert : Array Nat := #[0, 2, 7, 21, 43, 57, 62, 64]

private def av1InsertBorderRow (src : Array Nat) (ctr : Nat) : Array Nat := Id.run do
  let mut row := Array.replicate 64 0
  let startCopy := (if ctr > 4 then ctr else 4) - 4
  let srcOff := if 4 > ctr then 4 - ctr else 0
  let copyLen := Nat.min (64 - ctr) 8
  for i in [:copyLen] do
    row := row.set! (startCopy + i) (src.getD (srcOff + i) 0)
  if ctr + 4 < 64 then
    for j in [ctr + 4 : 64] do
      row := row.set! j 64
  return row

private def av1Transpose64 (src : Array Nat) : Array Nat := Id.run do
  let mut dst := Array.replicate (64 * 64) 0
  for y in [:64] do
    for x in [:64] do
      dst := dst.set! (x * 64 + y) (src.getD (y * 64 + x) 0)
  return dst

private def av1Hflip64 (src : Array Nat) : Array Nat := Id.run do
  let mut dst := Array.replicate (64 * 64) 0
  for y in [:64] do
    for x in [:64] do
      dst := dst.set! (y * 64 + (63 - x)) (src.getD (y * 64 + x) 0)
  return dst

private def av1WedgeMasterTemplates : Array (Array Nat) := Id.run do
  let vertRow := av1InsertBorderRow av1WedgeMasterBorderVert 32
  let mut mVert := Array.replicate (64 * 64) 0
  for y in [:64] do
    for x in [:64] do
      mVert := mVert.set! (y * 64 + x) (vertRow.getD x 0)
  let mut mObl63 := Array.replicate (64 * 64) 0
  for k in [:32] do
    let y := k * 2
    let ctr := 48 - k
    let r0 := av1InsertBorderRow av1WedgeMasterBorderEven ctr
    let r1 := av1InsertBorderRow av1WedgeMasterBorderOdd (ctr - 1)
    for x in [:64] do
      mObl63 := mObl63.set! (y * 64 + x) (r0.getD x 0)
      mObl63 := mObl63.set! ((y + 1) * 64 + x) (r1.getD x 0)
  let mObl27 := av1Transpose64 mObl63
  let mHoriz := av1Transpose64 mVert
  let mObl117 := av1Hflip64 mObl63
  let mObl153 := av1Hflip64 mObl27
  return #[mHoriz, mVert, mObl27, mObl63, mObl117, mObl153]

private def av1Copy2dMask (master : Array Nat) (inv : Bool) (w h xOff yOff : Nat) : Array Nat := Id.run do
  let mut dst := Array.replicate (w * h) 0
  for y in [:h] do
    for x in [:w] do
      let v := master.getD ((yOff + y) * 64 + xOff + x) 0
      dst := dst.set! (y * w + x) (if inv then 64 - v else v)
  return dst

private def av1InitChroma420Mask (luma : Array Nat) (roundSign : Nat) (w h : Nat) : Array Nat := Id.run do
  let cw := w / 2
  let ch := h / 2
  let mut dst := Array.replicate (cw * ch) 0
  for cy in [:ch] do
    let ly := cy * 2
    for cx in [:cw] do
      let lx := cx * 2
      let s := luma.getD (ly * w + lx) 0 + luma.getD (ly * w + lx + 1) 0 + 1 +
               luma.getD ((ly + 1) * w + lx) 0 + luma.getD ((ly + 1) * w + lx + 1) 0 + 1
      dst := dst.set! (cy * cw + cx) ((s - roundSign) / 4)
  return dst

private def av1BuildWedgeBs (w h : Nat) (cb : Array (Nat × Nat × Nat)) (signs : Nat) :
    Array (Array Nat) × Array (Array Nat) × Array (Array Nat) := Id.run do
  let masters := av1WedgeMasterTemplates
  let mut w444 : Array (Array Nat) := Array.mkEmpty 16
  let mut w420s0 : Array (Array Nat) := Array.mkEmpty 16
  let mut w420s1 : Array (Array Nat) := Array.mkEmpty 16
  for n in [:16] do
    let signBit := (signs >>> n) &&& 1
    let (dir, xo, yo) := cb.getD n (0, 4, 4)
    let xOff := 32 - ((w * xo) >>> 3)
    let yOff := 32 - ((h * yo) >>> 3)
    let m444 := av1Copy2dMask (masters.getD dir #[]) (signBit == 1) w h xOff yOff
    let cRound0 := av1InitChroma420Mask m444 0 w h
    let cRound1 := av1InitChroma420Mask m444 1 w h
    w444 := w444.push m444
    if signBit == 0 then
      w420s0 := w420s0.push cRound0
      w420s1 := w420s1.push cRound1
    else
      w420s0 := w420s0.push cRound1
      w420s1 := w420s1.push cRound0
  return (w444, w420s0, w420s1)

