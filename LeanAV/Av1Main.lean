  fh             : Av1FrameHdr := {}
  seq            : Av1SeqHdr := {}
  dec            : Av1MsacDecoder := default
  cdf            : Array Nat := #[]
  flatY          : Array Nat := #[]
  flatU          : Array Nat := #[]
  flatV          : Array Nat := #[]
  yStride        : Nat := 0
  uvStride       : Nat := 0
  w              : Nat := 0
  h              : Nat := 0
  w4             : Nat := 0
  h4             : Nat := 0
  bw             : Nat := 0
  bh             : Nat := 0
  sbStep         : Nat := 16
  sb128w         : Nat := 0
  srSb128w       : Nat := 0
  b4Stride       : Nat := 0
