private def av1BuildIiMasksForDim (w h step : Nat) : Array (Array Nat) := Id.run do
  let dc := Array.replicate (w * h) 32
  let mut mv := Array.replicate (w * h) 0
  let mut mh := Array.replicate (w * h) 0
  let mut msm := Array.replicate (w * h) 0
  for y in [:h] do
    let wy := av1IiWeights1d.getD (y * step) 1
    for x in [:w] do
      let wx := av1IiWeights1d.getD (x * step) 1
      let wsm := av1IiWeights1d.getD (Nat.min x y * step) 1
      mv := mv.set! (y * w + x) wy
      mh := mh.set! (y * w + x) wx
      msm := msm.set! (y * w + x) wsm
  return #[dc, mv, mh, msm]

