private def av1ApplyQ12Mat (mat : Array (Array Int)) (vec : Array Int) : Array Int := Id.run do
  let n := vec.size
  let mut out : Array Int := Array.mkEmpty n
  for i in [:n] do
    let row := mat.getD i #[]
    let mut acc : Int := 0
    for j in [:n] do
      acc := acc + row.getD j 0 * vec.getD j 0
    out := out.push (av1ArithShiftRight (acc + 2048) 12)
  return out

