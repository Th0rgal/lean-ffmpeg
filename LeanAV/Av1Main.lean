      if nColsOpt.isSome then
        let mut y : Nat := 0
        while y < sz4 do
          let cb := rf.r.getD ((by4 + y) * rf.rStride + (bx4 - 1)) {}
          let (s0', s1', d0', d1', c0, c1, e0, e1) := addExtCell cb same0 same1 diff0 diff1 sc0 sc1 dc0 dc1
