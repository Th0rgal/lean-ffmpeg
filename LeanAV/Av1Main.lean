        uvs := uvs.set! i uv
    cdef := { damping := dmp + 3, nBits := nb, yStrength := ys, uvStrength := uvs }
  let mut rest : Av1RestorationParams := {}
  if (!allLossless || hdr.superResEnabled) && seq.restoration && !hdr.allowIntrabc then
    let (rt0, gb54) := gb.getBits 2; gb := gb54
    let mut rt1 : Nat := 0
    let mut rt2 : Nat := 0
