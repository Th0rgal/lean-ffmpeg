                fy := fy.set! fi (fy.getD fi 0 &&& inv)
              let cl := Nat.min idx (txLpfRightEdgeY.getD (lpfYOff + (yy - starty4)) 2)
              fy := av1LfYOr fy 0 bx4Tc cl sidx smask
