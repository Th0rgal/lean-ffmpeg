    (10, 8,  8, av1WedgeCodebookHeqw, 0x7bfb)
  ]
  for (idx, w, h, cb, signs) in wedgeSpecs do
    let (w444, w420s0, w420s1) := av1BuildWedgeBs w h cb signs
    let cur := tbl.getD idx emptyEntry
    tbl := tbl.set! idx { cur with wedge444 := w444, wedge420s0 := w420s0, wedge420s1 := w420s1 }
  let ii32x32 := av1BuildIiMasksForDim 32 32 1
  let ii16x32 := av1BuildIiMasksForDim 16 32 1
  let ii16x16 := av1BuildIiMasksForDim 16 16 2
  let ii8x16  := av1BuildIiMasksForDim  8 16 2
  let ii8x8   := av1BuildIiMasksForDim  8  8 4
  let ii4x8   := av1BuildIiMasksForDim  4  8 4
  let ii4x4   := av1BuildIiMasksForDim  4  4 8
  let iiSpecs : Array (Nat × Array (Array Nat) × Array (Array Nat)) := #[
    (0, ii32x32, ii16x16),
    (1, ii32x32, ii16x16),
    (4, ii16x32, ii8x16),
    (5, ii16x16, ii8x8),
    (6, ii16x16, ii8x8),
    (9, ii8x16,  ii4x8),
    (10, ii8x8,  ii4x4)
  ]
  for (idx, i444, i420) in iiSpecs do
    let cur := tbl.getD idx emptyEntry
    tbl := tbl.set! idx { cur with ii444 := i444, ii420 := i420 }
  return tbl

@[inline]
def av1WedgeMask (c bs sign idx : Nat) : Array Nat :=
  if bs < 7 || bs > 17 then #[]
  else
    let e := av1BsMaskTable.getD (bs - 7) {
      wedge444 := #[], wedge420s0 := #[], wedge420s1 := #[], ii444 := #[], ii420 := #[]
    }
    if c == 0 then e.wedge444.getD idx #[]
    else if sign == 0 then e.wedge420s0.getD idx #[]
    else e.wedge420s1.getD idx #[]

@[inline]
def av1IiMask (c bs interintraType interintraMode wedgeIdx : Nat) : Array Nat :=
  if bs < 7 || bs > 17 then #[]
  else if interintraType == 1 then
    let e := av1BsMaskTable.getD (bs - 7) {
      wedge444 := #[], wedge420s0 := #[], wedge420s1 := #[], ii444 := #[], ii420 := #[]
    }
    if c == 0 then e.ii444.getD interintraMode #[]
    else e.ii420.getD interintraMode #[]
  else
    av1WedgeMask c bs 0 wedgeIdx

@[inline] def av1EdgeI444TopHasRight : Nat := 1
@[inline] def av1EdgeI422TopHasRight : Nat := 2
@[inline] def av1EdgeI420TopHasRight : Nat := 4
@[inline] def av1EdgeI444LeftHasBottom : Nat := 8
@[inline] def av1EdgeI422LeftHasBottom : Nat := 16
@[inline] def av1EdgeI420LeftHasBottom : Nat := 32
@[inline] def av1EdgeAllTopHasRight : Nat := 7
@[inline] def av1EdgeAllLeftHasBottom : Nat := 56

inductive Av1EdgeNode where
  | mk
      (o  : Nat)
      (h0 h1 : Nat)
      (v0 v1 : Nat)
      (h4 v4 : Nat)
      (split : Array Nat)
      (children : Array Av1EdgeNode)
  deriving Inhabited

def av1EdgeNodeO : Av1EdgeNode → Nat | .mk o _ _ _ _ _ _ _ _ => o
def av1EdgeNodeH : Av1EdgeNode → Nat → Nat
  | .mk _ h0 h1 _ _ _ _ _ _, idx => if idx == 0 then h0 else h1
def av1EdgeNodeV : Av1EdgeNode → Nat → Nat
  | .mk _ _ _ v0 v1 _ _ _ _, idx => if idx == 0 then v0 else v1
def av1EdgeNodeH4 : Av1EdgeNode → Nat | .mk _ _ _ _ _ h4 _ _ _ => h4
def av1EdgeNodeV4 : Av1EdgeNode → Nat | .mk _ _ _ _ _ _ v4 _ _ => v4
def av1EdgeNodeSplit : Av1EdgeNode → Array Nat | .mk _ _ _ _ _ _ _ sp _ => sp
def av1EdgeNodeChildren : Av1EdgeNode → Array Av1EdgeNode | .mk _ _ _ _ _ _ _ _ ch => ch

def buildAv1EdgeNode : Nat → Nat → Bool → Bool → Av1EdgeNode
  | 0, _, topHasRight, leftHasBottom =>
    let ef := (if topHasRight then av1EdgeAllTopHasRight else 0) |||
              (if leftHasBottom then av1EdgeAllLeftHasBottom else 0)
    let h0 := ef ||| av1EdgeAllLeftHasBottom
    let h1 := ef &&& (av1EdgeAllLeftHasBottom ||| av1EdgeI420TopHasRight)
    let v0 := ef ||| av1EdgeAllTopHasRight
    let v1 := ef &&& (av1EdgeAllTopHasRight ||| av1EdgeI420LeftHasBottom ||| av1EdgeI422LeftHasBottom)
    let sp0 := (ef &&& av1EdgeAllTopHasRight) ||| av1EdgeI422LeftHasBottom
    let sp1 := ef ||| av1EdgeI444TopHasRight
    let sp2 := ef &&& (av1EdgeI420TopHasRight ||| av1EdgeI420LeftHasBottom ||| av1EdgeI422LeftHasBottom)
    Av1EdgeNode.mk ef h0 h1 v0 v1 0 0 #[sp0, sp1, sp2] #[]
  | fuel + 1, bl, topHasRight, leftHasBottom =>
    let ef := (if topHasRight then av1EdgeAllTopHasRight else 0) |||
              (if leftHasBottom then av1EdgeAllLeftHasBottom else 0)
    if bl >= 4 then
      let h0 := ef ||| av1EdgeAllLeftHasBottom
      let h1 := ef &&& (av1EdgeAllLeftHasBottom ||| av1EdgeI420TopHasRight)
      let v0 := ef ||| av1EdgeAllTopHasRight
      let v1 := ef &&& (av1EdgeAllTopHasRight ||| av1EdgeI420LeftHasBottom ||| av1EdgeI422LeftHasBottom)
      let sp0 := (ef &&& av1EdgeAllTopHasRight) ||| av1EdgeI422LeftHasBottom
      let sp1 := ef ||| av1EdgeI444TopHasRight
      let sp2 := ef &&& (av1EdgeI420TopHasRight ||| av1EdgeI420LeftHasBottom ||| av1EdgeI422LeftHasBottom)
      Av1EdgeNode.mk ef h0 h1 v0 v1 0 0 #[sp0, sp1, sp2] #[]
    else
      let h0 := ef ||| av1EdgeAllLeftHasBottom
      let h1 := ef &&& av1EdgeAllLeftHasBottom
      let v0 := ef ||| av1EdgeAllTopHasRight
      let v1 := ef &&& av1EdgeAllTopHasRight
      let h4 := av1EdgeAllLeftHasBottom |||
                (if bl == 3 then ef &&& av1EdgeI420TopHasRight else 0)
      let v4 := av1EdgeAllTopHasRight |||
                (if bl == 3 then ef &&& (av1EdgeI420LeftHasBottom ||| av1EdgeI422LeftHasBottom) else 0)
      let c0 := buildAv1EdgeNode fuel (bl + 1) true true
      let c1 := buildAv1EdgeNode fuel (bl + 1) topHasRight false
      let c2 := buildAv1EdgeNode fuel (bl + 1) true leftHasBottom
      let c3 := buildAv1EdgeNode fuel (bl + 1) false false
      Av1EdgeNode.mk ef h0 h1 v0 v1 h4 v4 #[] #[c0, c1, c2, c3]

def av1IntraEdgeTree : Array Av1EdgeNode :=
  #[buildAv1EdgeNode 6 0 true false, buildAv1EdgeNode 6 1 true false]

def av1Ulog2 (v : Nat) : Nat :=
  if v <= 1 then 0
  else
    let rec go (fuel x acc : Nat) : Nat :=
      match fuel with
      | 0 => acc
      | f + 1 => if x <= 1 then acc else go f (x >>> 1) (acc + 1)
    go 64 v 0

@[inline]
def av1BitLength32 (v : Nat) : Nat :=
  if v == 0 then 0 else av1Ulog2 v + 1

@[inline]
def av1Clz32 (v : Nat) : Nat :=
  let bl := av1BitLength32 v
  if bl >= 32 then 0 else 32 - bl

@[inline]
def av1InvRecenter (r v : Nat) : Nat :=
  if v > (r <<< 1) then v
  else if (v &&& 1) == 0 then r + (v >>> 1)
  else r - ((v + 1) >>> 1)

@[inline]
def av1RecenterNonneg (r v : Nat) : Nat :=
  if v > (r <<< 1) then v
  else if v >= r then (v - r) <<< 1
  else ((r - v) <<< 1) - 1

@[inline]
def av1Iclip (v lo hi : Int) : Int :=
  if v < lo then lo else if v > hi then hi else v

@[inline]
def av1IclipU8 (v : Int) : Nat :=
  if v <= 0 then 0 else if v >= 255 then 255 else v.toNat

@[inline]
def av1ApplySign (v s : Int) : Int :=
  if s < 0 then -v else if s > 0 then v else 0

def av1LastNonzeroColFromEob : Array (Array Nat) := Id.run do
  let mut out : Array (Array Nat) := Array.mkEmpty 19
  for tx in [:19] do
    let sc := av1ScanForTx tx
    if sc.isEmpty then
      out := out.push #[]
    else
      let h := Nat.min (av1TxfmDim.getD (tx * 8 + 1) 1) 8 * 4
      let mut arr : Array Nat := Array.mkEmpty sc.size
      let mut mx : Nat := 0
      for rc in sc do
        let c := rc &&& (h - 1)
        if c > mx then mx := c
        arr := arr.push mx
      out := out.push arr
  return out

def av1DefaultCoefCdfAll : Array (Array Nat) :=
  #[av1DefaultCoefCdf0, av1DefaultCoefCdf1, av1DefaultCoefCdf2, av1DefaultCoefCdf3]

def av1InitDefaultCdf (qcat : Nat) : Array Nat := Id.run do
  let mut cdf := Array.replicate 6736 0
  let coef := av1DefaultCoefCdfAll.getD (Nat.min qcat 3) av1DefaultCoefCdf0
  for i in [:3056] do
    cdf := cdf.set! i (coef.getD i 0)
  for i in [:3136] do
    cdf := cdf.set! (3056 + i) (av1DefaultModeCdf.getD i 0)
  for i in [:144] do
    cdf := cdf.set! (6192 + i) (av1DefaultMvCdf.getD i 0)
  for i in [:400] do
    cdf := cdf.set! (6336 + i) (av1DefaultKfymCdf.getD i 0)
  return cdf

private def av1ApplyZeroRuns (cdf : Array Nat) (runs : Array (Nat × Nat × Nat)) : Array Nat := Id.run do
  let mut out := cdf
  for (startIdx, step, cnt) in runs do
    for k in [:cnt] do
      out := out.set! (startIdx + k * step) 0
  return out

def av1CdfThreadUpdate (dst src : Array Nat) (isKeyOrIntra : Bool) : Array Nat := Id.run do
  let mut out := dst
  for i in [:5458] do
    out := out.set! i (src.getD i 0)
  if isKeyOrIntra then
    out := av1ApplyZeroRuns out av1CdfKfZeroRuns
  else
    for i in [5472:6336] do
      out := out.set! i (src.getD i 0)
    out := av1ApplyZeroRuns out av1CdfKfZeroRuns
    out := av1ApplyZeroRuns out av1CdfInterExtraZeroRuns
  return out

structure Av1BitReader where
  data   : ByteArray
  endIdx : Nat
  bitPos : Nat
  err    : Bool
  deriving Inhabited

namespace Av1BitReader

def init (data : ByteArray) (offset : Nat := 0) (lenOpt : Option Nat := none) : Av1BitReader :=
  let endIdx := match lenOpt with
    | none => data.size
    | some l => Nat.min data.size (offset + l)
  { data := data, endIdx := endIdx, bitPos := offset * 8, err := false }

@[inline]
def bitsLeft (br : Av1BitReader) : Nat :=
  let tot := br.endIdx * 8
  if br.bitPos <= tot then tot - br.bitPos else 0

@[inline]
def getBit (br : Av1BitReader) : Nat × Av1BitReader :=
  if br.bitPos >= br.endIdx * 8 then
    (0, { br with err := true })
  else
    let byteIdx := br.bitPos >>> 3
    let bitIdx := 7 - (br.bitPos &&& 7)
    let b := ((br.data.get! byteIdx).toNat >>> bitIdx) &&& 1
    (b, { br with bitPos := br.bitPos + 1 })

def getBits (br : Av1BitReader) (n : Nat) : Nat × Av1BitReader := Id.run do
  let mut cur := br
  let mut v : Nat := 0
  for _ in [:n] do
    let (b, next) := cur.getBit
    cur := next
    v := (v <<< 1) ||| b
  return (v, cur)

def getSBits (br : Av1BitReader) (n : Nat) : Int × Av1BitReader :=
  if n == 0 then (0, br)
  else
    let (v, br') := br.getBits n
    let signBit := 1 <<< (n - 1)
    let sv : Int := if (v &&& signBit) != 0 then (Int.ofNat v) - (Int.ofNat (1 <<< n)) else Int.ofNat v
    (sv, br')

def getUniform (br : Av1BitReader) (maxVal : Nat) : Nat × Av1BitReader :=
  if maxVal <= 1 then (0, br)
  else
    let l := av1Ulog2 maxVal + 1
    let m := (1 <<< l) - maxVal
    let (v, br1) := br.getBits (l - 1)
    if v < m then (v, br1)
    else
      let (b, br2) := br1.getBit
      (((v <<< 1) - m + b), br2)

def getVlc (br : Av1BitReader) : Nat × Av1BitReader := Id.run do
  let mut cur := br
  let mut nBits : Nat := 0
  let mut done := false
  while !done do
    let (b, next) := cur.getBit
    cur := next
    if b != 0 then
      done := true
    else
      nBits := nBits + 1
      if nBits >= 32 then
        return (0xFFFFFFFF, { cur with err := true })
  if nBits == 0 then
    return (0, cur)
  let (tail, cur2) := cur.getBits nBits
  return (((1 <<< nBits) - 1) + tail, cur2)

def av1InvRecenterInt (r : Int) (v : Nat) : Int :=
  let vn : Int := Int.ofNat v
  if vn > r * 2 then vn
  else if (v &&& 1) == 0 then r + Int.ofNat (v >>> 1)
  else r - Int.ofNat ((v + 1) >>> 1)

def getSubexpSigned (br : Av1BitReader) (refVal : Int) (n : Nat) : Int × Av1BitReader := Id.run do
  let mut cur := br
  let mut v : Nat := 0
  let mut i : Nat := 0
  let k : Nat := 3
  let nn : Int := Int.ofNat n
  for _ in [:32] do
    let b := if i > 0 then k + i - 1 else k
    if n < v + 3 * (1 <<< b) then
      let (u, next) := cur.getUniform (n - v + 1)
      v := v + u
      cur := next
      let res := if refVal * 2 <= nn then av1InvRecenterInt refVal v
                 else nn - av1InvRecenterInt (nn - refVal) v
      return (res, cur)
    let (bit, next1) := cur.getBit
    cur := next1
    if bit == 0 then
      let (bits, next2) := cur.getBits b
      v := v + bits
      cur := next2
      let res := if refVal * 2 <= nn then av1InvRecenterInt refVal v
                 else nn - av1InvRecenterInt (nn - refVal) v
      return (res, cur)
    v := v + (1 <<< b)
    i := i + 1
  return (0, { cur with err := true })

def getSubexp (br : Av1BitReader) (refVal n : Nat) : Nat × Av1BitReader :=
  let (res, br') := getSubexpSigned br (Int.ofNat refVal) n
  (res.toNat, br')

def byteAlign (br : Av1BitReader) : Av1BitReader :=
  let rem := br.bitPos &&& 7
  if rem == 0 then br else { br with bitPos := br.bitPos + (8 - rem) }

def checkTrailingBits (br : Av1BitReader) : Bool × Av1BitReader :=
  let (b1, br1) := br.getBit
  if b1 != 1 then (false, br1)
  else
    let rem := (8 - (br1.bitPos &&& 7)) &&& 7
    if rem == 0 then (!br1.err, br1)
    else
      let (pad, br2) := br1.getBits rem
      (pad == 0 && !br2.err, br2)

def readLeb128U32 (br : Av1BitReader) : Option (Nat × Av1BitReader) := Id.run do
  if (br.bitPos &&& 7) != 0 then return none
  let mut cur := br
  let mut val : Nat := 0
  for i in [:8] do
    if cur.bitPos + 8 > cur.endIdx * 8 then return none
    let (byteVal, next) := cur.getBits 8
    cur := next
    val := val ||| ((byteVal &&& 0x7F) <<< (i * 7))
    if val >= (1 <<< 32) then return none
    if (byteVal &&& 0x80) == 0 then
      return some (val, cur)
  return none

end Av1BitReader

structure Av1BitWriter where
  bits : Array UInt8
  deriving Inhabited

namespace Av1BitWriter

def empty : Av1BitWriter := { bits := #[] }

@[inline]
def putBit (bw : Av1BitWriter) (b : Nat) : Av1BitWriter :=
  { bits := bw.bits.push (b &&& 1).toUInt8 }

def putBits (bw : Av1BitWriter) (v n : Nat) : Av1BitWriter := Id.run do
  let mut arr := bw.bits
  for k in [:n] do
    let shift := n - 1 - k
    arr := arr.push (((v >>> shift) &&& 1).toUInt8)
  return { bits := arr }

def putSBits (bw : Av1BitWriter) (v : Int) (n : Nat) : Av1BitWriter :=
  if n == 0 then bw
  else
    let uv : Nat := if v < 0 then (v + Int.ofNat (1 <<< n)).toNat else v.toNat
    bw.putBits uv n

def putUniform (bw : Av1BitWriter) (v maxVal : Nat) : Av1BitWriter :=
  if maxVal <= 1 then bw
  else
    let l := av1Ulog2 maxVal + 1
    let m := (1 <<< l) - maxVal
    if v < m then bw.putBits v (l - 1)
    else
      let x := v + m
      (bw.putBits (x >>> 1) (l - 1)).putBit (x &&& 1)

def putVlc (bw : Av1BitWriter) (v : Nat) : Av1BitWriter := Id.run do
  let v1 := v + 1
  let n := av1Ulog2 v1
  let mut cur := bw
  for _ in [:n] do
    cur := cur.putBit 0
  cur := cur.putBit 1
  if n > 0 then
    cur := cur.putBits (v1 - (1 <<< n)) n
  return cur

def putSubexpSigned (bw : Av1BitWriter) (refVal : Int) (v : Int) (n : Nat) : Av1BitWriter :=
  let nn : Int := Int.ofNat n
  let raw : Nat :=
    if refVal * 2 <= nn then av1RecenterNonneg refVal.toNat v.toNat
    else av1RecenterNonneg (nn - refVal).toNat (nn - v).toNat
  Id.run do
    let mut cur := bw
    let mut acc : Nat := 0
    let mut i : Nat := 0
    let k : Nat := 3
    for _ in [:32] do
      let b := if i > 0 then k + i - 1 else k
      if n < acc + 3 * (1 <<< b) then
        return cur.putUniform (raw - acc) (n - acc + 1)
      let span := 1 <<< b
      if raw < acc + span then
        cur := cur.putBit 0
        return cur.putBits (raw - acc) b
      cur := cur.putBit 1
      acc := acc + span
      i := i + 1
    return cur

def putSubexp (bw : Av1BitWriter) (refVal v n : Nat) : Av1BitWriter :=
  putSubexpSigned bw (Int.ofNat refVal) (Int.ofNat v) n

def byteAlignZero (bw : Av1BitWriter) : Av1BitWriter := Id.run do
  let mut arr := bw.bits
  while (arr.size &&& 7) != 0 do
    arr := arr.push 0
  return { bits := arr }

def addTrailingBits (bw : Av1BitWriter) : Av1BitWriter :=
  (bw.putBit 1).byteAlignZero

def toBytes (bw : Av1BitWriter) : ByteArray := Id.run do
  let aligned := bw.byteAlignZero.bits
  let nBytes := aligned.size >>> 3
  let mut out := ByteArray.emptyWithCapacity nBytes
  for i in [:nBytes] do
    let mut b : UInt8 := 0
    for j in [:8] do
      if aligned.getD (i * 8 + j) 0 != 0 then
        b := b ||| ((1 : UInt8) <<< (7 - j).toUInt8)
    out := out.push b
  return out

end Av1BitWriter

@[inline] def av1EcProbShift : Nat := 6
@[inline] def av1EcMinProb : Nat := 4
@[inline] def av1EcWinSize : Int := 64
@[inline] def av1EcWinMask : UInt64 := 0xFFFFFFFFFFFFFFFF

structure Av1MsacDecoder where
  data           : ByteArray
  pos            : Nat
  endIdx         : Nat
  dif            : UInt64
  rng            : Nat
  cnt            : Int
  allowUpdateCdf : Bool
  deriving Inhabited

namespace Av1MsacDecoder

def refill (s : Av1MsacDecoder) : Av1MsacDecoder := Id.run do
  let mut c : Int := av1EcWinSize - s.cnt - 24
  let mut dif : UInt64 := s.dif
  let mut pos : Nat := s.pos
  let endIdx := s.endIdx
  for _ in [:16] do
    if pos >= endIdx then
      if c >= 64 then
        dif := av1EcWinMask
      else if c >= 0 then
        let cu := c.toNat.toUInt64
        let mask : UInt64 := (av1EcWinMask ^^^ (0xFF : UInt64)) <<< cu
        dif := dif ||| (av1EcWinMask ^^^ mask)
      return { s with dif := dif, cnt := av1EcWinSize - c - 24, pos := pos }
    let byteXor : UInt64 := ((s.data.get! pos) ^^^ 0xFF).toUInt64
    let cu := c.toNat.toUInt64
    dif := dif ||| (byteXor <<< cu)
    pos := pos + 1
    c := c - 8
    if c < 0 then
      return { s with dif := dif, cnt := av1EcWinSize - c - 24, pos := pos }
  return { s with dif := dif, cnt := av1EcWinSize - c - 24, pos := pos }

def init (data : ByteArray) (offset sz : Nat) (disableCdfUpdate : Bool) : Av1MsacDecoder :=
  let endIdx := Nat.min data.size (offset + sz)
  let s0 : Av1MsacDecoder := {
    data := data
    pos := offset
    endIdx := endIdx
    dif := 0
    rng := 0x8000
    cnt := -15
    allowUpdateCdf := !disableCdfUpdate
  }
  s0.refill

@[inline]
def norm (s : Av1MsacDecoder) (dif : UInt64) (rng : Nat) : Av1MsacDecoder :=
  let d : Nat := 15 ^^^ (31 ^^^ av1Clz32 rng)
  let cnt0 : Int := s.cnt
  let dif' : UInt64 := dif <<< d.toUInt64
  let rng' : Nat := rng <<< d
  let cnt' : Int := cnt0 - Int.ofNat d
  let s1 := { s with dif := dif', rng := rng', cnt := cnt' }
  if (0 : Int) <= cnt0 && cnt0 < Int.ofNat d then s1.refill else s1

def decodeBoolEqui (s : Av1MsacDecoder) : Nat × Av1MsacDecoder :=
  let r := s.rng
  let dif := s.dif
  let v : Nat := ((r >>> 8) <<< 7) + av1EcMinProb
  let vw : UInt64 := v.toUInt64 <<< 48
  if dif >= vw then
    (0, s.norm (dif - vw) (r - v))
  else
    (1, s.norm dif v)

def decodeBool (s : Av1MsacDecoder) (f : Nat) : Nat × Av1MsacDecoder :=
  let r := s.rng
  let dif := s.dif
  let v : Nat := (((r >>> 8) * (f >>> av1EcProbShift)) >>> (7 - av1EcProbShift)) + av1EcMinProb
  let vw : UInt64 := v.toUInt64 <<< 48
  if dif >= vw then
    (0, s.norm (dif - vw) (r - v))
  else
    (1, s.norm dif v)

def decodeBoolAdapt (s : Av1MsacDecoder) (cdf : Array Nat) (base : Nat) :
    Nat × Av1MsacDecoder × Array Nat :=
  let f := cdf.getD base 16384
  let (bit, s1) := s.decodeBool f
  if !s1.allowUpdateCdf then
    (bit, s1, cdf)
  else
    let count := cdf.getD (base + 1) 0
    let rate := 4 + (count >>> 4)
    let f' := if bit != 0 then f + ((32768 - f) >>> rate) else f - (f >>> rate)
    let cdf1 := cdf.set! base f'
    let cdf2 := if count < 32 then cdf1.set! (base + 1) (count + 1) else cdf1
    (bit, s1, cdf2)

def decodeSymbolAdapt (s : Av1MsacDecoder) (cdf : Array Nat) (base nSymbols : Nat) :
    Nat × Av1MsacDecoder × Array Nat := Id.run do
  let c : Nat := (s.dif >>> 48).toNat
  let r : Nat := s.rng >>> 8
  let mut v : Nat := s.rng
  let mut u : Nat := s.rng
  let mut val : Nat := 0
  for k in [:nSymbols + 1] do
    val := k
    u := v
    if k == nSymbols then
      v := 0
      break
    let fk := cdf.getD (base + k) 0
    v := ((r * (fk >>> av1EcProbShift)) >>> (7 - av1EcProbShift)) + av1EcMinProb * (nSymbols - k)
    if c >= v then
      break
  let s1 := s.norm (s.dif - (v.toUInt64 <<< 48)) (u - v)
  if !s1.allowUpdateCdf then
    return (val, s1, cdf)
  let mut cdf' := cdf
  let count := cdf'.getD (base + nSymbols) 0
  let rate := 4 + (count >>> 4) + (if nSymbols > 2 then 1 else 0)
  for i in [:val] do
    let fi := cdf'.getD (base + i) 0
    cdf' := cdf'.set! (base + i) (fi + ((32768 - fi) >>> rate))
  for i in [val:nSymbols] do
    let fi := cdf'.getD (base + i) 0
    cdf' := cdf'.set! (base + i) (fi - (fi >>> rate))
  if count < 32 then
    cdf' := cdf'.set! (base + nSymbols) (count + 1)
  return (val, s1, cdf')

def decodeHiTok (s : Av1MsacDecoder) (cdf : Array Nat) (base : Nat) :
    Nat × Av1MsacDecoder × Array Nat :=
  let (br0, s1, cdf1) := s.decodeSymbolAdapt cdf base 3
  let tok0 := 3 + br0
  if br0 != 3 then (tok0, s1, cdf1)
  else
    let (br1, s2, cdf2) := s1.decodeSymbolAdapt cdf1 base 3
    let tok1 := 6 + br1
    if br1 != 3 then (tok1, s2, cdf2)
    else
      let (br2, s3, cdf3) := s2.decodeSymbolAdapt cdf2 base 3
      let tok2 := 9 + br2
      if br2 != 3 then (tok2, s3, cdf3)
      else
        let (br3, s4, cdf4) := s3.decodeSymbolAdapt cdf3 base 3
        (12 + br3, s4, cdf4)

def decodeBools (s : Av1MsacDecoder) (n : Nat) : Nat × Av1MsacDecoder := Id.run do
  let mut cur := s
  let mut v : Nat := 0
  for _ in [:n] do
    let (b, next) := cur.decodeBoolEqui
    cur := next
    v := (v <<< 1) ||| b
  return (v, cur)

def decodeUniform (s : Av1MsacDecoder) (n : Nat) : Nat × Av1MsacDecoder :=
  if n <= 1 then (0, s)
  else
    let l := av1Ulog2 n + 1
    let m := (1 <<< l) - n
    let (v, s1) := s.decodeBools (l - 1)
    if v < m then (v, s1)
    else
      let (b, s2) := s1.decodeBoolEqui
      (((v <<< 1) - m + b), s2)

def decodeSubexp (s : Av1MsacDecoder) (refVal n k0 : Nat) : Nat × Av1MsacDecoder :=
  let (b0, s1) := s.decodeBoolEqui
  let (a, k, s3) :=
    if b0 == 0 then (0, k0, s1)
    else
      let (b1, s2) := s1.decodeBoolEqui
      if b1 == 0 then (1 <<< k0, k0, s2)
      else
        let (b2, s2') := s2.decodeBoolEqui
        let k' := k0 + b2 + 1
        (1 <<< k', k', s2')
  let (bits, s4) := s3.decodeBools k
  let v := bits + a
  let res := if refVal * 2 <= n then av1InvRecenter refVal v
             else (n - 1) - av1InvRecenter ((n - 1) - refVal) v
  (res, s4)

end Av1MsacDecoder

structure Av1MsacEncoder where
  low            : Nat
  rng            : Nat
  cnt            : Nat
  allowUpdateCdf : Bool
  deriving Inhabited

namespace Av1MsacEncoder

def init (disableCdfUpdate : Bool := false) : Av1MsacEncoder :=
  { low := 0, rng := 0x8000, cnt := 0, allowUpdateCdf := !disableCdfUpdate }

@[inline]
def norm (e : Av1MsacEncoder) (low rng : Nat) : Av1MsacEncoder :=
  let d := 15 - av1Ulog2 rng
  { e with low := low <<< d, rng := rng <<< d, cnt := e.cnt + d }

def finalize (enc : Av1MsacEncoder) : ByteArray := Id.run do
  let e0 : Nat := (((enc.low + 0x4000) >>> 15) <<< 15) ||| 0x3FFF
  let nbytes : Nat := (enc.cnt + 8) >>> 3
  let rem : Int := Int.ofNat (nbytes <<< 3) - Int.ofNat (15 + enc.cnt)
  let eFinal : Nat :=
    if rem > 0 then
      let r := rem.toNat
      (e0 <<< r) ||| ((1 <<< r) - 1)
    else if rem < 0 then
      let r := (-rem).toNat
      e0 >>> r
    else e0
  let mut out := ByteArray.emptyWithCapacity nbytes
  for i in [:nbytes] do
    let shift := (nbytes - 1 - i) * 8
    let invByte : UInt8 := ((eFinal >>> shift) &&& 0xFF).toUInt8
    out := out.push (invByte ^^^ 0xFF)
  return out

def encodeBool (enc : Av1MsacEncoder) (val f : Nat) : Av1MsacEncoder :=
  let r := enc.rng
  let low := enc.low
  let v := (((r >>> 8) * (f >>> av1EcProbShift)) >>> (7 - av1EcProbShift)) + av1EcMinProb
  if val != 0 then enc.norm low v else enc.norm (low + v) (r - v)

def encodeBoolEqui (enc : Av1MsacEncoder) (val : Nat) : Av1MsacEncoder :=
  let r := enc.rng
  let low := enc.low
  let v := ((r >>> 8) <<< 7) + av1EcMinProb
  if val != 0 then enc.norm low v else enc.norm (low + v) (r - v)

def encodeBoolAdapt (enc : Av1MsacEncoder) (val : Nat) (cdf : Array Nat) (base : Nat) :
    Av1MsacEncoder × Array Nat :=
  let f := cdf.getD base 16384
  let enc1 := enc.encodeBool val f
  if !enc1.allowUpdateCdf then (enc1, cdf)
  else
    let count := cdf.getD (base + 1) 0
    let rate := 4 + (count >>> 4)
    let f' := if val != 0 then f + ((32768 - f) >>> rate) else f - (f >>> rate)
    let cdf1 := cdf.set! base f'
    let cdf2 := if count < 32 then cdf1.set! (base + 1) (count + 1) else cdf1
    (enc1, cdf2)

def encodeSymbolAdapt (enc : Av1MsacEncoder) (val : Nat) (cdf : Array Nat) (base nSymbols : Nat) :
    Av1MsacEncoder × Array Nat := Id.run do
  let r := enc.rng >>> 8
  let u :=
    if val > 0 then
      let fPrev := cdf.getD (base + val - 1) 0
      ((r * (fPrev >>> av1EcProbShift)) >>> (7 - av1EcProbShift)) + av1EcMinProb * (nSymbols - (val - 1))
    else enc.rng
  let v :=
    if val >= nSymbols then 0
    else
      let fCur := cdf.getD (base + val) 0
      ((r * (fCur >>> av1EcProbShift)) >>> (7 - av1EcProbShift)) + av1EcMinProb * (nSymbols - val)
  let enc1 := enc.norm (enc.low + v) (u - v)
  if !enc1.allowUpdateCdf then return (enc1, cdf)
  let mut cdf' := cdf
  let count := cdf'.getD (base + nSymbols) 0
  let rate := 4 + (count >>> 4) + (if nSymbols > 2 then 1 else 0)
  for i in [:val] do
    let fi := cdf'.getD (base + i) 0
    cdf' := cdf'.set! (base + i) (fi + ((32768 - fi) >>> rate))
  for i in [val:nSymbols] do
    let fi := cdf'.getD (base + i) 0
    cdf' := cdf'.set! (base + i) (fi - (fi >>> rate))
  if count < 32 then
    cdf' := cdf'.set! (base + nSymbols) (count + 1)
  return (enc1, cdf')

def encodeBools (enc : Av1MsacEncoder) (v n : Nat) : Av1MsacEncoder := Id.run do
  let mut cur := enc
  for k in [:n] do
    let shift := n - 1 - k
    cur := cur.encodeBoolEqui ((v >>> shift) &&& 1)
  return cur

def encodeUniform (enc : Av1MsacEncoder) (v n : Nat) : Av1MsacEncoder :=
  if n <= 1 then enc
  else
    let l := av1Ulog2 n + 1
    let m := (1 <<< l) - n
    if v < m then enc.encodeBools v (l - 1)
    else
      let x := v + m
      (enc.encodeBools (x >>> 1) (l - 1)).encodeBoolEqui (x &&& 1)

def encodeHiTok (enc : Av1MsacEncoder) (tok : Nat) (cdf : Array Nat) (base : Nat) :
    Av1MsacEncoder × Array Nat := Id.run do
  let mut rem := tok - 3
  let mut cur := enc
  let mut cdf' := cdf
  for _ in [:3] do
    if rem < 3 then
      return cur.encodeSymbolAdapt rem cdf' base 3
    let (next, cNext) := cur.encodeSymbolAdapt 3 cdf' base 3
    cur := next
    cdf' := cNext
    rem := rem - 3
  return cur.encodeSymbolAdapt (Nat.min rem 3) cdf' base 3

end Av1MsacEncoder

@[inline] def av1ObuSeqHdr : Nat := 1
@[inline] def av1ObuTd : Nat := 2
@[inline] def av1ObuFrameHdr : Nat := 3
@[inline] def av1ObuTileGrp : Nat := 4
@[inline] def av1ObuMetadata : Nat := 5
@[inline] def av1ObuFrame : Nat := 6
@[inline] def av1ObuRedundantFrameHdr : Nat := 7
@[inline] def av1ObuPadding : Nat := 15

@[inline] def av1FrameKey : Nat := 0
@[inline] def av1FrameInter : Nat := 1
@[inline] def av1FrameIntra : Nat := 2
@[inline] def av1FrameSwitch : Nat := 3

@[inline] def av1PrimaryRefNone : Nat := 7
@[inline] def av1Adaptive : Nat := 2

def av1EncodeLeb128 (val : Nat) : ByteArray := Id.run do
  if val == 0 then
    return ByteArray.mk #[0]
  let mut out := ByteArray.emptyWithCapacity 5
  let mut v := val
  for _ in [:8] do
    if v == 0 then
      return out
    let b := v &&& 0x7F
    v := v >>> 7
    let byteVal : UInt8 := (if v > 0 then b ||| 0x80 else b).toUInt8
    out := out.push byteVal
  return out

def av1DecodeLeb128 (data : ByteArray) (pos : Nat) : Option (Nat × Nat) := Id.run do
  let mut val : Nat := 0
  for i in [:8] do
    if pos + i >= data.size then
      return none
    let b := (data.get! (pos + i)).toNat
    val := val ||| ((b &&& 0x7F) <<< (7 * i))
    if (b &&& 0x80) == 0 then
      if val >= (1 <<< 32) then
        return none
      return some (val, pos + i + 1)
  return none

def av1WrapObu (obuType : Nat) (payload : ByteArray) (hasSize : Bool := true) : ByteArray :=
  let hdrByte : UInt8 := (((obuType &&& 0xF) <<< 3) ||| (if hasSize then 0x02 else 0x00)).toUInt8
  let head := ByteArray.mk #[hdrByte]
  if hasSize then
    head ++ av1EncodeLeb128 payload.size ++ payload
  else
    head ++ payload

structure Av1ObuPacket where
  obuType    : Nat
  temporalId : Nat
  spatialId  : Nat
  hasSize    : Bool
  payload    : ByteArray
  deriving Inhabited, DecidableEq

def av1ParseObus (data : ByteArray) : Option (Array Av1ObuPacket) := Id.run do
  let mut obus : Array Av1ObuPacket := #[]
  let mut pos : Nat := 0
  let n := data.size
  while pos < n do
    let hdr := (data.get! pos).toNat
    pos := pos + 1
    if (hdr &&& 0x80) != 0 then
      return none
    let obuType := (hdr >>> 3) &&& 0xF
    let hasExt := ((hdr >>> 2) &&& 1) != 0
    let hasSize := ((hdr >>> 1) &&& 1) != 0
    if (hdr &&& 1) != 0 then
      return none
    let mut temporalId : Nat := 0
    let mut spatialId : Nat := 0
    if hasExt then
      if pos >= n then
        return none
      let ext := (data.get! pos).toNat
      pos := pos + 1
      temporalId := (ext >>> 5) &&& 7
      spatialId := (ext >>> 3) &&& 3
      if (ext &&& 7) != 0 then
        return none
    if hasSize then
      match av1DecodeLeb128 data pos with
      | none => return none
      | some (sz, nextPos) =>
        if nextPos + sz > n then
          return none
        let payload := data.extract nextPos (nextPos + sz)
        pos := nextPos + sz
        obus := obus.push { obuType := obuType, temporalId := temporalId, spatialId := spatialId, hasSize := true, payload := payload }
    else
      let payload := data.extract pos n
      pos := n
      obus := obus.push { obuType := obuType, temporalId := temporalId, spatialId := spatialId, hasSize := false, payload := payload }
  return some obus

def av1GetPocDiff (orderHintNBits : Nat) (poc0 poc1 : Int) : Int :=
  if orderHintNBits == 0 then 0
  else
    let mask : Int := Int.ofNat (1 <<< (orderHintNBits - 1))
    let full : Int := mask * 2
    let rem : Int := ((poc0 - poc1) % full + full) % full
    if rem >= mask then rem - full else rem

def av1TileLog2 (sz tgt : Nat) : Nat :=
  let rec go (fuel k : Nat) : Nat :=
    match fuel with
    | 0 => k
    | f + 1 => if (sz <<< k) < tgt then go f (k + 1) else k
  go 32 0

structure Av1OperatingPoint where
  idc                      : Nat := 0
  majorLevel               : Nat := 0
  minorLevel               : Nat := 0
  tier                     : Nat := 0
  decoderModelParamPresent : Bool := false
  deriving Inhabited, Repr, DecidableEq

structure Av1SeqHdr where
  profile                         : Nat := 0
  stillPicture                    : Bool := false
  reducedStillPictureHeader       : Bool := false
  timingInfoPresent               : Bool := false
  decoderModelInfoPresent         : Bool := false
  equalPictureInterval            : Bool := false
  encoderDecoderBufferDelayLength : Nat := 0
  bufferRemovalDelayLength        : Nat := 0
  framePresentationDelayLength    : Nat := 0
  displayModelInfoPresent         : Bool := false
  numOperatingPoints              : Nat := 1
  operatingPoints                 : Array Av1OperatingPoint := #[]
  widthNBits                      : Nat := 1
  heightNBits                     : Nat := 1
  maxWidth                        : Nat := 1
  maxHeight                       : Nat := 1
  frameIdNumbersPresent           : Bool := false
  deltaFrameIdNBits               : Nat := 0
  frameIdNBits                    : Nat := 0
  sb128                           : Nat := 0
  filterIntra                     : Bool := false
  intraEdgeFilter                 : Bool := false
  interIntra                      : Bool := false
  maskedCompound                  : Bool := false
  warpedMotion                    : Bool := false
  dualFilter                      : Bool := false
  orderHint                       : Bool := false
  jntComp                         : Bool := false
  refFrameMvs                     : Bool := false
  screenContentTools              : Nat := 0
  forceIntegerMv                  : Nat := 0
  orderHintNBits                  : Nat := 0
  superRes                        : Bool := false
  cdef                            : Bool := false
  restoration                     : Bool := false
  hbd                             : Nat := 0
  monochrome                      : Bool := false
  colorDescriptionPresent         : Bool := false
  pri                             : Nat := 2
  trc                             : Nat := 2
  mtrx                            : Nat := 2
  colorRange                      : Nat := 0
  ssHor                           : Nat := 1
  ssVer                           : Nat := 1
  layout                          : Nat := 1
  chr                             : Nat := 0
  separateUvDeltaQ                : Bool := false
  filmGrainPresent                : Bool := false
  isMain8Bit420                   : Bool := false
  deriving Inhabited, Repr, DecidableEq

def av1ParseSeqHdr (payload : ByteArray) (strict : Bool := true) : Option Av1SeqHdr := Id.run do
  if payload.isEmpty then
    return none
  let mut gb := Av1BitReader.init payload
  let (profile, gb1) := gb.getBits 3; gb := gb1
  let (spBit, gb2) := gb.getBit; gb := gb2
  let (rspBit, gb3) := gb.getBit; gb := gb3
  let stillPicture := spBit != 0
  let reducedStill := rspBit != 0
  if profile > 2 then
    return none
  if reducedStill && !stillPicture then
    return none
  let mut h : Av1SeqHdr := {
    profile := profile
    stillPicture := stillPicture
    reducedStillPictureHeader := reducedStill
  }
  if reducedStill then
    let (maj, gba) := gb.getBits 3; gb := gba
    let (mnr, gbb) := gb.getBits 2; gb := gbb
    h := { h with operatingPoints := #[{ idc := 0, majorLevel := maj, minorLevel := mnr, tier := 0, decoderModelParamPresent := false }] }
  else
    let (tip, gba) := gb.getBit; gb := gba
    h := { h with timingInfoPresent := tip != 0 }
    if h.timingInfoPresent then
      let (numUnits, gbb) := gb.getBits 32; gb := gbb
      let (timeScale, gbc) := gb.getBits 32; gb := gbc
      if strict && (numUnits == 0 || timeScale == 0) then
        return none
      let (epi, gbd) := gb.getBit; gb := gbd
      h := { h with equalPictureInterval := epi != 0 }
      if h.equalPictureInterval then
        let (vlcVal, gbe) := gb.getVlc; gb := gbe
        if vlcVal == 0xFFFFFFFF then
          return none
      let (dmip, gbf) := gb.getBit; gb := gbf
      h := { h with decoderModelInfoPresent := dmip != 0 }
      if h.decoderModelInfoPresent then
        let (edbdl, gbg) := gb.getBits 5; gb := gbg
        let (decTick, gbh) := gb.getBits 32; gb := gbh
        if strict && decTick == 0 then
          return none
        let (brdl, gbi) := gb.getBits 5; gb := gbi
        let (fpdl, gbj) := gb.getBits 5; gb := gbj
        h := { h with
          encoderDecoderBufferDelayLength := edbdl + 1
          bufferRemovalDelayLength := brdl + 1
          framePresentationDelayLength := fpdl + 1
        }
    let (dispMip, gbk) := gb.getBit; gb := gbk
    let (nopM1, gbl) := gb.getBits 5; gb := gbl
    let nop := nopM1 + 1
    let mut ops : Array Av1OperatingPoint := Array.mkEmpty nop
    for _ in [:nop] do
      let (idc, gbm) := gb.getBits 12; gb := gbm
      if idc != 0 && ((idc &&& 0xFF) == 0 || (idc &&& 0xF00) == 0) then
        return none
      let (majM2, gbn) := gb.getBits 3; gb := gbn
      let maj := 2 + majM2
      let (mnr, gbo) := gb.getBits 2; gb := gbo
      let mut tier : Nat := 0
      if maj > 3 then
        let (tb, gbp) := gb.getBit; gb := gbp
        tier := tb
      let mut dmp := false
      if h.decoderModelInfoPresent then
        let (dmpB, gbq) := gb.getBit; gb := gbq
        dmp := dmpB != 0
        if dmp then
          let (_, gbr1) := gb.getBits h.encoderDecoderBufferDelayLength; gb := gbr1
          let (_, gbr2) := gb.getBits h.encoderDecoderBufferDelayLength; gb := gbr2
          let (_, gbr3) := gb.getBit; gb := gbr3
      if dispMip != 0 then
        let (dp, gbs) := gb.getBit; gb := gbs
        if dp != 0 then
          let (_, gbt) := gb.getBits 4; gb := gbt
      ops := ops.push { idc := idc, majorLevel := maj, minorLevel := mnr, tier := tier, decoderModelParamPresent := dmp }
    h := { h with displayModelInfoPresent := dispMip != 0, numOperatingPoints := nop, operatingPoints := ops }
  let (wnb, gb4) := gb.getBits 4; gb := gb4
  let (hnb, gb5) := gb.getBits 4; gb := gb5
  let widthNBits := wnb + 1
  let heightNBits := hnb + 1
  let (mwM1, gb6) := gb.getBits widthNBits; gb := gb6
  let (mhM1, gb7) := gb.getBits heightNBits; gb := gb7
  h := { h with widthNBits := widthNBits, heightNBits := heightNBits, maxWidth := mwM1 + 1, maxHeight := mhM1 + 1 }
  if !h.reducedStillPictureHeader then
    let (fidp, gb8) := gb.getBit; gb := gb8
    if fidp != 0 then
      let (dfid, gb9) := gb.getBits 4; gb := gb9
      let (fidAdd, gb10) := gb.getBits 3; gb := gb10
      let deltaBits := dfid + 2
      h := { h with frameIdNumbersPresent := true, deltaFrameIdNBits := deltaBits, frameIdNBits := fidAdd + deltaBits + 1 }
  let (sb128, gb11) := gb.getBit; gb := gb11
  let (fi, gb12) := gb.getBit; gb := gb12
  let (ief, gb13) := gb.getBit; gb := gb13
  h := { h with sb128 := sb128, filterIntra := fi != 0, intraEdgeFilter := ief != 0 }
  if h.reducedStillPictureHeader then
    h := { h with screenContentTools := av1Adaptive, forceIntegerMv := av1Adaptive }
  else
    let (ii, gba) := gb.getBit; gb := gba
    let (mc, gbb) := gb.getBit; gb := gbb
    let (wm, gbc) := gb.getBit; gb := gbc
    let (df, gbd) := gb.getBit; gb := gbd
    let (oh, gbe) := gb.getBit; gb := gbe
    let mut jc := false
    let mut rfm := false
    if oh != 0 then
      let (jcb, gbf) := gb.getBit; gb := gbf
      let (rfmb, gbg) := gb.getBit; gb := gbg
      jc := jcb != 0
      rfm := rfmb != 0
    let (chooseSct, gbh) := gb.getBit; gb := gbh
    let mut sct : Nat := av1Adaptive
    if chooseSct == 0 then
      let (sctB, gbi) := gb.getBit; gb := gbi
      sct := sctB
    let mut fimv : Nat := av1Adaptive
    if sct != 0 then
      let (chooseImv, gbj) := gb.getBit; gb := gbj
      if chooseImv == 0 then
        let (imvB, gbk) := gb.getBit; gb := gbk
        fimv := imvB
    let mut ohBits : Nat := 0
    if oh != 0 then
      let (ohb, gbl) := gb.getBits 3; gb := gbl
      ohBits := ohb + 1
    h := { h with
      interIntra := ii != 0
      maskedCompound := mc != 0
      warpedMotion := wm != 0
      dualFilter := df != 0
      orderHint := oh != 0
      jntComp := jc
      refFrameMvs := rfm
      screenContentTools := sct
      forceIntegerMv := fimv
      orderHintNBits := ohBits
    }
  let (sr, gb14) := gb.getBit; gb := gb14
  let (cdefB, gb15) := gb.getBit; gb := gb15
  let (restB, gb16) := gb.getBit; gb := gb16
  let (hbd0, gb17) := gb.getBit; gb := gb17
  let mut hbd := hbd0
  if h.profile == 2 && hbd != 0 then
    let (hbd1, gb18) := gb.getBit; gb := gb18
    hbd := hbd + hbd1
  let mut mono := false
  if h.profile != 1 then
    let (mb, gb19) := gb.getBit; gb := gb19
    mono := mb != 0
  let (cdp, gb20) := gb.getBit; gb := gb20
  let mut pri : Nat := 2
  let mut trc : Nat := 2
  let mut mtrx : Nat := 2
  if cdp != 0 then
    let (p, gb21) := gb.getBits 8; gb := gb21
    let (t, gb22) := gb.getBits 8; gb := gb22
    let (m, gb23) := gb.getBits 8; gb := gb23
    pri := p; trc := t; mtrx := m
  let mut colorRange : Nat := 0
  let mut ssHor : Nat := 1
  let mut ssVer : Nat := 1
  let mut layout : Nat := 1
  let mut chr : Nat := 0
  if mono then
    let (cr, gb24) := gb.getBit; gb := gb24
    colorRange := cr; ssHor := 1; ssVer := 1; layout := 0; chr := 0
  else if pri == 1 && trc == 13 && mtrx == 0 then
    layout := 3; ssHor := 0; ssVer := 0; colorRange := 1
    if h.profile != 1 && !(h.profile == 2 && hbd == 2) then
      return none
  else
    let (cr, gb24) := gb.getBit; gb := gb24
    colorRange := cr
    if h.profile == 0 then
      layout := 1; ssHor := 1; ssVer := 1
    else if h.profile == 1 then
      layout := 3; ssHor := 0; ssVer := 0
    else
      if hbd == 2 then
        let (sh, gb25) := gb.getBit; gb := gb25
        ssHor := sh
        if ssHor != 0 then
          let (sv, gb26) := gb.getBit; gb := gb26
          ssVer := sv
        else
          ssVer := 0
      else
        ssHor := 1; ssVer := 0
      layout := if ssHor != 0 then (if ssVer != 0 then 1 else 2) else 3
    if ssHor != 0 && ssVer != 0 then
      let (chPos, gb27) := gb.getBits 2; gb := gb27
      chr := chPos
  if strict && mtrx == 0 && layout != 3 then
    return none
  let mut sepUv := false
  if !mono then
    let (su, gb28) := gb.getBit; gb := gb28
    sepUv := su != 0
  let (fgp, gb29) := gb.getBit; gb := gb29
  if strict then
    let (okTrail, gb30) := gb.checkTrailingBits; gb := gb30
    if !okTrail then
      return none
    while gb.bitPos < gb.endIdx * 8 do
      let (z, gb31) := gb.getBits 8; gb := gb31
      if z != 0 then
        return none
  else if gb.err then
    return none
  let isMain8 := h.profile == 0 && hbd == 0 && !mono && ssHor == 1 && ssVer == 1
  return some { h with
    superRes := sr != 0
    cdef := cdefB != 0
    restoration := restB != 0
    hbd := hbd
    monochrome := mono
    colorDescriptionPresent := cdp != 0
    pri := pri
    trc := trc
    mtrx := mtrx
    colorRange := colorRange
    ssHor := ssHor
    ssVer := ssVer
    layout := layout
    chr := chr
    separateUvDeltaQ := sepUv
    filmGrainPresent := fgp != 0
    isMain8Bit420 := isMain8
  }

