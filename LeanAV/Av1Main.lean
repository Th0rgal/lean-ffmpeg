      else if stack.size == 1 then
        stack := stack.push { mv0 := same0.getD 0 (0, 0), mv1 := same1.getD 0 (0, 0), w := 2 }
      else
        stack := stack.push { mv0 := same0.getD 0 (0, 0), mv1 := same1.getD 0 (0, 0), w := 2 }
        stack := stack.push { mv0 := same0.getD 1 (0, 0), mv1 := same1.getD 1 (0, 0), w := 2 }
