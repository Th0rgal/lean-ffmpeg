  0x40, 0x02, 0x00, 0x00, 0x00, 0x02, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00,
  0x00, 0x00, 0x50, 0x01, 0x40, 0x01, 0x00, 0x00, 0x00, 0x01, 0x00, 0x00,
  0x00, 0x00, 0x00, 0x00, 0x00, 0x00
]

@[inline] private def av1ResolvePalColor (colorIdx : Nat) (p : Array Nat) (prioCount mask : Nat) : Nat :=
  if colorIdx < prioCount then
    p.getD colorIdx 0
  else
    let rank0 := colorIdx - prioCount + (mask &&& 1)
    let rank := if rank0 > 0 && ((mask >>> 1) &&& 1) != 0 then rank0 + 1 else rank0
    let byteIdx := 2 * (mask >>> 2) + (rank >>> 2)
    rank + ((av1PalFreeOffsets2.getD byteIdx 0 >>> (2 * (rank &&& 3))) &&& 3)

def av1ReadPalPlane (ctx0 : Av1TileDecodeCtx) (pl bs : Nat) (a l : Av1BlockContext) (xb4 yb4 : Nat)
    : Nat × Array (Array Nat) × Av1TileDecodeCtx := Id.run do
  let mut dec := ctx0.dec
  let mut cdf := ctx0.cdf
  let bctx := av1BlockDim.getD (bs * 4 + 2) 0 + av1BlockDim.getD (bs * 4 + 3) 0 - 2
  let (szM2, d1, c1) := dec.decodeSymbolAdapt cdf (cdfOff_m_pal_sz + (pl * 7 + bctx) * 8) 6
  dec := d1; cdf := c1
  let sz := szM2 + 2
  let lSz := if pl != 0 then l.palSzUv.getD yb4 0 else l.palSz.getD yb4 0
  let aSz := if (yb4 &&& 15) != 0 then (if pl != 0 then a.palSzUv.getD xb4 0 else a.palSz.getD xb4 0) else 0
  let clSrc := (l.alPal.getD yb4 #[]).getD pl #[]
  let caSrc := (a.alPal.getD xb4 #[]).getD pl #[]
  let mut cl := Array.mkEmpty lSz
  for k in [:lSz] do cl := cl.push (clSrc.getD k 0)
  let mut ca := Array.mkEmpty aSz
  for k in [:aSz] do ca := ca.push (caSrc.getD k 0)
  let mut cache : Array Nat := #[]
  let mut il : Nat := 0
  let mut ia : Nat := 0
  while il < cl.size && ia < ca.size do
    let vl := cl.getD il 0
    let va := ca.getD ia 0
    if vl < va then
      if cache.isEmpty || cache.getD (cache.size - 1) 0 != vl then
        cache := cache.push vl
      il := il + 1
    else
      if va == vl then
        il := il + 1
      if cache.isEmpty || cache.getD (cache.size - 1) 0 != va then
        cache := cache.push va
      ia := ia + 1
  while il < cl.size do
    let vl := cl.getD il 0
    if cache.isEmpty || cache.getD (cache.size - 1) 0 != vl then
      cache := cache.push vl
    il := il + 1
  while ia < ca.size do
    let va := ca.getD ia 0
    if cache.isEmpty || cache.getD (cache.size - 1) 0 != va then
      cache := cache.push va
    ia := ia + 1
  let mut usedCache : Array Nat := #[]
  for cval in cache do
    if usedCache.size < sz then
      let (ub, du) := dec.decodeBoolEqui
      dec := du
      if ub != 0 then
        usedCache := usedCache.push cval
  let nUsed := usedCache.size
  let mut pal := Array.replicate sz 0
  if nUsed < sz then
    let mut i := nUsed
    let (prev0, dp0) := dec.decodeBools 8
    dec := dp0
    let mut prev := prev0
    pal := pal.set! i prev
    i := i + 1
    if i < sz then
      let (badd, db) := dec.decodeBools 2
      dec := db
      let mut bits := 5 + badd
      let step : Nat := if pl != 0 then 0 else 1
      while i < sz do
        let (delta, dd) := dec.decodeBools bits
        dec := dd
        prev := Nat.min (prev + delta + step) 255
        pal := pal.set! i prev
        i := i + 1
        if prev + step >= 255 then
          while i < sz do
            pal := pal.set! i 255
            i := i + 1
        else
          bits := Nat.min bits (1 + av1Ulog2 (255 - prev - step))
    let mut n : Nat := 0
    let mut m : Nat := nUsed
    let mut merged := Array.replicate sz 0
    for k in [:sz] do
      if n < nUsed && (m >= sz || usedCache.getD n 0 <= pal.getD m 0) then
        merged := merged.set! k (usedCache.getD n 0)
        n := n + 1
      else
        merged := merged.set! k (pal.getD m 0)
        m := m + 1
    pal := merged
  else
    pal := usedCache
  if pl == 0 then
    return (sz, #[pal], { ctx0 with dec := dec, cdf := cdf })
  let mut palV := Array.replicate sz 0
  let (useDeltaV, dv0) := dec.decodeBoolEqui
  dec := dv0
  if useDeltaV != 0 then
    let (baddV, dv1) := dec.decodeBools 2
    let (prevV0, dv2) := dv1.decodeBools 8
    dec := dv2
    let bitsV := 4 + baddV
    let mut prevV : Int := Int.ofNat prevV0
    palV := palV.set! 0 prevV0
    for k in [1:sz] do
      let (dmag, dv3) := dec.decodeBools bitsV
      dec := dv3
      let mut deltaI : Int := Int.ofNat dmag
      if dmag != 0 then
        let (sgn, dv4) := dec.decodeBoolEqui
        dec := dv4
        if sgn != 0 then
          deltaI := -deltaI
      prevV := Int.emod (prevV + deltaI) 256
      palV := palV.set! k prevV.toNat
  else
    for k in [:sz] do
      let (vk, dvk) := dec.decodeBools 8
      dec := dvk
      palV := palV.set! k vk
  return (sz, #[pal, palV], { ctx0 with dec := dec, cdf := cdf })

def av1ReadPalIndices (dec0 : Av1MsacDecoder) (cdf0 : Array Nat) (pl sz bwPx bhPx wPx hPx : Nat)
    : Array Nat × Av1MsacDecoder × Array Nat := Id.run do
  let mut idx := Array.replicate (bwPx * bhPx) 0
  let (i0, d0) := dec0.decodeUniform sz
  idx := idx.set! 0 i0
  let mut dec := d0
  let mut cdf := cdf0
  let base := cdfOff_m_color_map + (pl * 7 + (sz - 2)) * 40
  if sz == 2 then
    if wPx + hPx >= 2 then
      for diag in [1 : wPx + hPx - 1] do
        let first := Nat.min diag (wPx - 1)
        let last := if diag + 1 >= hPx then diag + 1 - hPx else 0
        let mut haveTop : Bool := decide (diag > first)
        let cnt := first + 1 - last
        for step in [:cnt] do
          let j := first - step
          let y := diag - j
          let x := j
          let haveLeft : Bool := decide (j > 0)
          let mut cctx : Nat := 0
          let mut p0 : Nat := 0
          if !haveLeft then
            cctx := 0
            p0 := idx.getD ((y - 1) * bwPx + x) 0
          else if !haveTop then
            cctx := 0
            p0 := idx.getD (y * bwPx + (x - 1)) 0
          else
            let lv := idx.getD (y * bwPx + (x - 1)) 0
            let tp := idx.getD ((y - 1) * bwPx + x) 0
            let tl := idx.getD ((y - 1) * bwPx + (x - 1)) 0
            let sameTl : Nat := if tp == lv then 1 else 0
            let sameTtl : Nat := if tp == tl then 1 else 0
            cctx := 2 + sameTl + (sameTl &&& sameTtl)
            p0 := if sameTl != 0 then tp else tl
          let (bit, d1, c1) := dec.decodeBoolAdapt cdf (base + cctx * 8)
          dec := d1; cdf := c1
          idx := idx.set! (y * bwPx + x) (bit ^^^ p0)
          haveTop := true
  else
    if wPx + hPx >= 2 then
      for diag in [1 : wPx + hPx - 1] do
        let first := Nat.min diag (wPx - 1)
        let last := if diag + 1 >= hPx then diag + 1 - hPx else 0
        let mut haveTop : Bool := decide (diag > first)
        let cnt := first + 1 - last
        for step in [:cnt] do
          let j := first - step
          let y := diag - j
          let x := j
          let haveLeft : Bool := decide (j > 0)
          let mut cctx : Nat := 0
          let mut prioCount : Nat := 1
          let mut p : Array Nat := #[0, 0, 0]
          let mut mask : Nat := 0
          if !haveLeft then
            let v := idx.getD ((y - 1) * bwPx + x) 0
            cctx := 0; prioCount := 1; p := p.set! 0 v; mask := 1 <<< v
          else if !haveTop then
            let v := idx.getD (y * bwPx + (x - 1)) 0
            cctx := 0; prioCount := 1; p := p.set! 0 v; mask := 1 <<< v
          else
            let lv := idx.getD (y * bwPx + (x - 1)) 0
            let tp := idx.getD ((y - 1) * bwPx + x) 0
            let tl := idx.getD ((y - 1) * bwPx + (x - 1)) 0
            let sameTL := tp == lv
            let sameTTl := tp == tl
            let sameLTl := lv == tl
            if sameTL && sameTTl then
              cctx := 4; prioCount := 1; p := p.set! 0 tp; mask := 1 <<< tp
            else if sameTL then
              cctx := 3; prioCount := 2; p := p.set! 0 tp; p := p.set! 1 tl
              mask := (1 <<< tp) ||| (1 <<< tl)
            else if sameTTl || sameLTl then
              let p1 := if sameTTl then lv else tp
              cctx := 2; prioCount := 2; p := p.set! 0 tl; p := p.set! 1 p1
              mask := (1 <<< tl) ||| (1 <<< p1)
            else
              cctx := 1; prioCount := 3
              p := p.set! 0 (Nat.min tp lv)
              p := p.set! 1 (Nat.max tp lv)
              p := p.set! 2 tl
              mask := (1 <<< tp) ||| (1 <<< lv) ||| (1 <<< tl)
          let (cidx, d1, c1) := dec.decodeSymbolAdapt cdf (base + cctx * 8) (sz - 1)
          dec := d1; cdf := c1
          idx := idx.set! (y * bwPx + x) (av1ResolvePalColor cidx p prioCount mask)
          haveTop := true
  for y in [:hPx] do
    for x in [wPx:bwPx] do
      idx := idx.set! (y * bwPx + x) (idx.getD (y * bwPx + wPx - 1) 0)
  for y in [hPx:bhPx] do
    for x in [:bwPx] do
      idx := idx.set! (y * bwPx + x) (idx.getD ((hPx - 1) * bwPx + x) 0)
  return (idx, dec, cdf)

def av1FillLfLevel (ctx0 : Av1TileDecodeCtx) (bx by4 bw4 bh4 cbw4 cbh4 : Nat)
    (hasChroma : Bool) (segId rLf mLf : Nat) : Av1TileDecodeCtx := Id.run do
  let lvl := ctx0.st.level
  let stS := ctx0.b4Stride
  let mut levelY := ctx0.levelY
  let mut levelUv := ctx0.levelUv
  let lfw4 := if bx < ctx0.w4 then Nat.min bw4 (ctx0.w4 - bx) else 0
  let lfh4 := if by4 < ctx0.h4 then Nat.min bh4 (ctx0.h4 - by4) else 0
  if lfw4 > 0 && lfh4 > 0 then
    let lv0 := av1LfAt lvl segId 0 rLf mLf
    let lv1 := av1LfAt lvl segId 1 rLf mLf
    for yy in [:lfh4] do
      let base := (by4 + yy) * stS + bx
      for xx in [:lfw4] do
        let o := (base + xx) * 2
        levelY := levelY.set! o lv0
        levelY := levelY.set! (o + 1) lv1
  if hasChroma then
    let cw4Tot := (ctx0.w4 + 1) >>> 1
    let ch4Tot := (ctx0.h4 + 1) >>> 1
    let cbx := bx >>> 1
    let cby := by4 >>> 1
    let lfcw4 := if cbx < cw4Tot then Nat.min (cw4Tot - cbx) cbw4 else 0
    let lfch4 := if cby < ch4Tot then Nat.min (ch4Tot - cby) cbh4 else 0
    if lfcw4 > 0 && lfch4 > 0 then
      let lu := av1LfAt lvl segId 2 rLf mLf
      let lv := av1LfAt lvl segId 3 rLf mLf
      for yy in [:lfch4] do
        let base := (cby + yy) * stS + cbx
        for xx in [:lfcw4] do
          let o := (base + xx) * 2
          levelUv := levelUv.set! o lu
          levelUv := levelUv.set! (o + 1) lv
  return { ctx0 with levelY := levelY, levelUv := levelUv }

@[inline] private def av1IsSmoothMode (m : Nat) : Bool :=
  m == av1SmoothPred || m == av1SmoothVPred || m == av1SmoothHPred

def av1ReconIntra (ctx0 : Av1TileDecodeCtx) (bs bx by4 bw4 bh4 w4 h4 cbw4 cbh4 cw4 ch4 : Nat)
    (haveTop haveLeft hasChroma : Bool) (edgeFlags : Nat)
    (a0 l0 : Av1BlockContext) (xb4 yb4 cxb4 cyb4 : Nat)
    (_segId : Nat) (skip : Bool) (qidx : Nat) (lossless : Bool)
    (bdq : Array (Nat × Nat)) (tx uvTx yMode : Nat) (yAngle : Int) (uvMode : Nat) (uvAngle : Int)
    (cflAlpha : Array Int) (palY : Option (Array (Array Nat))) (palIdxY : Array Nat)
    (palUv : Option (Array (Array Nat))) (palIdxUv : Array Nat)
    : Av1TileDecodeCtx × Av1BlockContext × Av1BlockContext := Id.run do
  let fh := ctx0.fh
  let seq := ctx0.seq
  let mut dec := ctx0.dec
  let mut cdf := ctx0.cdf
  let mut flatY := ctx0.flatY
  let mut flatU := ctx0.flatU
  let mut flatV := ctx0.flatV
  let mut a := a0
  let mut l := l0
  let ys := ctx0.yStride
  let uvs := ctx0.uvStride
  let (tw4, th4, lw, lh, _) := av1TxDim tx
  let (utw4, uth4, ulw, ulh, _) := av1TxDim uvTx
  let mut cf : Array Int := Array.replicate 1024 0
  let shiftY := av1TxShift lw lh
  let shiftUv := av1TxShift ulw ulh
  let cbx := bx - (bx &&& 1)
  let cby := by4 - (by4 &&& 1)
  let cHt := cby > ctx0.row0
  let cHl := cbx > ctx0.col0
  let edgeFiltFlag : Nat := if seq.intraEdgeFilter then 1 else 0
  let qmY : Option (Array (Array Nat)) := ctx0.qm.map (fun q => q.getD 0 #[])
  let qmU : Option (Array (Array Nat)) := ctx0.qm.map (fun q => q.getD 1 #[])
  let qmV : Option (Array (Array Nat)) := ctx0.qm.map (fun q => q.getD 2 #[])
  let (dqYDc, dqYAc) := bdq.getD 0 (4, 4)
  let mut initY : Nat := 0
  while initY < h4 do
    let subH4 := Nat.min h4 (initY + 16)
    let subCh4 := Nat.min ch4 ((initY + 16) >>> 1)
    let mut initX : Nat := 0
    while initX < w4 do
      if initX == 0 && initY == 0 then
        if let some pyArr := palY then
          flatY := av1PalPred flatY (by4 * 4 * ys + bx * 4) ys (pyArr.getD 0 #[]) palIdxY (bw4 * 4) (bh4 * 4)
      let smFlag : Nat :=
        if (haveTop && av1IsSmoothMode (a.mode.getD xb4 0)) ||
           (haveLeft && av1IsSmoothMode (l.mode.getD yb4 0)) then 512 else 0
      let sbTr : Bool :=
        if initX + 16 < w4 then true
        else if initY != 0 then false
        else (edgeFlags &&& av1EdgeI444TopHasRight) != 0
      let sbBl : Bool :=
        if initX != 0 then false
        else if initY + 16 < h4 then true
        else (edgeFlags &&& av1EdgeI444LeftHasBottom) != 0
      let subW4 := Nat.min w4 (initX + 16)
      let mut yy := initY
      while yy < subH4 do
        let mut xx := initX
        while xx < subW4 do
          let px := (bx + xx) * 4
          let py := (by4 + yy) * 4
          let doff := py * ys + px
          if palY.isNone then
            let ht := (by4 + yy) > ctx0.row0
            let hl := (bx + xx) > ctx0.col0
            let mut ef : Nat := 0
            if !((yy > initY || !sbTr) && xx + tw4 >= subW4) then
              ef := ef ||| av1EdgeI444TopHasRight
            if !(xx > initX || (!sbBl && yy + th4 >= subH4)) then
              ef := ef ||| av1EdgeI444LeftHasBottom
            let topSb := if ctx0.sby > 0 && by4 + yy == ctx0.sbyBy then some ctx0.ipredEdgeY else none
            let (m, ang, ebuf, tl) := av1PrepareIntraEdges
              (bx + xx) hl (by4 + yy) ht ctx0.col1 ctx0.row1 ef
              flatY doff ys topSb 0 yMode yAngle tw4 th4 edgeFiltFlag
            let angBase : Nat := (if yMode == 13 then yAngle else ang).toNat
            let aArg := angBase ||| smFlag ||| (edgeFiltFlag <<< 10)
            let mw := (ctx0.bw - (bx + xx)) * 4
            let mh := (ctx0.bh - (by4 + yy)) * 4
            flatY := av1IntraPred flatY doff ys ebuf tl m (tw4 * 4) (th4 * 4) aArg mw mh
          if !skip then
            let (eob, txtp, rctx, d1, c1, cf1) := av1DecodeCoefs
              dec cdf tx bs true 0 yMode yAngle uvMode
              fh.reducedTxtpSet qidx lossless a.lcoef (xb4 + xx) l.lcoef (yb4 + yy)
              cf 0 dqYDc dqYAc qmY
            dec := d1; cdf := c1; cf := cf1
            let wFill := Nat.min tw4 (ctx0.bw - (bx + xx))
            let hFill := Nat.min th4 (ctx0.bh - (by4 + yy))
            let mut alc := a.lcoef
            for k in [:Nat.min wFill (32 - (xb4 + xx))] do
              alc := alc.set! (xb4 + xx + k) rctx
            a := { a with lcoef := alc }
            let mut llc := l.lcoef
            for k in [:Nat.min hFill (32 - (yb4 + yy))] do
              llc := llc.set! (yb4 + yy + k) rctx
            l := { l with lcoef := llc }
            if eob >= 0 then
              let (fy1, cf2) := av1InvTxfmAdd flatY ys cf eob tx shiftY txtp doff
              flatY := fy1; cf := cf2
          else
            let mut alc := a.lcoef
            for k in [:Nat.min tw4 (32 - (xb4 + xx))] do
              alc := alc.set! (xb4 + xx + k) 0x40
            a := { a with lcoef := alc }
            let mut llc := l.lcoef
            for k in [:Nat.min th4 (32 - (yb4 + yy))] do
              llc := llc.set! (yb4 + yy + k) 0x40
            l := { l with lcoef := llc }
          xx := xx + tw4
        yy := yy + th4
      if hasChroma then
        if uvMode == av1CflPred && initX == 0 && initY == 0 then
          let maskTw := tw4 - 1
          let maskTh := th4 - 1
          let furthestR0 := (cw4 <<< 1) + maskTw
          let furthestR := furthestR0 - (furthestR0 &&& maskTw)
          let furthestB0 := (ch4 <<< 1) + maskTh
          let furthestB := furthestB0 - (furthestB0 &&& maskTh)
          let wPad := cbw4 - (furthestR >>> 1)
          let hPad := cbh4 - (furthestB >>> 1)
          let acBuf := av1CflAc420 flatY (cby * 4 * ys + cbx * 4) ys wPad hPad (cbw4 * 4) (cbh4 * 4)
          for pl in [:2] do
            let alpha := cflAlpha.getD pl 0
            if alpha != 0 then
              let pbuf := if pl == 0 then flatU else flatV
              let doff := (cby >>> 1) * 4 * uvs + (cbx >>> 1) * 4
              let topSb :=
                if ctx0.sby > 0 && cby == ctx0.sbyBy then
                  some (if pl == 0 then ctx0.ipredEdgeU else ctx0.ipredEdgeV)
                else none
              let (m, _, ebuf, tl) := av1PrepareIntraEdges
                (bx >>> 1) ((bx >>> 1) > (ctx0.col0 >>> 1))
                (by4 >>> 1) ((by4 >>> 1) > (ctx0.row0 >>> 1))
                (ctx0.col1 >>> 1) (ctx0.row1 >>> 1) 0
                pbuf doff uvs topSb 0 av1DcPred 0 utw4 uth4 0
              let pbuf1 := av1CflPredict pbuf doff uvs ebuf tl m (utw4 * 4) (uth4 * 4) acBuf alpha
              if pl == 0 then flatU := pbuf1 else flatV := pbuf1
        else if initX == 0 && initY == 0 then
          if let some puvArr := palUv then
            let uvDoff := (by4 >>> 1) * 4 * uvs + (bx >>> 1) * 4
            flatU := av1PalPred flatU uvDoff uvs (puvArr.getD 0 #[]) palIdxUv (cbw4 * 4) (cbh4 * 4)
            flatV := av1PalPred flatV uvDoff uvs (puvArr.getD 1 #[]) palIdxUv (cbw4 * 4) (cbh4 * 4)
        let smUv : Nat :=
          if (cHt && av1IsSmoothMode (a.uvmode.getD cxb4 0)) ||
             (cHl && av1IsSmoothMode (l.uvmode.getD cyb4 0)) then 512 else 0
        let uvTr : Bool :=
          if ((initX + 16) >>> 1) < cw4 then true
          else if initY != 0 then false
          else (edgeFlags &&& av1EdgeI420TopHasRight) != 0
        let uvBl : Bool :=
          if initX != 0 then false
          else if ((initY + 16) >>> 1) < ch4 then true
          else (edgeFlags &&& av1EdgeI420LeftHasBottom) != 0
        let subCw4 := Nat.min cw4 ((initX + 16) >>> 1)
        for pl in [:2] do
          let mut pbuf := if pl == 0 then flatU else flatV
          let (dqUvDc, dqUvAc) := bdq.getD (1 + pl) (4, 4)
          let qmUv := if pl == 0 then qmU else qmV
          let mut cyy := initY >>> 1
          while cyy < subCh4 do
            let mut cxx := initX >>> 1
            while cxx < subCw4 do
              let tBx := bx + (cxx <<< 1)
              let tBy := by4 + (cyy <<< 1)
              let xpos := tBx >>> 1
              let ypos := tBy >>> 1
              let doff := ypos * 4 * uvs + xpos * 4
              if palUv.isNone && !(uvMode == av1CflPred && cflAlpha.getD pl 0 != 0) then
                let mut ef : Nat := 0
                if !((cyy > (initY >>> 1) || !uvTr) && cxx + utw4 >= subCw4) then
                  ef := ef ||| av1EdgeI444TopHasRight
                if !(cxx > (initX >>> 1) || (!uvBl && cyy + uth4 >= subCh4)) then
                  ef := ef ||| av1EdgeI444LeftHasBottom
                let topSb :=
                  if ctx0.sby > 0 && (tBy - (tBy &&& 1)) == ctx0.sbyBy then
                    some (if pl == 0 then ctx0.ipredEdgeU else ctx0.ipredEdgeV)
                  else none
                let uvm := if uvMode == av1CflPred then av1DcPred else uvMode
                let (m, ang, ebuf, tl) := av1PrepareIntraEdges
                  xpos (xpos > (ctx0.col0 >>> 1))
                  ypos (ypos > (ctx0.row0 >>> 1))
                  (ctx0.col1 >>> 1) (ctx0.row1 >>> 1) ef
                  pbuf doff uvs topSb 0 uvm uvAngle utw4 uth4 edgeFiltFlag
                let aArg := ang.toNat ||| smUv ||| (edgeFiltFlag <<< 10)
                let mw := (4 * ctx0.bw + 1 - 4 * (tBx - (tBx &&& 1))) >>> 1
                let mh := (4 * ctx0.bh + 1 - 4 * (tBy - (tBy &&& 1))) >>> 1
                pbuf := av1IntraPred pbuf doff uvs ebuf tl m (utw4 * 4) (uth4 * 4) aArg mw mh
              if !skip then
                let aCc := a.ccoef.getD pl #[]
                let lCc := l.ccoef.getD pl #[]
                let (eob, txtp, rctx, d2, c2, cf2) := av1DecodeCoefs
                  dec cdf uvTx bs true (1 + pl) yMode yAngle uvMode
                  fh.reducedTxtpSet qidx lossless aCc (cxb4 + cxx) lCc (cyb4 + cyy)
                  cf 0 dqUvDc dqUvAc qmUv
                dec := d2; cdf := c2; cf := cf2
                let wFill := Nat.min utw4 ((ctx0.bw - tBx + 1) >>> 1)
                let hFill := Nat.min uth4 ((ctx0.bh - tBy + 1) >>> 1)
                let mut acc := aCc
                for k in [:Nat.min wFill (32 - (cxb4 + cxx))] do
                  acc := acc.set! (cxb4 + cxx + k) rctx
                a := { a with ccoef := a.ccoef.set! pl acc }
                let mut lcc := lCc
                for k in [:Nat.min hFill (32 - (cyb4 + cyy))] do
                  lcc := lcc.set! (cyb4 + cyy + k) rctx
                l := { l with ccoef := l.ccoef.set! pl lcc }
                if eob >= 0 then
                  let (pb1, cf3) := av1InvTxfmAdd pbuf uvs cf eob uvTx shiftUv txtp doff
                  pbuf := pb1; cf := cf3
              else
                let mut acc := a.ccoef.getD pl #[]
                for k in [:Nat.min utw4 (32 - (cxb4 + cxx))] do
                  acc := acc.set! (cxb4 + cxx + k) 0x40
                a := { a with ccoef := a.ccoef.set! pl acc }
                let mut lcc := l.ccoef.getD pl #[]
                for k in [:Nat.min uth4 (32 - (cyb4 + cyy))] do
                  lcc := lcc.set! (cyb4 + cyy + k) 0x40
                l := { l with ccoef := l.ccoef.set! pl lcc }
              cxx := cxx + utw4
            cyy := cyy + uth4
          if pl == 0 then flatU := pbuf else flatV := pbuf
      initX := initX + 16
    initY := initY + 16
  return ({ ctx0 with dec := dec, cdf := cdf, flatY := flatY, flatU := flatU, flatV := flatV }, a, l)

def av1DecodeIntraB (ctx0 : Av1TileDecodeCtx) (bs bx by4 bw4 bh4 bwLog2 bhLog2 w4 h4 cbw4 cbh4 cw4 ch4 : Nat)
    (haveTop haveLeft hasChroma : Bool) (edgeFlags : Nat)
    (a0 l0 : Av1BlockContext) (xb4 yb4 cxb4 cyb4 segId : Nat)
    (skip : Bool) (qidx : Nat) (lossless : Bool) (bdq : Array (Nat × Nat))
    (lfm0 : Av1LfMask) : Av1TileDecodeCtx × Av1BlockContext × Av1BlockContext × Av1LfMask := Id.run do
  let fh := ctx0.fh
  let seq := ctx0.seq
  let mut dec := ctx0.dec
  let mut cdf := ctx0.cdf
  let mut a := a0
  let mut l := l0
  let mut lfm := lfm0
  let keyOrIntra := fh.frameType == av1FrameKey || fh.frameType == av1FrameIntra
  let mut yMode : Nat := 0
  if keyOrIntra then
    let am := av1IntraModeCtx.getD (a.mode.getD xb4 0) 0
    let lm := av1IntraModeCtx.getD (l.mode.getD yb4 0) 0
    let (ym, d1, c1) := dec.decodeSymbolAdapt cdf (cdfOff_kfym + (am * 5 + lm) * 16) 12
    yMode := ym; dec := d1; cdf := c1
  else
    let (ym, d1, c1) := dec.decodeSymbolAdapt cdf (cdfOff_m_y_mode + av1YmodeSizeCtx.getD bs 0 * 16) 12
    yMode := ym; dec := d1; cdf := c1
  let mut yAngle : Int := 0
  if av1VertPred <= yMode && yMode <= 8 && bwLog2 + bhLog2 >= 2 then
    let (ya, d2, c2) := dec.decodeSymbolAdapt cdf (cdfOff_m_angle_delta + (yMode - av1VertPred) * 8) 6
    yAngle := Int.ofNat ya - 3; dec := d2; cdf := c2
  let mut uvMode : Nat := av1DcPred
  let mut uvAngle : Int := 0
  let mut cflAlpha : Array Int := #[0, 0]
  if hasChroma then
    let cflOk := if lossless then (cbw4 == 1 && cbh4 == 1) else (cbw4 <= 8 && cbh4 <= 8)
    let ubase := cdfOff_m_uv_mode + ((if cflOk then 13 else 0) + yMode) * 16
    let (uvm, d3, c3) := dec.decodeSymbolAdapt cdf ubase (if cflOk then 13 else 12)
    uvMode := uvm; dec := d3; cdf := c3
    if uvMode == av1CflPred then
      let (sj0, d4, c4) := dec.decodeSymbolAdapt cdf cdfOff_m_cfl_sign 7
      dec := d4; cdf := c4
      let signJoint := sj0 + 1
      let su := signJoint / 3
      let sv := signJoint % 3
      if su != 0 then
        let cflCtxU := (if su == 2 then 3 else 0) + sv
        let (au0, d5, c5) := dec.decodeSymbolAdapt cdf (cdfOff_m_cfl_alpha + cflCtxU * 16) 15
        dec := d5; cdf := c5
        let au : Int := Int.ofNat (au0 + 1)
        cflAlpha := cflAlpha.set! 0 (if su == 1 then -au else au)
      if sv != 0 then
        let cflCtxV := (if sv == 2 then 3 else 0) + su
        let (av0, d6, c6) := dec.decodeSymbolAdapt cdf (cdfOff_m_cfl_alpha + cflCtxV * 16) 15
        dec := d6; cdf := c6
        let av : Int := Int.ofNat (av0 + 1)
        cflAlpha := cflAlpha.set! 1 (if sv == 1 then -av else av)
    else if av1VertPred <= uvMode && uvMode <= 8 && bwLog2 + bhLog2 >= 2 then
      let (ua, d4, c4) := dec.decodeSymbolAdapt cdf (cdfOff_m_angle_delta + (uvMode - av1VertPred) * 8) 6
      uvAngle := Int.ofNat ua - 3; dec := d4; cdf := c4
  let mut ctx := { ctx0 with dec := dec, cdf := cdf }
  let mut palSzY : Nat := 0
  let mut palSzUv : Nat := 0
  let mut palY : Option (Array (Array Nat)) := none
  let mut palUv : Option (Array (Array Nat)) := none
  let mut palIdxY : Array Nat := #[]
  let mut palIdxUv : Array Nat := #[]
  if fh.allowScreenContentTools && Nat.max bw4 bh4 <= 16 && bw4 + bh4 >= 4 then
    if yMode == av1DcPred then
      let pctx := (if a.palSz.getD xb4 0 > 0 then 1 else 0) + (if l.palSz.getD yb4 0 > 0 then 1 else 0)
      let bctx := bwLog2 + bhLog2 - 2
      let (usePalY, d5, c5) := ctx.dec.decodeBoolAdapt ctx.cdf (cdfOff_m_pal_y + (bctx * 3 + pctx) * 2)
      ctx := { ctx with dec := d5, cdf := c5 }
      if usePalY != 0 then
        let (sy, py, ctx1) := av1ReadPalPlane ctx 0 bs a l xb4 yb4
        palSzY := sy; palY := some py; ctx := ctx1
    if hasChroma && uvMode == av1DcPred then
      let (usePalUv, d6, c6) := ctx.dec.decodeBoolAdapt ctx.cdf (cdfOff_m_pal_uv + (if palSzY != 0 then 1 else 0) * 2)
      ctx := { ctx with dec := d6, cdf := c6 }
      if usePalUv != 0 then
        let (suv, puv, ctx2) := av1ReadPalPlane ctx 1 bs a l xb4 yb4
        palSzUv := suv; palUv := some puv; ctx := ctx2
  if seq.filterIntra && yMode == av1DcPred && palSzY == 0 && Nat.max bw4 bh4 <= 8 then
    let (useFi, d7, c7) := ctx.dec.decodeBoolAdapt ctx.cdf (cdfOff_m_use_filter_intra + bs * 2)
    ctx := { ctx with dec := d7, cdf := c7 }
    if useFi != 0 then
      yMode := 13
      let (fi, d8, c8) := ctx.dec.decodeSymbolAdapt ctx.cdf cdfOff_m_filter_intra 4
      yAngle := Int.ofNat fi
      ctx := { ctx with dec := d8, cdf := c8 }
  if palSzY != 0 then
    let (piy, d9, c9) := av1ReadPalIndices ctx.dec ctx.cdf 0 palSzY (bw4 * 4) (bh4 * 4) (w4 * 4) (h4 * 4)
    palIdxY := piy; ctx := { ctx with dec := d9, cdf := c9 }
  if palSzUv != 0 then
    let (piuv, d10, c10) := av1ReadPalIndices ctx.dec ctx.cdf 1 palSzUv (cbw4 * 4) (cbh4 * 4) (cw4 * 4) (ch4 * 4)
    palIdxUv := piuv; ctx := { ctx with dec := d10, cdf := c10 }
  let maxTx := av1MaxTxfmForBs.getD (bs * 4) 0
  let tmax := av1TxfmDim.getD (maxTx * 8 + 5) 0
  let mut tx := maxTx
  if lossless then
    tx := 0
  else if fh.txfmMode == 2 && tmax > 0 then
    let (_, _, mlw, mlh, _) := av1TxDim maxTx
    let tctx := av1GetTxCtx a l mlw mlh yb4 xb4
    let (depth, d11, c11) := ctx.dec.decodeSymbolAdapt ctx.cdf (cdfOff_m_txsz + ((tmax - 1) * 3 + tctx) * 4) (Nat.min tmax 2)
    ctx := { ctx with dec := d11, cdf := c11 }
    tx := maxTx
    for _ in [:depth] do
      tx := av1TxfmDim.getD (tx * 8 + 6) 0
  let uvTx := if lossless then 0 else av1MaxTxfmForBs.getD (bs * 4 + 1) 0
  let (_, _, lw, lh, _) := av1TxDim tx
  let (ctx3, a1, l1) := av1ReconIntra ctx bs bx by4 bw4 bh4 w4 h4 cbw4 cbh4 cw4 ch4
    haveTop haveLeft hasChroma edgeFlags a l xb4 yb4 cxb4 cyb4
    segId skip qidx lossless bdq tx uvTx yMode yAngle uvMode uvAngle
    cflAlpha palY palIdxY palUv palIdxUv
  ctx := ctx3; a := a1; l := l1
  let lfw4 := if bx < ctx.w4 then Nat.min bw4 (ctx.w4 - bx) else 0
  let lfh4 := if by4 < ctx.h4 then Nat.min bh4 (ctx.h4 - by4) else 0
  if lfw4 > 0 && lfh4 > 0 then
    let mut aSlice := Array.mkEmpty lfw4
    for i in [:lfw4] do aSlice := aSlice.push (a.txLpfY.getD (xb4 + i) 2)
    let mut lSlice := Array.mkEmpty lfh4
    for i in [:lfh4] do lSlice := lSlice.push (l.txLpfY.getD (yb4 + i) 2)
    let (fy1, _, _) := av1MaskEdgesIntra lfm.filterY yb4 xb4 lfw4 lfh4 tx aSlice lSlice
    lfm := { lfm with filterY := fy1 }
    let mut atly := a.txLpfY
    for i in [:Nat.min lfw4 (32 - xb4)] do atly := atly.set! (xb4 + i) (Nat.min 2 lh)
    a := { a with txLpfY := atly }
    let mut ltly := l.txLpfY
    for i in [:Nat.min lfh4 (32 - yb4)] do ltly := ltly.set! (yb4 + i) (Nat.min 2 lw)
    l := { l with txLpfY := ltly }
  if hasChroma then
    let cw4Tot := (ctx.w4 + 1) >>> 1
    let ch4Tot := (ctx.h4 + 1) >>> 1
    let cbx2 := bx >>> 1
    let cby2 := by4 >>> 1
    let lfcw4 := if cbx2 < cw4Tot then Nat.min (cw4Tot - cbx2) cbw4 else 0
    let lfch4 := if cby2 < ch4Tot then Nat.min (ch4Tot - cby2) cbh4 else 0
    if lfcw4 > 0 && lfch4 > 0 then
      let (_, _, ulw, ulh, _) := av1TxDim uvTx
      let mut aCSlice := Array.mkEmpty lfcw4
      for i in [:lfcw4] do aCSlice := aCSlice.push (a.txLpfUv.getD (cxb4 + i) 1)
      let mut lCSlice := Array.mkEmpty lfch4
      for i in [:lfch4] do lCSlice := lCSlice.push (l.txLpfUv.getD (cyb4 + i) 1)
      let (fuv1, _, _) := av1MaskEdgesChroma lfm.filterUv cyb4 cxb4 lfcw4 lfch4 false uvTx aCSlice lCSlice
      lfm := { lfm with filterUv := fuv1 }
      let mut atluv := a.txLpfUv
      for i in [:Nat.min lfcw4 (32 - cxb4)] do atluv := atluv.set! (cxb4 + i) (if ulh != 0 then 1 else 0)
      a := { a with txLpfUv := atluv }
      let mut ltluv := l.txLpfUv
      for i in [:Nat.min lfch4 (32 - cyb4)] do ltluv := ltluv.set! (cyb4 + i) (if ulw != 0 then 1 else 0)
      l := { l with txLpfUv := ltluv }
  let yModeNofilt := if yMode == 13 then av1DcPred else yMode
  for i in [:Nat.min bw4 (32 - xb4)] do
    let xi := xb4 + i
    a := { a with
      txIntra := a.txIntra.set! xi (Int.ofNat lw)
      tx := a.tx.set! xi lw
      mode := a.mode.set! xi yModeNofilt
      palSz := a.palSz.set! xi palSzY
      palSzUv := a.palSzUv.set! xi (if hasChroma then palSzUv else 0)
    }
    if palSzY > 0 then
      if let some pyArr := palY then
        let mut ap := a.alPal.getD xi #[]
        let mut ap0 := ap.getD 0 #[]
        let src0 := pyArr.getD 0 #[]
        for k in [:palSzY] do ap0 := ap0.set! k (src0.getD k 0)
        ap := ap.set! 0 ap0
        a := { a with alPal := a.alPal.set! xi ap }
    if hasChroma && palSzUv > 0 then
      if let some puvArr := palUv then
        let mut ap := a.alPal.getD xi #[]
        let mut ap1 := ap.getD 1 #[]
        let mut ap2 := ap.getD 2 #[]
        let src0 := puvArr.getD 0 #[]
        let src1 := puvArr.getD 1 #[]
        for k in [:palSzUv] do
          ap1 := ap1.set! k (src0.getD k 0)
          ap2 := ap2.set! k (src1.getD k 0)
        ap := (ap.set! 1 ap1).set! 2 ap2
        a := { a with alPal := a.alPal.set! xi ap }
    if !keyOrIntra then
      a := { a with
        compType := a.compType.set! xi av1CompInterNone
        ref := (a.ref.set! 0 ((a.ref.getD 0 #[]).set! xi (-1))).set! 1 ((a.ref.getD 1 #[]).set! xi (-1))
        filter := (a.filter.set! 0 ((a.filter.getD 0 #[]).set! xi 3)).set! 1 ((a.filter.getD 1 #[]).set! xi 3)
      }
  for i in [:Nat.min bh4 (32 - yb4)] do
    let yi := yb4 + i
    l := { l with
      txIntra := l.txIntra.set! yi (Int.ofNat lh)
      tx := l.tx.set! yi lh
      mode := l.mode.set! yi yModeNofilt
      palSz := l.palSz.set! yi palSzY
      palSzUv := l.palSzUv.set! yi (if hasChroma then palSzUv else 0)
    }
    if palSzY > 0 then
      if let some pyArr := palY then
        let mut lp := l.alPal.getD yi #[]
        let mut lp0 := lp.getD 0 #[]
        let src0 := pyArr.getD 0 #[]
        for k in [:palSzY] do lp0 := lp0.set! k (src0.getD k 0)
        lp := lp.set! 0 lp0
        l := { l with alPal := l.alPal.set! yi lp }
    if hasChroma && palSzUv > 0 then
      if let some puvArr := palUv then
        let mut lp := l.alPal.getD yi #[]
        let mut lp1 := lp.getD 1 #[]
        let mut lp2 := lp.getD 2 #[]
        let src0 := puvArr.getD 0 #[]
        let src1 := puvArr.getD 1 #[]
        for k in [:palSzUv] do
          lp1 := lp1.set! k (src0.getD k 0)
          lp2 := lp2.set! k (src1.getD k 0)
        lp := (lp.set! 1 lp1).set! 2 lp2
        l := { l with alPal := l.alPal.set! yi lp }
    if !keyOrIntra then
      l := { l with
        compType := l.compType.set! yi av1CompInterNone
        ref := (l.ref.set! 0 ((l.ref.getD 0 #[]).set! yi (-1))).set! 1 ((l.ref.getD 1 #[]).set! yi (-1))
        filter := (l.filter.set! 0 ((l.filter.getD 0 #[]).set! yi 3)).set! 1 ((l.filter.getD 1 #[]).set! yi 3)
      }
  if hasChroma then
    let mut auvm := a.uvmode
    for i in [:Nat.min cbw4 (32 - cxb4)] do auvm := auvm.set! (cxb4 + i) uvMode
    a := { a with uvmode := auvm }
    let mut luvm := l.uvmode
    for i in [:Nat.min cbh4 (32 - cyb4)] do luvm := luvm.set! (cyb4 + i) uvMode
    l := { l with uvmode := luvm }
  ctx := av1FillLfLevel ctx bx by4 bw4 bh4 cbw4 cbh4 hasChroma segId 0 0
  if let some rf0 := ctx.rf then
    let sw := if bx < rf0.iw4 then Nat.min bw4 (rf0.iw4 - bx) else 0
    let sh := if by4 < rf0.ih4 then Nat.min bh4 (rf0.ih4 - by4) else 0
    let rf1 := av1SplatMv rf0 bs by4 bx sw sh 0 (-1) (av1InvalidMv, 0) (0, 0) 0
    ctx := { ctx with rf := some rf1 }
  return (ctx, a, l, lfm)

@[inline] def av1NearestNearestMv : Nat := 0
@[inline] def av1NearNearMv : Nat := 1
@[inline] def av1NearestNewMv : Nat := 2
@[inline] def av1NewNearestMv : Nat := 3
@[inline] def av1NearNewMv : Nat := 4
@[inline] def av1NewNearMv : Nat := 5
@[inline] def av1GlobalGlobalMv : Nat := 6
@[inline] def av1NewNewMv : Nat := 7

@[inline] def av1PartitionNone : Nat := 0
@[inline] def av1PartitionH : Nat := 1
@[inline] def av1PartitionV : Nat := 2
@[inline] def av1PartitionSplit : Nat := 3
@[inline] def av1PartitionTTopSplit : Nat := 4
@[inline] def av1PartitionTBottomSplit : Nat := 5
@[inline] def av1PartitionTLeftSplit : Nat := 6
@[inline] def av1PartitionTRightSplit : Nat := 7
@[inline] def av1PartitionH4 : Nat := 8
@[inline] def av1PartitionV4 : Nat := 9

def av1FindMatchingRef (ctx : Av1TileDecodeCtx) (rf : Av1RefMvFrame)
    (edgeFlags bx by4 bw4 bh4 w4 h4 : Nat) (haveLeft haveTop : Bool) (ref : Nat) :
    Nat × Nat := Id.run do
  let mut mask0 : Nat := 0
  let mut mask1 : Nat := 0
  let mut count : Nat := 0
  let mut haveTl : Bool := haveTop && haveLeft
  let mut haveTr : Bool :=
    decide (Nat.max bw4 bh4 < 32) && haveTop && decide (bx + bw4 < ctx.col1) &&
    decide ((edgeFlags &&& av1EdgeI444TopHasRight) != 0)
  let rTarget : Int := Int.ofNat (ref + 1)
  let matchesCell (rb : Av1RefMvCell) : Bool :=
    rb.ref0 == rTarget && rb.ref1 == -1
  if haveTop then
    let r2 := rf.r.getD ((by4 - 1) * rf.rStride + bx) {}
    if matchesCell r2 then
      mask0 := mask0 ||| 1
      count := 1
    let aw4 := (av1Bdim r2.bs).1
    if aw4 >= bw4 then
      let off := bx &&& (aw4 - 1)
      if off != 0 then haveTl := false
      if aw4 - off > bw4 then haveTr := false
    else
      let mut bit : Nat := 1 <<< aw4
      let mut x : Nat := aw4
      while x < w4 do
        let rx := rf.r.getD ((by4 - 1) * rf.rStride + (bx + x)) {}
        if matchesCell rx then
          mask0 := mask0 ||| bit
          count := count + 1
          if count >= 8 then return (mask0, mask1)
        let stepW := Nat.max 1 (av1Bdim rx.bs).1
        bit := bit <<< stepW
        x := x + stepW
  if haveLeft then
    let r2 := rf.r.getD (by4 * rf.rStride + (bx - 1)) {}
    if matchesCell r2 then
      mask1 := mask1 ||| 1
      count := count + 1
      if count >= 8 then return (mask0, mask1)
    let lh4 := (av1Bdim r2.bs).2
    if lh4 >= bh4 then
      if (by4 &&& (lh4 - 1)) != 0 then haveTl := false
    else
      let mut bit : Nat := 1 <<< lh4
      let mut y : Nat := lh4
      while y < h4 do
        let ry := rf.r.getD ((by4 + y) * rf.rStride + (bx - 1)) {}
        if matchesCell ry then
          mask1 := mask1 ||| bit
          count := count + 1
          if count >= 8 then return (mask0, mask1)
        let stepH := Nat.max 1 (av1Bdim ry.bs).2
        bit := bit <<< stepH
        y := y + stepH
  if haveTl && matchesCell (rf.r.getD ((by4 - 1) * rf.rStride + (bx - 1)) {}) then
    mask1 := mask1 ||| (1 <<< 32)
    count := count + 1
    if count >= 8 then return (mask0, mask1)
  if haveTr && matchesCell (rf.r.getD ((by4 - 1) * rf.rStride + (bx + bw4)) {}) then
    mask0 := mask0 ||| (1 <<< 32)
  return (mask0, mask1)

def av1DeriveWarpMv (rf : Av1RefMvFrame) (bx by4 bw4 bh4 : Nat)
    (masks : Nat × Nat) (mv : Int × Int) : Option Av1WmParams := Id.run do
  let mut pts : Array ((Int × Int) × (Int × Int)) := #[]
  let addSample (dx dy sx sy : Int) (rp : Av1RefMvCell)
      (ptsIn : Array ((Int × Int) × (Int × Int))) : Array ((Int × Int) × (Int × Int)) :=
    let (bd0, bd1) := av1Bdim rp.bs
    let px : Int := 16 * (2 * dx + sx * Int.ofNat bd0) - 8
    let py : Int := 16 * (2 * dy + sy * Int.ofNat bd1) - 8
    ptsIn.push ((px, py), (px + rp.mv0.2, py + rp.mv0.1))
  let m0Lo := masks.1 &&& 0xFFFFFFFF
  let m1Lo := masks.2 &&& 0xFFFFFFFF
  if m0Lo == 1 && (masks.2 >>> 32) == 0 then
    let rp := rf.r.getD ((by4 - 1) * rf.rStride + bx) {}
    let off := bx &&& ((av1Bdim rp.bs).1 - 1)
    pts := addSample (-(Int.ofNat off)) 0 1 (-1) rp pts
  else
    let mut off : Nat := 0
    let mut xmask := m0Lo
    while pts.size < 8 && xmask != 0 do
      let tz := av1Ctz xmask
      off := off + tz
      xmask := xmask >>> tz
      let rp := rf.r.getD ((by4 - 1) * rf.rStride + (bx + off)) {}
      pts := addSample (Int.ofNat off) 0 1 (-1) rp pts
      xmask := xmask &&& (0xFFFFFFFF - 1)
  if pts.size < 8 && masks.2 == 1 then
    let rp := rf.r.getD (by4 * rf.rStride + (bx - 1)) {}
    let off := by4 &&& ((av1Bdim rp.bs).2 - 1)
    pts := addSample 0 (-(Int.ofNat off)) (-1) 1 rp pts
  else
    let mut off : Nat := 0
    let mut ymask := m1Lo
    while pts.size < 8 && ymask != 0 do
      let tz := av1Ctz ymask
      off := off + tz
      ymask := ymask >>> tz
      let rp := rf.r.getD ((by4 + off) * rf.rStride + (bx - 1)) {}
      pts := addSample 0 (Int.ofNat off) (-1) 1 rp pts
      ymask := ymask &&& (0xFFFFFFFF - 1)
  if pts.size < 8 && (masks.2 >>> 32) != 0 then
    pts := addSample 0 0 (-1) (-1) (rf.r.getD ((by4 - 1) * rf.rStride + (bx - 1)) {}) pts
  if pts.size < 8 && (masks.1 >>> 32) != 0 then
    pts := addSample (Int.ofNat bw4) 0 1 (-1) (rf.r.getD ((by4 - 1) * rf.rStride + (bx + bw4)) {}) pts
  let np := pts.size
  let mut mvd : Array Int := Array.mkEmpty np
  let mut ret : Nat := 0
  let thresh : Int := 4 * av1Iclip (Int.ofNat (Nat.max bw4 bh4)) 4 28
  for i in [:np] do
    let ((p0x, p0y), (p1x, p1y)) := pts.getD i ((0, 0), (0, 0))
    let d : Int := Int.ofNat (p1x - p0x - mv.2).natAbs + Int.ofNat (p1y - p0y - mv.1).natAbs
    if d > thresh then
      mvd := mvd.push (-1)
    else
      mvd := mvd.push d
      ret := ret + 1
  if ret == 0 then
    ret := 1
  else
    let mut i : Nat := 0
    let mut j : Int := Int.ofNat np - 1
    for _ in [:np - ret] do
      while i < np && mvd.getD i 0 != -1 do
        i := i + 1
      while j >= 0 && mvd.getD j.toNat 0 == -1 do
        j := j - 1
      if Int.ofNat i <= j then
        let jn := j.toNat
        mvd := mvd.set! i (mvd.getD jn 0)
        pts := pts.set! i (pts.getD jn ((0, 0), (0, 0)))
        i := i + 1
        j := j - 1
  let wm0 : Av1WmParams := { wmType := 3, matrix := Array.replicate 6 0, abcd := Array.replicate 4 0 }
  let (failAff, wm1) := av1FindAffineInt pts ret bw4 bh4 mv wm0 bx by4
  if failAff then return none
  let (failShear, wm2) := av1GetShearParams wm1
  if failShear then return none
  return some wm2

def av1ObmcPlane (ctx : Av1TileDecodeCtx) (dst0 : Array Nat) (doff stride bw4 bh4 bwLog2 bhLog2 pl bx by4 w4 h4 : Nat) :
    Array Nat := Id.run do
  let mut dst := dst0
  let some rf := ctx.rf | return dst
  let fh := ctx.fh
  let ssHor : Nat := if pl > 0 then 1 else 0
  let ssVer : Nat := if pl > 0 then 1 else 0
  let hMul := 4 >>> ssHor
  let vMul := 4 >>> ssVer
  if by4 > ctx.row0 && (pl == 0 || bw4 * hMul + bh4 * vMul >= 16) then
    let mut i : Nat := 0
    let mut x : Nat := 0
    while x < w4 && i < Nat.min bwLog2 4 do
      let aR := rf.r.getD ((by4 - 1) * rf.rStride + (bx + x + 1)) {}
      let aBw4 := (av1Bdim aR.bs).1
      let step4 := (av1Iclip (Int.ofNat aBw4) 2 16).toNat
      if aR.ref0 > 0 then
        let ow4 := Nat.min step4 bw4
        let oh4 := Nat.min bh4 16 >>> 1
        let ridx := aR.ref0.toNat - 1
        let refSlotIdx := fh.refidx.getD ridx 0
        if let some slot := ctx.refs.getD refSlotIdx none then
          let src := slot.planes.getD pl #[]
          let ss := if pl == 0 then slot.stride else slot.stride >>> 1
          let aCtx := ctx.above.getD ((bx + x + 1) >>> 5) {}
          let ax4 := (bx + x + 1) &&& 31
          let f0 := (aCtx.filter.getD 0 #[]).getD ax4 3
          let f1 := (aCtx.filter.getD 1 #[]).getD ax4 3
          let f2d := av1Filter2d.getD (f1 * 4 + f0) 0
          let lapW := ow4 * hMul
          let lapH4 := (oh4 * 3 + 3) >>> 2
          let lapH := lapH4 * vMul
          let lap0 := Array.replicate (lapW * Nat.max lapH (oh4 * vMul)) 0
          let lap := av1McBlockPut lap0 0 lapW ow4 lapH4 (bx + x) by4 pl aR.mv0 src slot.w slot.h ss f2d false bw4 bh4
          dst := av1BlendH dst (doff + x * hMul) stride lap (hMul * ow4) (vMul * oh4)
          i := i + 1
      x := x + step4
  if bx > ctx.col0 then
    let l := ctx.left
    let mut i : Nat := 0
    let mut y : Nat := 0
    while y < h4 && i < Nat.min bhLog2 4 do
      let lR := rf.r.getD ((by4 + y + 1) * rf.rStride + (bx - 1)) {}
      let lBh4 := (av1Bdim lR.bs).2
      let step4 := (av1Iclip (Int.ofNat lBh4) 2 16).toNat
      if lR.ref0 > 0 then
        let ow4 := Nat.min bw4 16 >>> 1
        let oh4 := Nat.min step4 bh4
        let ridx := lR.ref0.toNat - 1
        let refSlotIdx := fh.refidx.getD ridx 0
        if let some slot := ctx.refs.getD refSlotIdx none then
          let src := slot.planes.getD pl #[]
          let ss := if pl == 0 then slot.stride else slot.stride >>> 1
          let ly4 := (by4 + y + 1) &&& 31
          let f0 := (l.filter.getD 0 #[]).getD ly4 3
          let f1 := (l.filter.getD 1 #[]).getD ly4 3
          let f2d := av1Filter2d.getD (f1 * 4 + f0) 0
          let lapW := ow4 * hMul
          let lapH := oh4 * vMul
          let lap0 := Array.replicate (lapW * lapH) 0
          let lap := av1McBlockPut lap0 0 lapW ow4 oh4 bx (by4 + y) pl lR.mv0 src slot.w slot.h ss f2d false bw4 bh4
          dst := av1BlendV dst (doff + y * vMul * stride) stride lap (hMul * ow4) (vMul * oh4)
          i := i + 1
      y := y + step4
  return dst

private def av1RefFlat (slot : Av1RefSlot) (pl : Nat) : Array Nat × Nat :=
  (slot.planes.getD pl #[], if pl == 0 then slot.stride else slot.stride >>> 1)

private def av1PredMc (ctx : Av1TileDecodeCtx) (pl : Nat) (r : Int) (mvv : Int × Int)
    (dst0 : Option (Array Nat)) (off stride w4b h4b bx4 by4 f2d bw4 bh4 : Nat) (intrabc : Bool) :
    Array Nat × Array Int :=
  if intrabc then
    let src := if pl == 0 then ctx.flatY else if pl == 1 then ctx.flatU else ctx.flatV
    let ss := if pl == 0 then ctx.yStride else ctx.uvStride
    match dst0 with
    | some d =>
      let d1 := av1McBlockPut d off stride w4b h4b bx4 by4 pl mvv src ctx.w ctx.h ss 9 true bw4 bh4
      (d1, #[])
    | none =>
      let t := av1McBlockPrep w4b h4b bx4 by4 pl mvv src ctx.w ctx.h ss 9 true bw4 bh4
      (#[], t)
  else
    let fh := ctx.fh
    let ridx := fh.refidx.getD r.toNat 0
    match ctx.refs.getD ridx none with
    | none => (dst0.getD #[], #[])
    | some slot =>
      let (src, ss) := av1RefFlat slot pl
      match dst0 with
      | some d =>
        let d1 := av1McBlockPut d off stride w4b h4b bx4 by4 pl mvv src slot.w slot.h ss f2d false bw4 bh4
        (d1, #[])
      | none =>
        let t := av1McBlockPrep w4b h4b bx4 by4 pl mvv src slot.w slot.h ss f2d false bw4 bh4
        (#[], t)

private def av1PredWarp (ctx : Av1TileDecodeCtx) (pl : Nat) (r : Int) (wmp : Av1WmParams)
    (dst0 : Option (Array Nat)) (off stride bw4 bh4 bx by4 : Nat) : Array Nat × Array Int :=
  let fh := ctx.fh
  let ridx := fh.refidx.getD r.toNat 0
  match ctx.refs.getD ridx none with
  | none => (dst0.getD #[], #[])
  | some slot =>
    let (src, ss) := av1RefFlat slot pl
    match dst0 with
    | some d =>
      let d1 := av1WarpBlockPut d off stride bw4 bh4 bx by4 pl src slot.w slot.h ss wmp
      (d1, #[])
    | none =>
      let t := av1WarpBlockPrep bw4 bh4 bx by4 pl src slot.w slot.h ss wmp
      (#[], t)

private def av1ReadInterCoefTree (fuel : Nat) (ctx0 : Av1TileDecodeCtx) (cf0 : Array Int)
    (bs segId ymode qidx : Nat) (lossless : Bool) (dqYDc dqYAc : Nat)
    (qmY : Option (Array (Array Nat))) (txSplit : Array Nat)
    (tx curBx curBy depth xOff yOff : Nat) : Av1TileDecodeCtx × Array Int :=
  match fuel with
  | 0 => (ctx0, cf0)
  | fuel' + 1 => Id.run do
    let (tw, th, lw, lh, _) := av1TxDim tx
    let isSplit : Bool :=
      depth < 2 && tx > 0 && ((txSplit.getD depth 0 &&& (1 <<< (yOff * 4 + xOff))) != 0)
    if isSplit then
      let sub := av1TxfmDim.getD (tx * 8 + 6) 0
      let txsw := av1TxfmDim.getD (sub * 8) 1
      let txsh := av1TxfmDim.getD (sub * 8 + 1) 1
      let (c1, cf1) := av1ReadInterCoefTree fuel' ctx0 cf0 bs segId ymode qidx lossless dqYDc dqYAc qmY txSplit sub curBx curBy (depth + 1) (xOff * 2) (yOff * 2)
      let mut ctx := c1
      let mut cf := cf1
      if lw >= lh && curBx + txsw < ctx.bw then
        let (c2, cf2) := av1ReadInterCoefTree fuel' ctx cf bs segId ymode qidx lossless dqYDc dqYAc qmY txSplit sub (curBx + txsw) curBy (depth + 1) (xOff * 2 + 1) (yOff * 2)
        ctx := c2; cf := cf2
      if lh >= lw && curBy + txsh < ctx.bh then
        let (c3, cf3) := av1ReadInterCoefTree fuel' ctx cf bs segId ymode qidx lossless dqYDc dqYAc qmY txSplit sub curBx (curBy + txsh) (depth + 1) (xOff * 2) (yOff * 2 + 1)
        ctx := c3; cf := cf3
        if lw >= lh && curBx + txsw < ctx.bw then
          let (c4, cf4) := av1ReadInterCoefTree fuel' ctx cf bs segId ymode qidx lossless dqYDc dqYAc qmY txSplit sub (curBx + txsw) (curBy + txsh) (depth + 1) (xOff * 2 + 1) (yOff * 2 + 1)
          ctx := c4; cf := cf4
      return (ctx, cf)
    else
      let bx4C := curBx &&& 31
      let by4C := curBy &&& 31
      let sb128x := curBx >>> 5
      let mut aC := ctx0.above.getD sb128x {}
      let mut l := ctx0.left
      let ys := ctx0.yStride
      let doff := curBy * 4 * ys + curBx * 4
      let (eob, txtp, rctx, d1, c1, cf1) := av1DecodeCoefs
        ctx0.dec ctx0.cdf tx bs false 0 ymode 0 av1DcPred
        ctx0.fh.reducedTxtpSet qidx lossless aC.lcoef bx4C l.lcoef by4C
        cf0 0 dqYDc dqYAc qmY
      let wFill := if curBx < ctx0.bw then Nat.min tw (ctx0.bw - curBx) else 0
      let hFill := if curBy < ctx0.bh then Nat.min th (ctx0.bh - curBy) else 0
      let mut alc := aC.lcoef
      for k in [:Nat.min wFill (32 - bx4C)] do alc := alc.set! (bx4C + k) rctx
      aC := { aC with lcoef := alc }
      let mut llc := l.lcoef
      for k in [:Nat.min hFill (32 - by4C)] do llc := llc.set! (by4C + k) rctx
      l := { l with lcoef := llc }
      let mut tmap := ctx0.txtpMap
      for yy in [:th] do
        let base := ((by4C + yy) &&& 31) * 32
        for xx in [:tw] do
          tmap := tmap.set! (base + ((bx4C + xx) &&& 31)) txtp
      let mut flatY := ctx0.flatY
      let mut cf := cf1
      if eob >= 0 then
        let (fy1, cf2) := av1InvTxfmAdd flatY ys cf eob tx (av1TxShift lw lh) txtp doff
        flatY := fy1; cf := cf2
      let ctxOut := { ctx0 with
        dec := d1, cdf := c1, flatY := flatY,
        above := ctx0.above.set! sb128x aC, left := l, txtpMap := tmap
      }
      return (ctxOut, cf)

def av1DecodeInterCoefs (ctx0 : Av1TileDecodeCtx) (bs bx by4 bw4 bh4 w4 h4 cw4 ch4 : Nat)
    (hasChroma : Bool) (xb4 yb4 cxb4 cyb4 segId qidx : Nat) (lossless : Bool)
    (bdq : Array (Nat × Nat)) (ymode maxYtx uvTx : Nat) (txSplit : Array Nat) :
    Av1TileDecodeCtx := Id.run do
  let mut ctx := ctx0
  let fh := ctx.fh
  let uvs := ctx.uvStride
  let mut cf : Array Int := Array.replicate 1024 0
  let (ytw, yth, _, _, _) := av1TxDim maxYtx
  let (utw, uth, ulw, ulh, _) := av1TxDim uvTx
  let qmY : Option (Array (Array Nat)) := ctx.qm.map (fun q => q.getD 0 #[])
  let qmU : Option (Array (Array Nat)) := ctx.qm.map (fun q => q.getD 1 #[])
  let qmV : Option (Array (Array Nat)) := ctx.qm.map (fun q => q.getD 2 #[])
  let (dqYDc, dqYAc) := bdq.getD 0 (4, 4)
  let cbx := if bw4 == 1 then bx &&& (0xFFFFFFFF - 1) else bx
  let cby := if bh4 == 1 then by4 &&& (0xFFFFFFFF - 1) else by4
  let sb128x0 := bx >>> 5
  let mut initY : Nat := 0
  while initY < bh4 do
    let limY := Nat.min h4 (initY + 16)
    let limCh := Nat.min ch4 ((initY + 16) >>> 1)
    let mut initX : Nat := 0
    while initX < bw4 do
      let limX := Nat.min w4 (initX + 16)
      let limCw := Nat.min cw4 ((initX + 16) >>> 1)
      let mut yOff : Nat := if initY != 0 then 1 else 0
      let mut y : Nat := initY
      while y < limY do
        let mut xOff : Nat := if initX != 0 then 1 else 0
        let mut x : Nat := initX
        while x < limX do
          let (c1, cf1) := av1ReadInterCoefTree 8 ctx cf bs segId ymode qidx lossless dqYDc dqYAc qmY txSplit maxYtx (bx + x) (by4 + y) 0 xOff yOff
          ctx := c1; cf := cf1
          xOff := xOff + 1
          x := x + ytw
        yOff := yOff + 1
        y := y + yth
      if hasChroma then
        for pl in [:2] do
          let (dqCDc, dqCAc) := bdq.getD (1 + pl) (4, 4)
          let qmC := if pl == 0 then qmU else qmV
          let mut yy : Nat := initY >>> 1
          while yy < limCh do
            let mut xx : Nat := initX >>> 1
            while xx < limCw do
              let tBx := bx + (xx <<< 1)
              let tBy := by4 + (yy <<< 1)
              let px := ((cbx >>> 1) + xx) * 4
              let py := ((cby >>> 1) + yy) * 4
              let doff := py * uvs + px
              let mut a0 := ctx.above.getD sb128x0 {}
              let mut l0 := ctx.left
              let ytxtp := ctx.txtpMap.getD ((((yb4 + (yy <<< 1)) &&& 31) * 32) + ((xb4 + (xx <<< 1)) &&& 31)) 0
              let caArr := a0.ccoef.getD pl #[]
              let clArr := l0.ccoef.getD pl #[]
              let (eob, txtp, rctx, d1, c1, cf1) := av1DecodeCoefs
                ctx.dec ctx.cdf uvTx bs false (1 + pl) ymode 0 av1DcPred
                fh.reducedTxtpSet qidx lossless caArr (cxb4 + xx) clArr (cyb4 + yy)
                cf ytxtp dqCDc dqCAc qmC
              cf := cf1
              let ctw := if tBx < ctx.bw then Nat.min utw ((ctx.bw - tBx + 1) >>> 1) else 0
              let cth := if tBy < ctx.bh then Nat.min uth ((ctx.bh - tBy + 1) >>> 1) else 0
              let mut nca := caArr
              for k in [:Nat.min ctw (32 - (cxb4 + xx))] do nca := nca.set! (cxb4 + xx + k) rctx
              a0 := { a0 with ccoef := a0.ccoef.set! pl nca }
              let mut ncl := clArr
              for k in [:Nat.min cth (32 - (cyb4 + yy))] do ncl := ncl.set! (cyb4 + yy + k) rctx
              l0 := { l0 with ccoef := l0.ccoef.set! pl ncl }
              let mut flatU := ctx.flatU
              let mut flatV := ctx.flatV
              if eob >= 0 then
                let pbuf := if pl == 0 then flatU else flatV
                let (pbuf1, cf2) := av1InvTxfmAdd pbuf uvs cf eob uvTx (av1TxShift ulw ulh) txtp doff
                cf := cf2
                if pl == 0 then flatU := pbuf1 else flatV := pbuf1
              ctx := { ctx with
                dec := d1, cdf := c1, flatU := flatU, flatV := flatV,
                above := ctx.above.set! sb128x0 a0, left := l0
              }
              xx := xx + utw
            yy := yy + uth
      initX := initX + 16
    initY := initY + 16
  return ctx

def av1ReconInter (ctx0 : Av1TileDecodeCtx) (bs bx by4 bw4 bh4 bwLog2 bhLog2 w4 h4 cbw4 cbh4 cw4 ch4 : Nat)
    (haveTop haveLeft hasChroma : Bool) (a l : Av1BlockContext) (xb4 yb4 cxb4 cyb4 segId : Nat)
    (skip intrabc : Bool) (qidx : Nat) (lossless : Bool) (bdq : Array (Nat × Nat))
    (comp compType : Nat) (ref0 ref1 : Int) (mv0 mv1 : Int × Int)
    (ymode filter2d wedgeIdx maskSign interintraType interintraMode motionMode maxYtx uvTx : Nat)
    (txSplit : Array Nat) : Av1TileDecodeCtx := Id.run do
  let mut ctx := ctx0
  let fh := ctx.fh
  let mut flatY := ctx.flatY
  let mut flatU := ctx.flatU
  let mut flatV := ctx.flatV
  let ys := ctx.yStride
  let uvs := ctx.uvStride
  let doff := by4 * 4 * ys + bx * 4
  let bw := bw4 * 4
  let bh := bh4 * 4
  let gmvOk := ctx.gmvWarpAllowed
  let warpWm := ctx.warpWm
  if comp == 0 then
    let useWarpY : Bool :=
      !intrabc && Nat.min bw4 bh4 > 1 &&
      (((ymode == av1GlobalMv && gmvOk.getD ref0.toNat false) ||
        (motionMode == 2 && warpWm.isSome && (warpWm.getD {}).wmType > 1)) : Bool)
    if useWarpY then
      let wmpY := if motionMode == 2 then warpWm.getD {} else fh.gmv.getD ref0.toNat {}
      let (fy1, _) := av1PredWarp ctx 0 ref0 wmpY (some flatY) doff ys bw4 bh4 bx by4
      flatY := fy1
    else
      let (fy1, _) := av1PredMc ctx 0 ref0 mv0 (some flatY) doff ys bw4 bh4 bx by4 filter2d bw4 bh4 intrabc
      flatY := fy1
      if motionMode == 1 then
        flatY := av1ObmcPlane ctx flatY doff ys bw4 bh4 bwLog2 bhLog2 0 bx by4 w4 h4
    if interintraType != 0 then
      let mode := av1InterintraToIntra.getD interintraMode av1DcPred
      let topSb := if ctx.sby > 0 && by4 == ctx.sbyBy then some ctx.ipredEdgeY else none
      let (m, ang, ebuf, tl) := av1PrepareIntraEdges
        bx haveLeft by4 haveTop ctx.col1 ctx.row1 0
        flatY doff ys topSb 0 mode 0 bw4 bh4 0
      let tmp0 := Array.replicate (bw * bh) 0
      let tmp := av1IntraPred tmp0 0 bw ebuf tl m bw bh (ang.toNat) ((ctx.col1 - bx) * 4) ((ctx.row1 - by4) * 4)
      let mask := av1IiMask 0 bs interintraType interintraMode wedgeIdx
      flatY := av1BlendPxBuf flatY doff ys tmp bw bh mask 0 bw
    if hasChroma then
      let cdoff := (by4 >>> 1) * 4 * uvs + (bx >>> 1) * 4
      let cbw := cbw4 * 4
      let cbh := cbh4 * 4
      let mut isSub8 : Bool := (bw4 == 1 || bh4 == 1) && !intrabc
      if isSub8 then
        if let some rf := ctx.rf then
          if bw4 == 1 then
            isSub8 := isSub8 && (rf.r.getD (by4 * rf.rStride + (bx - 1)) {}).ref0 > 0
          if bh4 == 1 then
            isSub8 := isSub8 && (rf.r.getD ((by4 - 1) * rf.rStride + bx) {}).ref0 > 0
          if bw4 == 1 && bh4 == 1 then
            isSub8 := isSub8 && (rf.r.getD ((by4 - 1) * rf.rStride + (bx - 1)) {}).ref0 > 0
        else
          isSub8 := false
      if isSub8 then
        let rf := ctx.rf.getD {}
        let mut hOff : Nat := 0
        let mut vOff : Nat := 0
        if bw4 == 1 && bh4 == 1 then
          let rbTl := rf.r.getD ((by4 - 1) * rf.rStride + (bx - 1)) {}
          let (fu1, _) := av1PredMc ctx 1 (rbTl.ref0 - 1) rbTl.mv0 (some flatU) cdoff uvs bw4 bh4 (bx - 1) (by4 - 1) ctx.tl4x4Filter bw4 bh4 false
          flatU := fu1
          let (fv1, _) := av1PredMc ctx 2 (rbTl.ref0 - 1) rbTl.mv0 (some flatV) cdoff uvs bw4 bh4 (bx - 1) (by4 - 1) ctx.tl4x4Filter bw4 bh4 false
          flatV := fv1
          vOff := 2 * uvs
          hOff := 2
        if bw4 == 1 then
          let rbL := rf.r.getD (by4 * rf.rStride + (bx - 1)) {}
          let lf0 := (l.filter.getD 0 #[]).getD yb4 3
          let lf1 := (l.filter.getD 1 #[]).getD yb4 3
          let lf2d := av1Filter2d.getD (lf1 * 4 + lf0) 0
          let (fu2, _) := av1PredMc ctx 1 (rbL.ref0 - 1) rbL.mv0 (some flatU) (cdoff + vOff) uvs bw4 bh4 (bx - 1) by4 lf2d bw4 bh4 false
          flatU := fu2
          let (fv2, _) := av1PredMc ctx 2 (rbL.ref0 - 1) rbL.mv0 (some flatV) (cdoff + vOff) uvs bw4 bh4 (bx - 1) by4 lf2d bw4 bh4 false
          flatV := fv2
          hOff := 2
        if bh4 == 1 then
          let rbT := rf.r.getD ((by4 - 1) * rf.rStride + bx) {}
          let tf0 := (a.filter.getD 0 #[]).getD xb4 3
          let tf1 := (a.filter.getD 1 #[]).getD xb4 3
          let tf2d := av1Filter2d.getD (tf1 * 4 + tf0) 0
          let (fu3, _) := av1PredMc ctx 1 (rbT.ref0 - 1) rbT.mv0 (some flatU) (cdoff + hOff) uvs bw4 bh4 bx (by4 - 1) tf2d bw4 bh4 false
          flatU := fu3
          let (fv3, _) := av1PredMc ctx 2 (rbT.ref0 - 1) rbT.mv0 (some flatV) (cdoff + hOff) uvs bw4 bh4 bx (by4 - 1) tf2d bw4 bh4 false
          flatV := fv3
          vOff := 2 * uvs
        let (fu4, _) := av1PredMc ctx 1 ref0 mv0 (some flatU) (cdoff + hOff + vOff) uvs bw4 bh4 bx by4 filter2d bw4 bh4 false
        flatU := fu4
        let (fv4, _) := av1PredMc ctx 2 ref0 mv0 (some flatV) (cdoff + hOff + vOff) uvs bw4 bh4 bx by4 filter2d bw4 bh4 false
        flatV := fv4
      else
        let useWarpUv : Bool :=
          !intrabc && Nat.min cbw4 cbh4 > 1 &&
          (((ymode == av1GlobalMv && gmvOk.getD ref0.toNat false) ||
            (motionMode == 2 && warpWm.isSome && (warpWm.getD {}).wmType > 1)) : Bool)
        if useWarpUv then
          let wmpUv := if motionMode == 2 then warpWm.getD {} else fh.gmv.getD ref0.toNat {}
          let (fu5, _) := av1PredWarp ctx 1 ref0 wmpUv (some flatU) cdoff uvs bw4 bh4 bx by4
          flatU := fu5
          let (fv5, _) := av1PredWarp ctx 2 ref0 wmpUv (some flatV) cdoff uvs bw4 bh4 bx by4
          flatV := fv5
        else
          let mcW4 := bw4 <<< (if bw4 == 1 then 1 else 0)
          let mcH4 := bh4 <<< (if bh4 == 1 then 1 else 0)
          let mcBx := bx &&& (0xFFFFFFFF - 1)
          let mcBy := by4 &&& (0xFFFFFFFF - 1)
          let (fu6, _) := av1PredMc ctx 1 ref0 mv0 (some flatU) cdoff uvs mcW4 mcH4 mcBx mcBy filter2d bw4 bh4 intrabc
          flatU := fu6
          let (fv6, _) := av1PredMc ctx 2 ref0 mv0 (some flatV) cdoff uvs mcW4 mcH4 mcBx mcBy filter2d bw4 bh4 intrabc
          flatV := fv6
          if motionMode == 1 then
            flatU := av1ObmcPlane ctx flatU cdoff uvs bw4 bh4 bwLog2 bhLog2 1 bx by4 w4 h4
            flatV := av1ObmcPlane ctx flatV cdoff uvs bw4 bh4 bwLog2 bhLog2 2 bx by4 w4 h4
        if interintraType != 0 then
          let iiMask := av1IiMask 1 bs interintraType interintraMode wedgeIdx
          let mode := av1InterintraToIntra.getD interintraMode av1DcPred
